      },
      {
        "msgID": "goh_accident_GOH_ACCIDENT_FEVER_RESULT_021",
        "msgStr": "Victor"
      },
      {
        "msgID": "GOH_ACCIDENT_L0048",
        "msgStr": "Şey, ımm... Ne düşünüyorsun? Benim... iblis füzyonu teknolojim, şey...\n<mw 180>"
      },
      {
        "msgID": "GOH_ACCIDENT_L0049",
        "msgStr": "Ba... Başarısız oldu...\n<mw 180>"
      },
      {
        "msgID": "goh_accident_GOH_ACCIDENT_RESULT_DEVIL_022",
        "msgStr": "NULL"
      },
      {
        "msgID": "GOH_ACCIDENT_L0050",
        "msgStr": "> Öngörülen sonuçtan farklı bir iblis doğdu."
      },
      {
        "msgID": "GOH_ACCIDENT_L0050_01",
        "msgStr": "> Yeniden doğuşla birlikte nitelikler arttı!"
      },
      {
        "msgID": "goh_accident_GOH_ACCIDENT_RESULT_PARAM_STR_023",
        "msgStr": "NULL"
      },
      {
        "msgID": "GOH_ACCIDENT_L0051",
        "msgStr": "> <COLOR 4><V 0><COLOR 0>, <COLOR 1>+2<COLOR 0> Güç ile doğdu."
      },
      {
        "msgID": "goh_accident_GOH_ACCIDENT_RESULT_PARAM_VIT_024",
        "msgStr": "NULL"
      },
      {
        "msgID": "GOH_ACCIDENT_L0052",
        "msgStr": "> <COLOR 4><V 0><COLOR 0>, <COLOR 1>+2<COLOR 0> Dayanıklılık ile doğdu."
