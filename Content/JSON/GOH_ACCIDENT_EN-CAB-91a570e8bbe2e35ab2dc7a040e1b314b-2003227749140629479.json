      {
        "msgID": "goh_accident_GOH_ACCIDENT_RESULT_PARAM_TEC_025",
        "msgStr": "NULL"
      },
      {
        "msgID": "GOH_ACCIDENT_L0053",
        "msgStr": "> <COLOR 4><V 0><COLOR 0>, <COLOR 1>+2<COLOR 0> Büyü ile doğdu."
      },
      {
        "msgID": "goh_accident_GOH_ACCIDENT_RESULT_PARAM_LUCK_026",
        "msgStr": "NULL"
      },
      {
        "msgID": "GOH_ACCIDENT_L0054",
        "msgStr": "> <COLOR 4><V 0><COLOR 0>, <COLOR 1>+2<COLOR 0> Şans ile doğdu."
      },
      {
        "msgID": "goh_accident_GOH_ACCIDENT_RESULT_OMOIDE_027",
        "msgStr": "NULL"
      },
      {
        "msgID": "GOH_ACCIDENT_L0055",
        "msgStr": "> <COLOR 4><V 0><COLOR 0>, <COLOR 4><V 1><COLOR 0> Pasif Yeteneği ile doğdu."
      },
      {
        "msgID": "goh_accident_GOH_ACCIDENT_RESULT_OMOIDE_WAKU_028",
        "msgStr": "NULL"
      },
      {
        "msgID": "GOH_ACCIDENT_L0056",
        "msgStr": "> <COLOR 4><V 0><COLOR 0>, <COLOR 1>1<COLOR 0> fazladan Pasif Yetenek yuvası ile doğdu."
      },
      {
        "msgID": "GOH_ACCIDENT_L0057",
        "msgStr": "Yani o kılıcı ve bu malzemeleri mi kullanacağız?"
      },
      {
        "msgID": "GOH_ACCIDENT_L0058",
        "msgStr": "Evet."
      },
      {
        "msgID": "GOH_ACCIDENT_L0059",
        "msgStr": "Hayır."
      },
      {
        "msgID": "GOH_ACCIDENT_L0060",
        "msgStr": "O kılıca sahip değilsin."
      },
      {
        "msgID": "GOH_ACCIDENT_L0061",
        "msgStr": "Gerekli malzemelere sahip değilsin."
      },
      {
        "msgID": "GOH_ACCIDENT_L0062",
        "msgStr": "Görünüşe göre paran yetmiyor."
      },
      {
        "msgID": "GOH_ACCIDENT_L0063",
        "msgStr": "O kılıçtan zaten yeterince yok mu?"
      },
      {
        "msgID": "GOH_ACCIDENT_L0064",
        "msgStr": "O kılıçtan iki tane olması yeterli."
      },
      {
        "msgID": "goh_accident_GOH_GIFT_MES_029",
        "msgStr": "Victor"
      },
      {
        "msgID": "GOH_ACCIDENT_L0065",
        "msgStr": "Ha, evet... İblisin füzyondan önce sana bir mektup bıraktı."
