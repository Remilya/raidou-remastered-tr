      {
        "msgID": "goh_accident_GOH_ACCIDENT_PRESENT_NOITEM_SYSTEM_020",
        "msgStr": "NULL"
      },
      {
        "msgID": "GOH_ACCIDENT_L0045",
        "msgStr": "> Raidou'da tek bir <COLOR 4><V 0><COLOR 0> bile yoktu..."
      },
      {
        "msgID": "GOH_ACCIDENT_L0046",
