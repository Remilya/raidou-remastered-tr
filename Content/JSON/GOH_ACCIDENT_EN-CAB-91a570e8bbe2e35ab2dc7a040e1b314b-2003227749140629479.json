      {
        "msgID": "goh_accident_GOH_GIFT_GET_031",
        "msgStr": "NULL"
      },
      {
        "msgID": "GOH_ACCIDENT_L0067",
        "msgStr": "> Raidou mektupla birlikte <COLOR 4><V 0><COLOR 0> x<V 1> aldı."
