      {
        "msgID": "goh_accident_GOH_GIFT_MES_ITEM_030",
        "msgStr": "Victor"
      },
      {
        "msgID": "GOH_ACCIDENT_L0066",
        "msgStr": "Ha, evet... İblisin füzyondan önce sana bir mektup ve bir hediye bıraktı."
