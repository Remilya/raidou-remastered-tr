      },
      {
        "msgID": "MAP12_E_L0004",
        "msgStr": "Raidou, beni duyabiliyor musun?"
      },
      {
        "msgID": "MAP12_E_L0005",
        "msgStr": "Diğer \"Raido\"nun bize anlattıklarını hatırladığına eminim..."
      },
      {
        "msgID": "MAP12_E_L0006",
        "msgStr": "Bir kızın bilincini ele geçirmeye çalışan gelecekten bir Raidou."
      },
      {
        "msgID": "MAP12_E_L0007",
        "msgStr": "Kaya'yı ele geçiren \"iblis\" o olmalı."
      },
      {
        "msgID": "MAP12_E_L0008",
        "msgStr": "O senin haleflerinden biri; gelecekten gelen bir Raidou."
      },
      {
        "msgID": "MAP12_E_L0009",
        "msgStr": "Kulağa ne kadar ironik gelse de görünüşe göre bu, Kuzunoha'lar arasında bir savaş olacak."
      },
      {
        "msgID": "MAP12_E_L0010",
        "msgStr": "ER100"
      },
      {
        "msgID": "MAP12_E_L0011",
        "msgStr": "Fakat senin üstesinden geleceğinden eminim."
      },
      {
        "msgID": "MAP12_E_L0012",
        "msgStr": "Potansiyelini bizzat gördüm."
      },
      {
        "msgID": "MAP12_E_L0013",
        "msgStr": "Eğer halefin yolunu kaybettiyse onu tekrar doğru yola sok."
      },
      {
        "msgID": "MAP12_E_L0014",
        "msgStr": "İkinci Raidou'dan beri her Raidou'ya rehberlik etmiş biri olarak... sana inandığımı bil."
      }
    ]
