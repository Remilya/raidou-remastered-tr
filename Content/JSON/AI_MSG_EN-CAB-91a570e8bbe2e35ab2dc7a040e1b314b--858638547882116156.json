      },
      {
        "msgID": "ai_msg_BTLAI_MES_TUTORIAL_06_01",
        "msgStr": "Okiku-Mushi"
      },
      {
        "msgID": "AI_MSG_L0148",
        "msgStr": "Urrrgh... Seni velet! 99 insanın etini mideye indirdim ben!"
      },
      {
        "msgID": "AI_MSG_L0149",
        "msgStr": "Eh, öyleyse oyun vakti bitti sanırım!"
      },
      {
        "msgID": "ai_msg_BTLAI_MES_TUTORIAL_06_02",
        "msgStr": "Köy Muhtarı"
      },
      {
        "msgID": "AI_MSG_L0150",
        "msgStr": "Okiku-Mushi bariyeri kırdı! Kontrolden çıktı!"
      },
      {
        "msgID": "AI_MSG_L0151",
        "msgStr": "Çık oradan, <NAME 0>! Öleceksin! Bu artık basit bir sınav olmaktan çıktı!"
      },
      {
        "msgID": "AI_MSG_L0152",
        "msgStr": "ER100"
      },
      {
        "msgID": "ai_msg_BTLAI_MES_TUTORIAL_06_03",
        "msgStr": "Kraliçe Okiku-Mushi"
      },
      {
        "msgID": "AI_MSG_L0153",
        "msgStr": "Kes sesini! Kimse kaçamaz! Tüm Kuzunoha klanı ölecek!"
      },
      {
        "msgID": "AI_MSG_L0154",
        "msgStr": "Hatta neden bu köyün tamamını mideye indirmiyorum ki!?"
      },
      {
        "msgID": "AI_MSG_L0155",
        "msgStr": "Ve sonunda özgür olacağım... Ahh, bunu düşündükçe bile Ruh Gücüm şahlanıyor!"
      },
      {
        "msgID": "ai_msg_BTLAI_MES_TUTORIAL_06_04",
        "msgStr": "NULL"
      },
      {
        "msgID": "AI_MSG_L0156",
        "msgStr": "ER100"
      },
      {
        "msgID": "ai_msg_BTLAI_MES_TUTORIAL_06_05",
        "msgStr": "Ses"
      },
      {
        "msgID": "AI_MSG_L0157",
        "msgStr": "Şu anda Ruh Gücü şahlanan tek iblis sen değilsin!"
      },
      {
        "msgID": "ai_msg_BTLAI_MES_TUTORIAL_06_06",
        "msgStr": "Alp"
      },
      {
        "msgID": "AI_MSG_L0158",
        "msgStr": "Yine karşılaştık, insan!"
      },
      {
        "msgID": "AI_MSG_L0159",
        "msgStr": "MAG'ında tuhaf bir şey sezdim... Bahse girerim aynı anda iki iblis çağırabilirsin!"
      },
      {
        "msgID": "AI_MSG_L0160",
        "msgStr": "Ben de sana katılacağım. Hatta hayır cevabını kabul etmiyorum!"
      },
      {
        "msgID": "ai_msg_BTLAI_MES_TUTORIAL_06_07",
        "msgStr": "NULL"
      },
      {
        "msgID": "AI_MSG_L0161",
        "msgStr": "> <NAME 0> artık savaşta iki iblise birden emir verebilir!"
      },
      {
        "msgID": "ai_msg_BTLAI_MES_TUTORIAL_06_08",
        "msgStr": "Köy Muhtarı"
      },
      {
        "msgID": "AI_MSG_L0162",
        "msgStr": "Köy, aynı anda iki iblise birden hükmeden bir Çağırıcıya tanık olmayalı asırlar olmuştu..."
      },
      {
        "msgID": "AI_MSG_L0163",
        "msgStr": "Gerçekten de son derece korkutucu bir adaysın."
      },
      {
        "msgID": "AI_MSG_L0164",
        "msgStr": "Öyleyse bu işi sana bırakıyoruz, <NAME 0>."
      },
      {
        "msgID": "AI_MSG_L0165",
        "msgStr": "Köyün tam desteği arkanda."
      },
      {
        "msgID": "ai_msg_BTLAI_MES_TUTORIAL_06_14",
        "msgStr": "NULL"
      },
      {
        "msgID": "AI_MSG_L0165_01",
        "msgStr": "> Sınav için özel bir tedbir olarak köy, iblislerini diriltti."
      },
      {
        "msgID": "ai_msg_BTLAI_MES_TUTORIAL_06_09",
        "msgStr": "Köy Muhtarı"
      },
      {
        "msgID": "AI_MSG_L0166",
        "msgStr": "Ukobach'ı köyde dirilteceğiz. Bize çağırma yeteneklerini göster!"
      },
      {
        "msgID": "ai_msg_BTLAI_MES_TUTORIAL_06_10",
        "msgStr": "Ukobach"
      },
      {
        "msgID": "AI_MSG_L0167",
        "msgStr": "Hey, beni unutma Alp! Bütün eğlenceyi sana bırakacak değilim!"
      },
      {
        "msgID": "AI_MSG_L0168",
        "msgStr": "ER100"
      },
      {
        "msgID": "ai_msg_BTLAI_MES_TUTORIAL_06_11",
        "msgStr": "NULL"
      },
      {
        "msgID": "AI_MSG_L0169",
        "msgStr": "ER100"
      },
      {
        "msgID": "ai_msg_BTLAI_MES_TUTORIAL_06_12",
        "msgStr": "Kraliçe Okiku-Mushi"
      },
      {
        "msgID": "AI_MSG_L0170",
        "msgStr": "İki mi? A-Aynı anda mı!?"
      },
      {
        "msgID": "AI_MSG_L0171",
        "msgStr": "Bu... ilginç... Ama yenilmeyeceğim! Sizi haşere gibi ezeceğim!"
      },
      {
        "msgID": "ai_msg_BTLAI_MES_TUTORIAL_06_13",
