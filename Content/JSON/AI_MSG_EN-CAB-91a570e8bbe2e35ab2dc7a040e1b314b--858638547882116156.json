      },
      {
        "msgID": "AI_MSG_L0173",
        "msgStr": "Pekâlâ, Raidou."
      },
      {
        "msgID": "ai_msg_BTLAI_MES_TUTORIAL_07_02",
        "msgStr": "ER100"
      },
      {
        "msgID": "AI_MSG_L0174",
