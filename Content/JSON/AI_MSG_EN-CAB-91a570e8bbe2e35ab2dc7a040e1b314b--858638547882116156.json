        "msgStr": "hA...? şİmDİ dE bİr cAnAvArIn bEdEnİnDe mİyİm? bU kEsKİn dİşLeR sEnİ pArÇalAyAcAk!"
      },
      {
        "msgID": "ai_msg_BTLAI_MES_HITOK_004_053",
        "msgStr": "Hitokotonushi"
      },
      {
        "msgID": "AI_MSG_L0084",
        "msgStr": "urrRRgH... şİmDİ çOk kÜçÜlDüM... bİrAz fAzLa kAçIrDıM..."
      },
      {
        "msgID": "ai_msg_BTLAI_MES_HITOK_005_054",
        "msgStr": "Hitokotonushi"
      },
      {
        "msgID": "AI_MSG_L0085",
        "msgStr": "bU, 1.200 yIl öNcE o çAğIrIcIyA yEnİlDİğİmDeN bİlE dAhA kÖtÜüÜüÜ!\n<mw 180>"
      },
      {
        "msgID": "ai_msg_BTLAI_MES_033_001_055",
        "msgStr": "Gouto"
      },
      {
        "msgID": "AI_MSG_L0086",
        "msgStr": "Çekirdek bir tür ışıkla çevrili."
      },
      {
        "msgID": "AI_MSG_L0087",
        "msgStr": "Saldırılarımız işlemiyor mu? O halde saldırımızı başka bir yere yönlendirmeliyiz..."
      },
      {
        "msgID": "ai_msg_BTLAI_MES_033_002_056",
        "msgStr": "Gouto"
      },
      {
        "msgID": "AI_MSG_L0088",
        "msgStr": "Harika iş! Kalkanlar indi!"
      },
      {
        "msgID": "AI_MSG_L0089",
        "msgStr": "İşte çekirdeği yok etmek için fırsatımız!"
      },
      {
        "msgID": "ai_msg_BTLAI_MES_033_003_057",
        "msgStr": "Gouto"
      },
      {
        "msgID": "AI_MSG_L0090",
        "msgStr": "Başardın! Bu, Ruhsuz Tanrı'yı durduracaktır!\n<mw 180>"
      },
      {
        "msgID": "ai_msg_BTLAI_MES_027_001_058",
        "msgStr": "Kırmızı Pelerin"
      },
      {
        "msgID": "AI_MSG_L0091",
        "msgStr": "İ-İş... İşeeee ihtiyacım var!"
      },
      {
        "msgID": "ai_msg_BTLAI_MES_027_002_059",
        "msgStr": "Kırmızı Pelerin"
      },
      {
        "msgID": "AI_MSG_L0092",
        "msgStr": "P-Para! Param olduğu sürece her şey yoluna girecek!"
      },
      {
        "msgID": "ai_msg_BTLAI_MES_02D_001_060",
        "msgStr": "Nebiros"
      },
      {
        "msgID": "AI_MSG_L0093",
        "msgStr": "Ben bizzat ölümün kendisine hükmederim. Kılıcın bana zarar veremez!"
      },
      {
        "msgID": "ai_msg_BTLAI_MES_02D_002_061",
        "msgStr": "Nebiros"
      },
      {
        "msgID": "AI_MSG_L0094",
        "msgStr": "Sıradan bir insan... Süper Asker Projesi'ni... durduramaz..."
      },
      {
        "msgID": "ai_msg_BTLAI_MES_024_001_062",
        "msgStr": "Omitsunu"
      },
      {
        "msgID": "AI_MSG_L0095",
        "msgStr": "Bu sorduğun \"Süper Asker ordusu\" da neyin nesi?"
      },
      {
        "msgID": "AI_MSG_L0095_01",
        "msgStr": "Böylesine tehlikeli bir grubun varlığı kulağıma hiç çalınmadı."
      },
      {
        "msgID": "AI_MSG_L0095_02",
        "msgStr": "Raido Kuzunoha'nın icraatları sayesinde Başkent huzur içinde. Tek bir Aril Yarığı bile görünmüyor."
      },
      {
        "msgID": "AI_MSG_L0095_03",
        "msgStr": "Raido'nun yüzündeki yara izi süs olsun diye durmuyor."
      },
      {
        "msgID": "AI_MSG_L0095_04",
        "msgStr": "Öyleyse artık buna bir son verme vakti geldi. Bana kudretini göster!"
      },
      {
        "msgID": "ai_msg_BTLAI_MES_024_002",
        "msgStr": "NULL"
      },
      {
        "msgID": "AI_MSG_L0095_05",
        "msgStr": "> Raidou, Omitsunu'ya saygılarını sundu ve ardından dövüşmeye hazırlandı."
      },
      {
        "msgID": "ai_msg_BTLAI_MES_024_003",
        "msgStr": "NULL"
      },
      {
        "msgID": "AI_MSG_L0095_06",
        "msgStr": "> Raidou, Omitsunu'ya mevcut zaman çizgisini sordu."
      },
      {
        "msgID": "ai_msg_BTLAI_MES_024_004",
        "msgStr": "Gouto"
      },
      {
        "msgID": "AI_MSG_L0095_07",
        "msgStr": "ER100"
      },
      {
        "msgID": "AI_MSG_L0095_08",
        "msgStr": "ER100"
      },
      {
        "msgID": "ai_msg_BTLAI_MES_026_001_063",
        "msgStr": "Yamata-no-Orochi"
      },
      {
        "msgID": "AI_MSG_L0096",
        "msgStr": "SU PRİZMASINI SANA TESLİM ETMEYECEĞİM, ACİZ İNSAN!"
      },
      {
        "msgID": "ai_msg_BTLAI_MES_02F_001_064",
        "msgStr": "Susano-o"
      },
      {
        "msgID": "AI_MSG_L0097",
        "msgStr": "Heh, bayağı ilginç birisin, biliyorsun değil mi? Seni sevdim."
      },
      {
        "msgID": "AI_MSG_L0097_01",
        "msgStr": "...Ne, Rasputin mi? Bir çeşit makine insan mıymış?"
      },
      {
        "msgID": "AI_MSG_L0097_02",
        "msgStr": "Yok, adını hiç duymadım. Ama konu makineler olunca..."
      },
      {
        "msgID": "AI_MSG_L0097_03",
        "msgStr": "Uzak gelecekten gelip bu dünyayı karıştıran birini <IT_S>duymuştum<IT_E>."
      },
      {
        "msgID": "AI_MSG_L0097_04",
        "msgStr": "Sanırım o da bir Raidou Kuzunoha'ydı. Gelecek bir nesilden tabii."
      },
      {
        "msgID": "AI_MSG_L0097_05",
        "msgStr": "Raido ve o lanet Yatagarasu bunun olmasını engellemek için çırpınıp duruyordu."
      },
      {
        "msgID": "AI_MSG_L0097_06",
        "msgStr": "Ee, dövüşmeye hazır mısın bakalım? Hadi başlayalım."
      },
      {
        "msgID": "ai_msg_BTLAI_MES_02F_002",
        "msgStr": "NULL"
      },
      {
        "msgID": "AI_MSG_L0097_07",
        "msgStr": "> Raidou, Susano-o'ya saygılarını sundu ve ardından dövüşmeye hazırlandı."
      },
      {
        "msgID": "ai_msg_BTLAI_MES_02F_003",
        "msgStr": "NULL"
      },
      {
        "msgID": "AI_MSG_L0097_08",
        "msgStr": "> Raidou, Susano-o'ya mevcut zaman çizgisini sordu."
      },
      {
        "msgID": "ai_msg_BTLAI_MES_02F_004",
        "msgStr": "Gouto"
      },
      {
        "msgID": "AI_MSG_L0097_09",
        "msgStr": "ER100"
      },
      {
        "msgID": "AI_MSG_L0097_10",
        "msgStr": "ER100"
      },
      {
        "msgID": "ai_msg_BTLAI_MES_HYAKKI_001_065",
        "msgStr": "NULL"
      },
      {
        "msgID": "AI_MSG_L0098",
        "msgStr": "> Yüz İblis Sınavı başladı! Bir iblis sürüsü saldırıyor!"
      },
      {
        "msgID": "ai_msg_BTLAI_MES_0C7_001_066",
        "msgStr": "Kudan"
      },
      {
        "msgID": "AI_MSG_L0099",
        "msgStr": "Görebiliyorum... Alevler içinde kalmış Başkent'i..."
      },
      {
        "msgID": "AI_MSG_L0100",
        "msgStr": "Dehşet içinde kaçışan vatandaşları... Şehri kasıp kavuran bir canavarı..."
      },
      {
        "msgID": "AI_MSG_L0101",
        "msgStr": "Bu senin kaçınılmaz kaderin... Kaçış imkânsız. Kendini hazırla."
      },
      {
        "msgID": "ai_msg_BTLAI_MES_0C7_002_067",
        "msgStr": "Kudan"
      },
      {
        "msgID": "AI_MSG_L0102",
        "msgStr": "Görebiliyorum..."
      },
      {
        "msgID": "AI_MSG_L0103",
        "msgStr": "Felaketin alevlerinden yeni bir Başkent doğacak..."
      },
      {
        "msgID": "AI_MSG_L0104",
        "msgStr": "İnsanların boyun eğmez yürekleri yeni bir kader çizecek."
      },
      {
        "msgID": "ai_msg_BTLAI_MES_1ED_001_068",
        "msgStr": "Kudan"
      },
      {
        "msgID": "AI_MSG_L0105",
        "msgStr": "<COLOR 3>Yüz İblis Sınavı<COLOR 0>—İblis Lordu'na meydan okuyacak olanlar için zorlu bir imtihan..."
      },
      {
        "msgID": "AI_MSG_L0106",
        "msgStr": "<COLOR 3>Sekiz panelin etrafında yürü<COLOR 0>, belki şans eseri ona rastlarsın..."
      },
      {
        "msgID": "ai_msg_BTLAI_MES_1EE_001_069",
        "msgStr": "Kudan"
      },
      {
        "msgID": "AI_MSG_L0107",
        "msgStr": "<COLOR 3>Yüz İblis Sınavı<COLOR 0>—İblis Lordu'na meydan okuyacak olanlar için zorlu bir imtihan..."
      },
      {
        "msgID": "AI_MSG_L0108",
        "msgStr": "<COLOR 3>Yukarıdaki ışık gizlendiğinde güneybatıda<COLOR 0>, belki şans eseri ona rastlarsın..."
      },
      {
        "msgID": "ai_msg_BTLAI_MES_1EF_001_070",
        "msgStr": "Kudan"
      },
      {
        "msgID": "AI_MSG_L0109",
        "msgStr": "<COLOR 3>Yüz İblis Sınavı<COLOR 0>—İblis Lordu'na meydan okuyacak olanlar için zorlu bir imtihan..."
      },
      {
        "msgID": "AI_MSG_L0110",
        "msgStr": "Onu <COLOR 3>yukarıdaki ışık kusursuz bir daire oluşturduğunda, kuzeydoğuda<COLOR 0> deneyimleyebilirsin..."
      },
      {
        "msgID": "ai_msg_BTLAI_MES_1F0_001_071",
        "msgStr": "Kudan"
      },
      {
        "msgID": "AI_MSG_L0111",
        "msgStr": "<COLOR 1>Hayalet Kafatası<COLOR 0>, İblis Lordu'na meydan okuyanlara cesaret bahşedecek."
      },
      {
        "msgID": "ai_msg_BTLAI_MES_1F0_002_072",
        "msgStr": "Kudan"
      },
      {
        "msgID": "AI_MSG_L0112",
        "msgStr": "<COLOR 1>Tiran Dölü<COLOR 0>, İblis Lordu'na meydan okurken kişinin yere sağlam basmasını sağlayacak."
      },
      {
        "msgID": "ai_msg_BTLAI_MES_1F0_003_073",
        "msgStr": "Kudan"
      },
      {
        "msgID": "AI_MSG_L0113",
        "msgStr": "<COLOR 1>Cehennem Amblemi<COLOR 0>, İblis Lordu'na meydan okuma yolunu açacak."
      },
      {
        "msgID": "ai_msg_BTLAI_MES_028_001_074_01",
        "msgStr": "NULL"
      },
      {
        "msgID": "AI_MSG_L0114_04",
        "msgStr": "> Raidou, Chernobog'u konuşturmaya çalıştı."
      },
      {
        "msgID": "ai_msg_BTLAI_MES_028_001_074",
        "msgStr": "Chernobog"
      },
      {
        "msgID": "AI_MSG_L0114_05",
        "msgStr": "Hm? Ne dedin? \"Projemiz\" hakkında daha fazla şey mi öğrenmek istiyorsun?"
      },
      {
        "msgID": "AI_MSG_L0114",
        "msgStr": "Hohoho, korkarım o konuda konuşamam ama sana en az onun kadar ilgi çekici bir şey anlatacağım."
      },
      {
        "msgID": "AI_MSG_L0114_01",
        "msgStr": "Başkent'in Karanlık Diyarı'ndaki zombileri gördün, değil mi?"
      },
      {
        "msgID": "AI_MSG_L0114_02",
        "msgStr": "Bir Hiruko insan bedenini terk ettiğinde geriye işte o kalır."
      },
      {
        "msgID": "AI_MSG_L0114_03",
        "msgStr": "Amaçsızca dolaşmaktan başka hiçbir gayesi olmayan yaşayan cesetler... Acınası. Gerçekten çok acınası, değil mi?"
      },
      {
        "msgID": "AI_MSG_L0115",
        "msgStr": "Öyleyse onlara arkadaşlık etmen için seni doğrudan Cehennem'e göndereceğim!"
      },
      {
        "msgID": "ai_msg_BTLAI_MES_028_002_075",
        "msgStr": "Chernobog"
      },
      {
        "msgID": "AI_MSG_L0116",
        "msgStr": "Gizli tekniğime karşı hiç şansın yok evlat!"
      },
      {
        "msgID": "ai_msg_BTLAI_MES_028_003_076",
        "msgStr": "Chernobog"
      },
      {
        "msgID": "AI_MSG_L0117",
        "msgStr": "Daha işim bitmedi evlat! Bu sefer üç kişiyiz..."
      },
      {
        "msgID": "ai_msg_BTLAI_MES_028_004_077",
        "msgStr": "Chernobog"
      },
      {
        "msgID": "AI_MSG_L0118",
        "msgStr": "Cehennem seni tek lokmada yutana dek tekmelemeye devam edeceğim!"
      },
      {
        "msgID": "ai_msg_BTLAI_MES_028_005_078",
        "msgStr": "Chernobog"
      },
      {
        "msgID": "AI_MSG_L0119",
        "msgStr": "Fena değil, Çağırıcı... Ama artık eldivenleri çıkarıyoruz!"
      },
      {
        "msgID": "ai_msg_BTLAI_MES_028_006_079",
        "msgStr": "Chernobog"
      },
      {
        "msgID": "AI_MSG_L0120",
        "msgStr": "Cehennem <IT_S>beni<IT_E> mi alıyor...? Efendi Rasputin...!\n<mw 180>"
      },
      {
        "msgID": "ai_msg_BTLAI_MES_03A_001_080",
        "msgStr": "Raidou XL"
      },
      {
        "msgID": "AI_MSG_L0121",
        "msgStr": "<lips 27 6>"
      },
      {
        "msgID": "AI_MSG_L0122",
        "msgStr": "Bugünü yok etmek için geçmişin değiştirilmesi gerekir.\n<lips_stop>"
      },
      {
        "msgID": "AI_MSG_L0123",
        "msgStr": "<lips 27 6>"
      },
      {
        "msgID": "AI_MSG_L0124",
        "msgStr": "Dolayısıyla geçmişteki insanların kurban edilmesi son derece doğaldır.\n<lips_stop>"
      },
      {
        "msgID": "AI_MSG_L0124_01",
        "msgStr": "<lips 27 6>"
      },
      {
        "msgID": "AI_MSG_L0124_02",
        "msgStr": "Geleceğin bu hâlde olması senin suçun!\n<lips_stop>"
      },
      {
        "msgID": "ai_msg_BTLAI_MES_03A_002_081",
        "msgStr": "NULL"
      },
      {
        "msgID": "AI_MSG_L0125",
        "msgStr": "> Raidou, Raidou XL'e davayı sordu."
      },
      {
        "msgID": "ai_msg_BTLAI_MES_03A_002_081_01",
        "msgStr": "Raidou XL"
      },
      {
        "msgID": "AI_MSG_L0126",
        "msgStr": "Heh... Kendi başına düşünüp soruşturma yürütüyorsun, öyle mi? Köyde ben de böyle öğrenmiştim."
      },
      {
        "msgID": "AI_MSG_L0126_01",
        "msgStr": "Kim olursa olsun ya da ne zaman olursa olsun, soru sorma fırsatını hiç kaçırmıyorsun, Ondördüncü."
      },
      {
        "msgID": "AI_MSG_L0126_02",
        "msgStr": "Savaşımızın ortasında bile özünden ödün vermiyorsun. Onur duydum. Öyleyse sana istediğini anlatacağım."
      },
      {
        "msgID": "AI_MSG_L0126_03",
        "msgStr": "Geçmişi değiştirmek için özel bir teknik kullanarak anılarımı tüm zamanlardaki her Daidouji ailesi kızına aktardım."
      },
      {
        "msgID": "AI_MSG_L0126_04",
        "msgStr": "Tarihi Taisho 20'ye kadar rayından çıkmaya işte böyle zorladım."
      },
      {
        "msgID": "AI_MSG_L0126_05",
        "msgStr": "Ancak işin aslı, anı aktarımı henüz tamamlanmadı. Taisho'nun ötesindeki zaman dilimleri hâlâ etkilenmiş değil."
      },
      {
        "msgID": "AI_MSG_L0126_06",
        "msgStr": "Bu yüzden burada durma lüksüm yok, Ondördüncü."
      },
      {
        "msgID": "AI_MSG_L0126_07",
        "msgStr": "Benimle emellerimin arasına giremeyeceksin!"
      },
      {
        "msgID": "ai_msg_BTLAI_MES_03A_003_082",
        "msgStr": "NULL"
      },
      {
        "msgID": "AI_MSG_L0127",
        "msgStr": "> Raidou, Raidou XL'e davayı sordu."
      },
      {
        "msgID": "ai_msg_BTLAI_MES_03A_003_082_01",
        "msgStr": "Raidou XL"
      },
      {
        "msgID": "AI_MSG_L0128",
        "msgStr": "Evet, Sukuna-Hikona benim müttefikim. Onu Taisho 20'ye gönderen bendim."
      },
      {
        "msgID": "AI_MSG_L0128_01",
        "msgStr": "Anı aktarımını tamamlamak için ona Munakata'yı ele geçirme, Süper Asker Projesi'ni başlatma ve Kaya'yı kaçırma görevlerini verdim."
      },
      {
        "msgID": "AI_MSG_L0128_02",
        "msgStr": "Bizim zamanımızda iblisler makinelerle kontrol ediliyor. Geçmişin yöntemleriyle pek kıyaslanamaz."
      },
      {
        "msgID": "AI_MSG_L0128_03",
        "msgStr": "Yine de çağırma yeteneklerim oldukça etkileyici, sence de öyle değil mi?"
      },
      {
        "msgID": "ai_msg_BTLAI_MES_03A_004_083",
        "msgStr": "Raidou XL"
      },
      {
        "msgID": "AI_MSG_L0129",
        "msgStr": "<lips 27 6>"
      },
      {
        "msgID": "AI_MSG_L0130",
        "msgStr": "...Sanırım genç bir kızın bedeninin de sınırları var.\n<lips_stop>"
      },
      {
        "msgID": "AI_MSG_L0131",
        "msgStr": "<lips 27 6>"
      },
      {
        "msgID": "AI_MSG_L0132",
        "msgStr": "Artık kendimi tutmayacağım, Ondördüncü. Bu insan bedenini bırakıp mutlak gücü kucaklayacağım.\n<lips_stop>"
      },
      {
        "msgID": "ai_msg_BTLAI_MES_03B_001_084",
        "msgStr": "Raidou XL"
      },
      {
        "msgID": "AI_MSG_L0133",
        "msgStr": "Ben Raidou Kuzunoha soyunun kırkıncısıyım. Sana da çok fazla halef geçmiş gibi gelmiyor mu?"
      },
      {
        "msgID": "AI_MSG_L0133_01",
        "msgStr": "Benim çağımda Raidou Kuzunoha olmak bir kahraman olmak değil, bir kurban olmaktır."
      },
      {
        "msgID": "AI_MSG_L0133_02",
        "msgStr": "Bu unvanı devraldıktan sonra bir yıl hayatta kalabilirsek şanslıyız. Bazıları birkaç günden fazla dayanamaz."
      },
      {
        "msgID": "AI_MSG_L0133_03",
        "msgStr": "Yatagarasu çoktan dağıldığı için Kuzunoha'lar basit birer askerî piyondan başka bir şey değil!"
      },
      {
        "msgID": "AI_MSG_L0133_04",
        "msgStr": "Bize \"yabancı\" diyorlar ve asi muhalifleri bastırmak için bizi ön saflara sürüyorlar."
      },
      {
        "msgID": "AI_MSG_L0133_05",
        "msgStr": "Bizim için bir gelecek yok! Yarın yok!"
      },
      {
        "msgID": "AI_MSG_L0133_06",
        "msgStr": "Hadi gidelim, Yasomagatsu! Kullanılıp çöp gibi bir kenara atılmaktan bıktım artık!"
      },
      {
        "msgID": "ai_msg_BTLAI_MES_03C_001_085",
        "msgStr": "Raidou XL"
      },
      {
        "msgID": "AI_MSG_L0134",
        "msgStr": "Ülkeni koruduğunu mu söylüyorsun, Ondördüncü? Yurdunu önemsediğini mi söylüyorsun?"
      },
      {
        "msgID": "AI_MSG_L0135",
        "msgStr": "Hah! Senin ve Munakata'nın gibiler yalnızca kendi örgütleriniz tarafından kullanılıyorsunuz!"
      },
      {
        "msgID": "AI_MSG_L0135_01",
        "msgStr": "Senin gibi aciz bir ayakçı, yoluma çıkmaması gerektiğini bilmeli!"
      },
      {
        "msgID": "ai_msg_BTLAI_MES_03C_001_085_01",
        "msgStr": "Gouto"
      },
      {
        "msgID": "AI_MSG_L0135_02",
        "msgStr": "Yanılıyorsun, Kırkıncı."
      },
      {
        "msgID": "AI_MSG_L0135_03",
        "msgStr": "Ülkeyi korumak, hükümeti ya da gelenekleri savunmak demek değildir. Halkı savunmak demektir."
      },
      {
        "msgID": "ai_msg_BTLAI_MES_03C_001_085_02",
        "msgStr": "Goto"
      },
      {
        "msgID": "AI_MSG_L0135_04",
        "msgStr": "Kesinlikle. Kimin acı çektiği önemli değildir; önemli olan, kişisel ilkelerimiz ne olursa olsun onları kurtarmamızdır."
      },
      {
        "msgID": "ai_msg_BTLAI_MES_03C_001_085_03",
        "msgStr": "Gouto"
      },
      {
        "msgID": "AI_MSG_L0135_05",
        "msgStr": "Tarihi halk yazar. Biz sadece gölgelerden onlara destek oluruz."
      },
      {
        "msgID": "AI_MSG_L0135_06",
        "msgStr": "Raidou Kuzunoha'nın gerçek gayesi—gerçek Ruh Gücü—işte budur."
      },
      {
        "msgID": "ai_msg_BTLAI_MES_03C_001_085_04",
        "msgStr": "Goto"
      },
      {
        "msgID": "AI_MSG_L0135_07",
        "msgStr": "Görünüşe göre nihayet bir konuda hemfikiriz."
      },
      {
        "msgID": "ai_msg_BTLAI_MES_03C_001_085_05",
        "msgStr": "Gouto"
      },
      {
        "msgID": "AI_MSG_L0135_08",
        "msgStr": "Ondördüncü Raidou, halkı senin habis pençelerinden kurtaracak. Ne eksik ne fazla."
      },
      {
        "msgID": "ai_msg_BTLAI_MES_03C_001_085_06",
        "msgStr": "Goto"
      },
      {
        "msgID": "AI_MSG_L0135_09",
        "msgStr": "Endişelenme, Kırkıncı. Buradaki selefin seni kendi umutsuzluğundan da kurtaracak."
      },
      {
        "msgID": "ai_msg_BTLAI_MES_03C_002_086",
        "msgStr": "Raidou XL"
      },
      {
        "msgID": "AI_MSG_L0136",
        "msgStr": "Bu olamaz... Kaybedecek miyim? Hayır... Hayır!"
      },
      {
        "msgID": "ai_msg_BTLAI_MES_03C_003_087",
        "msgStr": "Raidou XL"
      },
      {
        "msgID": "AI_MSG_L0137",
        "msgStr": "Bir keresinde bir iblis bana şöyle demişti..."
      },
      {
        "msgID": "AI_MSG_L0138",
        "msgStr": "\"Bu insanlar... korunmayı hak etmiyor.\""
      },
      {
        "msgID": "AI_MSG_L0138_01",
        "msgStr": "Benim gücüm... Asla halka hizmet etmek için var olmadı!"
      },
      {
        "msgID": "ai_msg_BTLAI_MES_03C_004_088",
        "msgStr": "Raidou XL"
      },
      {
        "msgID": "AI_MSG_L0139",
        "msgStr": "Çok güçlüsün... Yapamıyorum...! Bir gayeye sahip olmak... böyle bir şey mi!?"
      },
      {
        "msgID": "AI_MSG_L0140",
        "msgStr": "Hayır... Geri dönmek istemiyorum... O acınası dünyaya dönmem!"
      },
      {
        "msgID": "AI_MSG_L0141",
        "msgStr": "Gerçekten... istediğin bu mu...? Eğer bir şey yapmazsan... geleceğin mahvolacak..."
      },
      {
        "msgID": "AI_MSG_L0141_01",
        "msgStr": "Benim görevim halkı korumak."
      },
      {
        "msgID": "AI_MSG_L0141_02",
        "msgStr": "......"
      },
      {
        "msgID": "AI_MSG_L0141_03",
        "msgStr": "Geleceği bana bırak."
      },
      {
        "msgID": "AI_MSG_L0141_04",
        "msgStr": "......"
      },
      {
        "msgID": "ai_msg_BTLAI_MES_03C_ADD_01_01",
        "msgStr": "Raidou"
      },
      {
        "msgID": "AI_MSG_L0180",
        "msgStr": "Benim görevim halkı korumak."
      },
      {
        "msgID": "ai_msg_BTLAI_MES_03C_ADD_01_02",
        "msgStr": "Raidou XL"
      },
      {
        "msgID": "AI_MSG_L0142",
        "msgStr": "Ne—"
      },
      {
        "msgID": "ai_msg_BTLAI_MES_03C_ADD_01_03",
        "msgStr": "Gouto"
      },
      {
        "msgID": "AI_MSG_L0181",
        "msgStr": "Geçmişi değiştirmeye çalışmış olabilirsin, Kırkıncı..."
      },
      {
        "msgID": "ai_msg_BTLAI_MES_03C_ADD_01_04",
        "msgStr": "Goto"
      },
      {
        "msgID": "AI_MSG_L0182",
        "msgStr": "Fakat Ondördüncü Raidou Kuzunoha buradayken, gelecek ne getirirse getirsin..."
      },
      {
        "msgID": "ai_msg_BTLAI_MES_03C_ADD_01_05",
        "msgStr": "Raidou"
      },
      {
        "msgID": "AI_MSG_L0183",
        "msgStr": "Başarısız olmayacağım."
      },
      {
        "msgID": "ai_msg_BTLAI_MES_03C_ADD_01_06",
        "msgStr": "Raidou XL"
      },
      {
        "msgID": "AI_MSG_L0184",
        "msgStr": "...Hıh!"
      },
      {
        "msgID": "ai_msg_BTLAI_MES_03C_ADD_01_07",
        "msgStr": "Raidou XL"
      },
      {
        "msgID": "AI_MSG_L0185",
        "msgStr": "Bu... senin Ruh Gücünün kudreti mi yani? Kaderini... kabullenme kararlılığı mı!?"
      },
      {
        "msgID": "ai_msg_BTLAI_MES_03C_ADD_01_08",
        "msgStr": "Raidou"
      },
      {
        "msgID": "AI_MSG_L0186",
        "msgStr": "Geleceği bana bırak."
      },
      {
        "msgID": "ai_msg_BTLAI_MES_03C_ADD_01_09",
        "msgStr": "Raidou XL"
      },
      {
        "msgID": "AI_MSG_L0187",
        "msgStr": "Ne—"
      },
      {
        "msgID": "ai_msg_BTLAI_MES_03C_ADD_01_10",
        "msgStr": "Gouto"
      },
      {
        "msgID": "AI_MSG_L0188",
        "msgStr": "Geçmişi değiştirmeye çalışmış olabilirsin, Kırkıncı..."
      },
      {
        "msgID": "ai_msg_BTLAI_MES_03C_ADD_01_11",
        "msgStr": "Goto"
      },
      {
        "msgID": "AI_MSG_L0189",
        "msgStr": "Fakat Ondördüncü Raidou Kuzunoha söz konusu olduğunda..."
      },
      {
        "msgID": "ai_msg_BTLAI_MES_03C_ADD_01_12",
        "msgStr": "Raidou"
      },
      {
        "msgID": "AI_MSG_L0190",
        "msgStr": "Gelecek benim ellerimde."
      },
      {
        "msgID": "ai_msg_BTLAI_MES_03C_ADD_01_13",
        "msgStr": "Raidou XL"
      },
      {
        "msgID": "AI_MSG_L0191",
        "msgStr": "...Hıh!"
      },
      {
        "msgID": "ai_msg_BTLAI_MES_03C_ADD_01_14",
        "msgStr": "Raidou XL"
      },
      {
        "msgID": "AI_MSG_L0192",
        "msgStr": "Bu... senin Ruh Gücünün kudreti mi yani? Kaderin içinden... kendi yolunu açmak mı!?"
      },
      {
        "msgID": "ai_msg_BTLAI_MES_03C_ADD_01_15",
        "msgStr": "Gouto"
      },
      {
        "msgID": "AI_MSG_L0193",
        "msgStr": "Raidou adını yaşatmak işte bu demektir."
      },
      {
        "msgID": "ai_msg_BTLAI_MES_03C_ADD_01_16",
        "msgStr": "Raidou XL"
      },
      {
        "msgID": "AI_MSG_L0194",
        "msgStr": "Heh... Seni neyin beklediğini biliyorum, Ondördüncü..."
      },
      {
        "msgID": "AI_MSG_L0195",
        "msgStr": "Yakında... sen, Raidou Kuzunoha... pek çok engelle yüz yüze geleceksin..."
      },
      {
        "msgID": "AI_MSG_L0196",
        "msgStr": "Büyük bir hadise... Bir rakiple çarpışma... Bir ihanet..."
      },
      {
        "msgID": "AI_MSG_L0197",
        "msgStr": "Tarihi değiştirmeyi... başaramadığını bilerek... umutsuzluğa düşesin!"
      },
      {
        "msgID": "ai_msg_BTLAI_MES_03C_005_089",
        "msgStr": "Raidou XL"
      },
      {
        "msgID": "AI_MSG_L0143",
        "msgStr": "Ngh!? Bunun anlamı ne!?"
