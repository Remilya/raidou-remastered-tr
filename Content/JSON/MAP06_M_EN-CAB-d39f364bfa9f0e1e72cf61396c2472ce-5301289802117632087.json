      },
      {
        "msgID": "map06_m_m_mes_KITUNE_L_ITEM_01_003",
        "msgStr": "Tilki (Sol)"
      },
      {
        "msgID": "MAP06_M_L0252",
        "msgStr": "Onları denemek için iyi bir zaman olabilir."
      },
      {
        "msgID": "map06_m_m_mes_KITUNE_L_ITEM_02_000",
        "msgStr": "Tilki (Sol)"
      },
      {
        "msgID": "MAP06_M_L0253",
        "msgStr": "Tütsüler, senin veya iblislerinin niteliklerini güçlendirerek <COLOR 1>onları 1 artıran<COLOR 0> ilginç bir yeteneğe sahiptir."
      },
      {
        "msgID": "MAP06_M_L0254",
        "msgStr": "Dört farklı türü vardır: <COLOR 1>Güç Tütsüsü<COLOR 0>, <COLOR 1>Büyü Tütsüsü<COLOR 0>, <COLOR 1>Dayanıklılık Tütsüsü<COLOR 0> ve <COLOR 1>Şans Tütsüsü<COLOR 0>. Her biri farklı bir niteliği artırır."
      },
      {
        "msgID": "MAP06_M_L0255",
        "msgStr": "ER100"
      },
      {
        "msgID": "MAP06_M_L0256",
        "msgStr": "Tütsüler, seviye atlamadan veya iblis füzyonundan güç kazanmadan niteliklerini istediğin gibi artırmana olanak tanır. O yüzden onları iyi değerlendir."
      },
      {
        "msgID": "MAP06_M_L0257",
        "msgStr": "Duyduğuma göre farklı Eğitim Salonu şubelerine <COLOR 1>eşya toplama yeteneğine sahip<COLOR 0> bir iblis götürürsen, güzel şeyler bulabilirlermiş..."
      },
