        "msgID": "MAP06_M_L0283",
        "msgStr": "> <ITM_13><COLOR 4>Patra Kitabı<COLOR 0> x1 elde edildi."
      },
      {
        "msgID": "map06_m_m_mes_KITUNE_L_ITEM_04_003",
        "msgStr": "Tilki (Sol)"
      },
      {
        "msgID": "MAP06_M_L0284",
        "msgStr": "Şimdi git ve yetenek kitaplarının neler yapabildiğini kendi gözlerinle gör!"
