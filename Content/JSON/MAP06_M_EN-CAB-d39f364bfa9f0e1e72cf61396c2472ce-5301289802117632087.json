        "msgID": "map06_m_m_mes_KITUNE_L_ITEM_03_002",
        "msgStr": "NULL"
      },
      {
        "msgID": "MAP06_M_L0268",
        "msgStr": "> Raidou, <ITM_11><COLOR 4>\"Mansaku\" Sakesi<COLOR 0> x1 elde etti."
      },
      {
        "msgID": "MAP06_M_L0269",
        "msgStr": "> <ITM_11><COLOR 4>\"Homura\" Sakesi<COLOR 0> x1 elde edildi."
      },
      {
        "msgID": "map06_m_m_mes_KITUNE_L_ITEM_03_003",
        "msgStr": "Tilki (Sol)"
      },
      {
        "msgID": "MAP06_M_L0270",
        "msgStr": "Öğrenmenin uygulayarak görmekten daha iyi bir yolu yoktur. İkimiz de daha iyisi için gelişmeye devam edelim!"
      },
      {
        "msgID": "map06_m_m_mes_KITUNE_L_ITEM_04_000",
        "msgStr": "Tilki (Sol)"
      },
      {
        "msgID": "MAP06_M_L0271",
        "msgStr": "Yetenek kitapları, <COLOR 1>iblislerine yetenek öğretmek<COLOR 0> gibi mistik bir güce sahiptir."
      },
      {
        "msgID": "MAP06_M_L0272",
        "msgStr": "Her kitap öğrettiği yeteneğin adını taşır. \"Agi Kitabı\" Agi öğretir, \"Bufu Kitabı\" Bufu öğretir ve bu böyle devam eder."
      },
      {
        "msgID": "MAP06_M_L0273",
        "msgStr": "Ancak iblislerin bir yeteneği öğrenmeden önce bu kitapları tam olarak nasıl kullandığına dair küçük bir incelik vardır."
      },
      {
        "msgID": "MAP06_M_L0274",
        "msgStr": "Genel bir kural olarak, <COLOR 1>1 yetenek kitabı okumak o yeteneği kullanmak için yeterlidir<COLOR 0>."
      },
      {
        "msgID": "MAP06_M_L0275",
        "msgStr": "Fakat iblisin bu yeteneği iblis füzyonu yoluyla aktarabilmesi için tamamen öğrenmesi bambaşka bir konudur."
      },
      {
        "msgID": "MAP06_M_L0276",
        "msgStr": "Çünkü <COLOR 1>bir yeteneği tamamen öğrenmek için bazı yetenek kitaplarının diğerlerinden daha fazla okunması gerekir<COLOR 0>."
      },
      {
        "msgID": "MAP06_M_L0277",
        "msgStr": "Bazı yetenek kitaplarının sadece 1 kez okunması yeterliyken, bazılarının diyelim ki 3 kez okunması gerekebilir. Bu kitaba bağlıdır. Ve o zamana kadar yetenek yalnızca kısmen öğrenilmiş olur."
      },
      {
        "msgID": "MAP06_M_L0278",
        "msgStr": "Sanırım söylenenler doğru; hayatta hiçbir şey kolay değil."
      },
      {
        "msgID": "MAP06_M_L0279",
        "msgStr": "Her halükârda, yetenek kitaplarını kullanmak biraz zahmetli olabilir ama buna değer. Hatta <COLOR 1>iblislere normalde öğrenmeleri imkânsız olan yetenekleri bile öğretebilirler<COLOR 0>."
      },
      {
        "msgID": "MAP06_M_L0280",
        "msgStr": "Duyduğuma göre yetenek kitaplarına denk gelmenin en güvenilir yolları, <COLOR 1>onları hapsedilme sanatını kullanarak düşmanlardan almak<COLOR 0> ve <COLOR 1>iblis müttefiklerini yoklamaktır<COLOR 0>."
      },
