      },
      {
        "msgID": "DVLTKMES_00A_L0045",
        "msgStr": "ER100"
      },
      {
        "msgID": "DVLTKMES_00A_L0046",
        "msgStr": "ER100"
      },
      {
        "msgID": "DVLTKMES_00A_L0047",
        "msgStr": "Beni tüpün içine çeken de kim, ho?"
      },
      {
        "msgID": "DVLTKMES_00A_L0048",
        "msgStr": "14. Raidou Kuzunoha."
      },
      {
        "msgID": "DVLTKMES_00A_L0049",
        "msgStr": "<NAME 0>."
      },
      {
        "msgID": "DVLTKMES_00A_L0050",
        "msgStr": "Söylemem."
      },
      {
        "msgID": "DVLTKMES_00A_L0051",
        "msgStr": "Sana katıldıktan sonra bana-ho ne olacak, ho?"
      },
      {
        "msgID": "DVLTKMES_00A_L0052",
        "msgStr": "Seni güçlendireceğim."
      },
      {
        "msgID": "DVLTKMES_00A_L0053",
        "msgStr": "Seni çalıştıracağım."
      },
      {
        "msgID": "DVLTKMES_00A_L0054",
        "msgStr": "Seni füzyon için kullanacağım."
      },
      {
        "msgID": "DVLTKMES_00A_L0055",
        "msgStr": "İn-hee-sanlar ve iblisler arkadaş olabilir mi, ho?"
      },
      {
        "msgID": "DVLTKMES_00A_L0056",
        "msgStr": "Elbette olabiliriz."
      },
      {
        "msgID": "DVLTKMES_00A_L0057",
        "msgStr": "Hayır, olamayız."
      },
      {
        "msgID": "DVLTKMES_00A_L0058",
        "msgStr": "Arkadaştan öte olabiliriz."
      },
      {
        "msgID": "DVLTKMES_00A_L0059",
        "msgStr": "Gerçekten ne hee-istiyorsun, ho?"
      },
      {
        "msgID": "DVLTKMES_00A_L0060",
        "msgStr": "Sonsuz zenginlik."
      },
      {
        "msgID": "DVLTKMES_00A_L0061",
        "msgStr": "Sınırsız sevgi."
      },
      {
        "msgID": "DVLTKMES_00A_L0062",
        "msgStr": "Tek istediğim sensin."
      },
      {
        "msgID": "DVLTKMES_00A_L0063",
        "msgStr": "Bütün hee-dünyada en sevdiğin şey ne, ho?"
      },
      {
        "msgID": "DVLTKMES_00A_L0064",
        "msgStr": "Para."
      },
      {
        "msgID": "DVLTKMES_00A_L0065",
        "msgStr": "Şefkat."
      },
      {
        "msgID": "DVLTKMES_00A_L0066",
        "msgStr": "Kendim."
      },
      {
        "msgID": "DVLTKMES_00A_L0067",
        "msgStr": "Sen bir de-hee-dektifsin, değil mi? Çok havalı, ho."
      },
      {
        "msgID": "DVLTKMES_00A_L0068",
        "msgStr": "Peki, tam olarak neden davaları çözüyorsun, ho?"
      },
      {
        "msgID": "DVLTKMES_00A_L0069",
        "msgStr": "Gerçek suçluları yakalamak için."
      },
      {
        "msgID": "DVLTKMES_00A_L0070",
        "msgStr": "Başkent'i korumak için."
      },
      {
        "msgID": "DVLTKMES_00A_L0071",
        "msgStr": "Görevimi yerine getirmek için."
      },
      {
        "msgID": "DVLTKMES_00A_L0072",
        "msgStr": "Hee ho! Seni sevdim, ho!"
      },
      {
        "msgID": "DVLTKMES_00A_L0073",
        "msgStr": "Hee ho!"
      },
      {
        "msgID": "DVLTKMES_00A_L0074",
        "msgStr": "Çok hee-heyecanlandım, ho!"
      },
      {
        "msgID": "DVLTKMES_00A_L0075",
        "msgStr": "Sana gerçekten ina-hee-nabilir miyim, ho?"
      },
      {
        "msgID": "DVLTKMES_00A_L0076",
        "msgStr": "Hımm..."
      },
      {
        "msgID": "DVLTKMES_00A_L0077",
