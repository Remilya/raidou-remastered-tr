      },
      {
        "msgID": "DVLTKMES_00A_L0001",
        "msgStr": "Bu benim hee-anım, ho!"
      },
      {
        "msgID": "DVLTKMES_00A_L0002",
        "msgStr": "Hee-ho'lar çok daha hee-üstündür, ho!"
      },
      {
        "msgID": "DVLTKMES_00A_L0003",
        "msgStr": "Olağan-hee-üstü değil miyim, ho?"
      },
      {
        "msgID": "DVLTKMES_00A_L0004",
        "msgStr": "Bana bir puan yazın-ho!"
      },
      {
        "msgID": "DVLTKMES_00A_L0005",
        "msgStr": "Hâlâ ayaktalar, ho..."
      },
      {
        "msgID": "DVLTKMES_00A_L0006",
        "msgStr": "Raidou, bu hee-hiç iyi değil, ho!"
      },
      {
        "msgID": "DVLTKMES_00A_L0007",
        "msgStr": "Hiçbir şey bulamadım, ho..."
      },
      {
        "msgID": "DVLTKMES_00A_L0008",
        "msgStr": "Bana-ho bir şans daha ver, ho!"
      },
      {
        "msgID": "DVLTKMES_00A_L0009",
        "msgStr": "Hee ho! Isınmaya hee-başladım, ho!"
      },
      {
        "msgID": "DVLTKMES_00A_L0010",
        "msgStr": "Heeeeee ho!"
      },
      {
        "msgID": "DVLTKMES_00A_L0011",
        "msgStr": "İnsanlarda hee-hiç iş yok, ho."
      },
      {
        "msgID": "DVLTKMES_00A_L0012",
        "msgStr": "Raidou, çok berbatsın, ho!"
      },
      {
        "msgID": "DVLTKMES_00A_L0013",
        "msgStr": "Ben bir psiko-ho'yum, hee ho!"
      },
      {
        "msgID": "DVLTKMES_00A_L0014",
        "msgStr": "Olamaz hee-hayır! Yardım et bana-ho!"
      },
      {
        "msgID": "DVLTKMES_00A_L0015",
        "msgStr": "Hu-hee-zur içinde yatacağım, ho..."
      },
      {
        "msgID": "DVLTKMES_00A_L0016",
        "msgStr": "Harika bir de-hee-dektifim, ho!"
      },
      {
        "msgID": "DVLTKMES_00A_L0017",
        "msgStr": "B-Başım belada mı, ho...?"
      },
      {
        "msgID": "DVLTKMES_00A_L0018",
        "msgStr": "Yine karşılaştık-ho, hee ho!"
      },
      {
        "msgID": "DVLTKMES_00A_L0019",
        "msgStr": "Eh, mecbur kalırsam yaparım, ho..."
      },
      {
        "msgID": "DVLTKMES_00A_L0020",
        "msgStr": "Sanırım hee-öyle, ho."
      },
      {
        "msgID": "DVLTKMES_00A_L0021",
        "msgStr": "Aynen de-hee-vam edelim, ho!"
      },
      {
        "msgID": "DVLTKMES_00A_L0022",
        "msgStr": "Sonra gö-hee-rüşürüz, ho!"
      },
      {
        "msgID": "DVLTKMES_00A_L0023",
        "msgStr": "Yüklen-ho, Raidou!"
      },
      {
        "msgID": "DVLTKMES_00A_L0024",
        "msgStr": "Raidou, iyi misin-ho, hee ho?"
      },
      {
        "msgID": "DVLTKMES_00A_L0025",
        "msgStr": "Pon, ho."
      },
      {
        "msgID": "DVLTKMES_00A_L0026",
        "msgStr": "Chii-ho!"
      },
      {
        "msgID": "DVLTKMES_00A_L0027",
        "msgStr": "Bu bir kan, ho."
      },
      {
        "msgID": "DVLTKMES_00A_L0028",
        "msgStr": "Riichi-ho!"
      },
      {
        "msgID": "DVLTKMES_00A_L0029",
        "msgStr": "Ron, ho!"
      },
      {
        "msgID": "DVLTKMES_00A_L0030",
        "msgStr": "MAG'ları sökül ba-ho-kalım, hee ho!"
      },
      {
        "msgID": "DVLTKMES_00A_L0031",
        "msgStr": "Raidou!"
      },
      {
        "msgID": "DVLTKMES_00A_L0032",
        "msgStr": "Hadi hee-gidelim!"
      },
      {
        "msgID": "DVLTKMES_00A_L0033",
        "msgStr": "Onlara gününü hee-göstereceğiz, ho!"
      },
      {
        "msgID": "DVLTKMES_00A_L0034",
        "msgStr": "ER100"
      },
      {
        "msgID": "DVLTKMES_00A_L0035",
        "msgStr": "Ruh Gücün beni çok etkiledi, ho."
      },
      {
        "msgID": "DVLTKMES_00A_L0036",
        "msgStr": "Bu yüzden senin müttefikin ola-ho-cağım, ho!"
      },
      {
        "msgID": "DVLTKMES_00A_L0037",
        "msgStr": "Peki, sanırım hizmetkârım ola-ho-bilirsin, ho."
      },
      {
        "msgID": "DVLTKMES_00A_L0038",
        "msgStr": "Ne ina-hee-nılmaz bir güç, ho!"
      },
      {
        "msgID": "DVLTKMES_00A_L0039",
        "msgStr": "O tüp gökteki yıldızları da içine çekebilir mi, ho?"
      },
      {
        "msgID": "DVLTKMES_00A_L0040",
        "msgStr": "Öyle olursa dünya hee-kararır mı, ho...?"
      },
      {
        "msgID": "DVLTKMES_00A_L0041",
        "msgStr": "ER100"
      },
      {
        "msgID": "DVLTKMES_00A_L0042",
        "msgStr": "ER100"
      },
      {
        "msgID": "DVLTKMES_00A_L0043",
