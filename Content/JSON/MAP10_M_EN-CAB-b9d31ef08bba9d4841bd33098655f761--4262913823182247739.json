      {
        "msgID": "map10_m_m_gouto01_047",
        "msgStr": "Gouto"
      },
      {
        "msgID": "MAP10_M_L0071",
        "msgStr": "Bir duvar... Pek de ince düşünülmüş bir savunma değil, öyle değil mi?"
