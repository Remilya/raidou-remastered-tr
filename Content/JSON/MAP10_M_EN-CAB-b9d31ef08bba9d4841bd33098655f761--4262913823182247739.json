      {
        "msgID": "MAP10_M_L0047",
        "msgStr": "> Birkaç petrol varili merdivenleri kapatıyor."
      },
      {
        "msgID": "map10_m_m_Zombie01_01_034",
        "msgStr": "Ses"
      },
      {
        "msgID": "MAP10_M_L0048",
        "msgStr": "Hey! Kim var orada?"
      },
      {
        "msgID": "map10_m_m_Zombie01_02_035",
        "msgStr": "Gouto"
      },
      {
        "msgID": "MAP10_M_L0049",
        "msgStr": "Hıh, şimdiden fark edildik bile!"
      },
      {
        "msgID": "map10_m_m_Zombie01_03_036",
        "msgStr": "Zombi Muhafız 1"
      },
      {
        "msgID": "MAP10_M_L0050",
        "msgStr": "Sen şu İblis Çağırıcısı, Raidou Kuzunoha'sın!"
      },
      {
        "msgID": "MAP10_M_L0051",
        "msgStr": "Burayı bulabilmene şaşırdım. İyi iş çıkardın dedektif."
      },
      {
        "msgID": "MAP10_M_L0052",
        "msgStr": "Burası Ordu'nun <COLOR 1>yeraltı tersanesi<COLOR 0>."
      },
      {
        "msgID": "MAP10_M_L0053",
        "msgStr": "Burada, <COLOR 1>Tümgeneral Munakata<COLOR 0> o <COLOR 1>ele geçirilmiş kızı<COLOR 0> büyük planında kullanacak!"
      },
      {
        "msgID": "MAP10_M_L0054",
        "msgStr": "Bizi durdurmak için yapabileceğin hiçbir şey yok! Bundan emin olacağız!"
      },
      {
        "msgID": "map10_m_m_Zombie01_04_037",
        "msgStr": "Zombi Muhafız 2"
      },
      {
        "msgID": "MAP10_M_L0055",
        "msgStr": "Efendim, araya girecek olursam... Bu Çağırıcı güçlü. Yeniden toparlanmak isteyebiliriz."
      },
      {
        "msgID": "map10_m_m_Zombie01_05_038",
        "msgStr": "Zombi Muhafız 3"
      },
      {
        "msgID": "MAP10_M_L0056",
        "msgStr": "Ne dedin sen az önce?"
      },
      {
        "msgID": "map10_m_m_Zombie01_06_039",
        "msgStr": "Zombi Muhafız 3"
      },
      {
        "msgID": "MAP10_M_L0057",
        "msgStr": "Ahmak! Düşmanın karşısında sinmeyeceğiz!"
      },
      {
        "msgID": "map10_m_m_Zombie01_07_040",
        "msgStr": "Zombi Muhafız 1"
      },
      {
        "msgID": "MAP10_M_L0058",
        "msgStr": "......"
      },
      {
        "msgID": "MAP10_M_L0059",
        "msgStr": "Şansın yaver gitti, İblis Çağırıcısı Raidou Kuzunoha!"
      },
      {
        "msgID": "MAP10_M_L0060",
        "msgStr": "Birinci önceliğimizin Tümgeneral'e rapor vermek olduğunu... şimdi hatırladım."
      },
      {
        "msgID": "map10_m_m_Zombie01_08_041",
        "msgStr": "Zombi Muhafız 3"
      },
      {
        "msgID": "MAP10_M_L0061",
        "msgStr": "Müdahale etmemize gerek yok. Zaten alt katlara asla ulaşamayacaksın!"
      },
      {
        "msgID": "map10_m_m_Zombie01_09_042",
        "msgStr": "Zombi Muhafız 2"
      },
      {
        "msgID": "MAP10_M_L0062",
        "msgStr": "Taktiksel geri çekilme! Kaçmıyoruz!"
      },
      {
        "msgID": "map10_m_m_Zombie01_10_043",
        "msgStr": "NULL"
      },
      {
        "msgID": "MAP10_M_L0063",
        "msgStr": "> Zombi Muhafızlar kaçtı."
      },
      {
        "msgID": "map10_m_m_Zombie01_11_044",
        "msgStr": "Gouto"
      },
      {
        "msgID": "MAP10_M_L0064",
        "msgStr": "Eh, gözlerini bayağı korkutmuş olmalısın."
      },
      {
        "msgID": "MAP10_M_L0065",
        "msgStr": "Giderek büyüyen şöhretinin kesin kanıtlarını görmek güzel."
      },
      {
        "msgID": "MAP10_M_L0066",
        "msgStr": "Her şeye rağmen, güvenlik eksikliği karşısında endişelenmeli miyim yoksa hayal kırıklığına mı uğramalıyım bilmiyorum..."
