      },
      {
        "msgID": "MAP25_M_L0019",
        "msgStr": "Toprak Prizması'nın muhafızını uyandırmak için kutsal taşların bağladığı gücü serbest bırak."
      },
      {
        "msgID": "MAP25_M_L0020",
        "msgStr": "Tüm <COLOR 1>kutsal taşları<COLOR 0> aynı anda tınlatmalısın."
      },
      {
        "msgID": "MAP25_M_L0021",
