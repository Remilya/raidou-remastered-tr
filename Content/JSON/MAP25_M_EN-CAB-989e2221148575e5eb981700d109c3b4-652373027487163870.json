      },
      {
        "msgID": "MAP25_M_L0121",
        "msgStr": "Beni mi çağırdın?"
      },
      {
        "msgID": "map25_m_m_kami01_02_069",
        "msgStr": "Gouto"
      },
      {
        "msgID": "MAP25_M_L0122",
        "msgStr": "Ne... Sen de kimsin?"
      },
      {
        "msgID": "map25_m_m_kami02_070",
        "msgStr": "???"
      },
      {
        "msgID": "MAP25_M_L0123",
        "msgStr": "Vay canına, kedi konuşabiliyor mu!?"
      },
      {
        "msgID": "MAP25_M_L0124",
        "msgStr": "Öhöm. Şey, evet, yani ben bir haya..."
      },
      {
        "msgID": "MAP25_M_L0125",
        "msgStr": "Bir tanrı! Evet, tanrı! Öyle dedim ya!"
      },
      {
        "msgID": "map25_m_m_kami03_071",
        "msgStr": "Tanrı?"
      },
      {
        "msgID": "MAP25_M_L0126",
        "msgStr": "Minnettarlığımı sunmama izin ver..."
      },
      {
        "msgID": "MAP25_M_L0127",
        "msgStr": "Öhöm... Teşekkür ederim!"
      },
      {
        "msgID": "map25_m_m_kami_ITEMGET_072",
        "msgStr": "NULL"
      },
      {
        "msgID": "MAP25_M_L0128",
        "msgStr": "> Sözde tanrı bir şey düşürdü."
      },
      {
        "msgID": "map25_m_m_kami_ITEMGET02_073",
        "msgStr": "NULL"
      },
      {
        "msgID": "MAP25_M_L0129",
        "msgStr": "> Raidou, <ITM_08><COLOR 4>Kas İçeceği<COLOR 0> x1 elde etti."
      },
      {
        "msgID": "map25_m_m_kami04_074",
        "msgStr": "???"
      },
      {
        "msgID": "MAP25_M_L0130",
        "msgStr": "Bir tanrı! Evet, tanrı! Öyle dedim ya!"
      },
      {
        "msgID": "map25_m_m_kami05_075",
        "msgStr": "Tanrı?"
      },
      {
        "msgID": "MAP25_M_L0131",
        "msgStr": "Ne? İpucu mu arıyorsun?"
      },
      {
        "msgID": "map25_m_m_kami06_076",
        "msgStr": "Tanrı?"
      },
      {
        "msgID": "MAP25_M_L0132",
        "msgStr": "Eh, önce biraz pamuk eller cebe lütfen."
      },
      {
        "msgID": "map25_m_m_kami07_077",
        "msgStr": "Tanrı?"
      },
      {
        "msgID": "MAP25_M_L0133",
        "msgStr": "Pekâlâ, sana söyleyeceğim."
      },
      {
        "msgID": "map25_m_m_kami08_078",
        "msgStr": "Tanrı?"
      },
      {
        "msgID": "MAP25_M_L0134",
        "msgStr": "Tek yapman gereken soldaki ikisini ve sağdaki birini tınlatmak. Çaktın mı köfteyi?"
      },
      {
        "msgID": "map25_m_m_kami09_079",
        "msgStr": "Tanrı?"
      },
      {
        "msgID": "MAP25_M_L0135",
        "msgStr": "Ne!? <IT_S>Bir ipucu daha<IT_E> mı istiyorsun!? İpuçlarını bayağı seviyorsun galiba, ha?"
      },
      {
        "msgID": "map25_m_m_kami10_080",
        "msgStr": "Tanrı?"
      },
      {
        "msgID": "MAP25_M_L0136",
        "msgStr": "Tamam, bak şimdi solda üç tane kutsal taş var, gördün mü? İşte oradan başla."
      },
      {
        "msgID": "MAP25_M_L0137",
        "msgStr": "Gerisi çocuk oyuncağı."
