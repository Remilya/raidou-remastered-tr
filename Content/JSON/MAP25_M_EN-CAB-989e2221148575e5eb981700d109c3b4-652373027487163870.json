      {
        "msgID": "map25_m_m_Devil_B01_036",
        "msgStr": "Naga Raja"
      },
      {
        "msgID": "MAP25_M_L0060",
        "msgStr": "Şu radyo kulesinin hali ne öyle?"
      },
      {
        "msgID": "MAP25_M_L0061",
        "msgStr": "Bayağı tehlikeli görünüyor, di mi? Hiç yönetmeliğe uygun olduğunu sanmıyorum."
      },
      {
        "msgID": "map25_m_m_Devil_B02_037",
        "msgStr": "Naga Raja"
      },
      {
        "msgID": "MAP25_M_L0062",
        "msgStr": "Şu radyo kulesi tam bir güzellik abidesi değil mi?"
      },
      {
        "msgID": "MAP25_M_L0063",
        "msgStr": "En iyi yöntem hep en basit olandır dostum. Böyle bir şeyi süsleyip püslemeye hiç gerek yok."
      },
      {
        "msgID": "map25_m_m_Devil_B03_038",
        "msgStr": "Naga Raja"
      },
      {
        "msgID": "MAP25_M_L0064",
        "msgStr": "Ne? Radyo kulesinin görünüşü mü?"
      },
      {
        "msgID": "MAP25_M_L0065",
        "msgStr": "Kafayı mı üşüttün sen? Ben onda en ufak bir tuhaflık bile görmüyorum."
      },
      {
        "msgID": "map25_m_m_Devil_C01_039",
        "msgStr": "Kurama Tengu"
      },
      {
        "msgID": "MAP25_M_L0066",
        "msgStr": "Bir sürü tuhaf yaratık ileri geri kıvranıp duruyor. Başlarında bir insan var gibi görünüyor."
      },
      {
        "msgID": "MAP25_M_L0067",
        "msgStr": "Eh, bildiklerini okuyacaklardır. Bir insanın sınırlarını kestirmek zor değildir."
      },
      {
        "msgID": "map25_m_m_Devil_C02_040",
        "msgStr": "Kurama Tengu"
      },
      {
        "msgID": "MAP25_M_L0068",
        "msgStr": "Radyo kulesinin şeklini bozan insan şu tarafta ortalığı birbirine katıyor."
      },
      {
        "msgID": "MAP25_M_L0069",
        "msgStr": "Eh, yumurta kapıya dayanınca elden ne gelir."
      },
      {
        "msgID": "MAP25_M_L0070",
        "msgStr": "Böylesi patlayıcılar ve yanıcı maddeler gerektirenler de dahil olmak üzere, insan çabalarının ölçeği..."
      },
      {
        "msgID": "MAP25_M_L0071",
        "msgStr": "Bizim hayatlarımızın fırtınasında tek bir yağmur damlasından ibarettir."
      },
      {
        "msgID": "map25_m_m_Devil_C03_01_041",
        "msgStr": "Kurama Tengu"
      },
      {
        "msgID": "MAP25_M_L0072",
        "msgStr": "İnsan dünyası son zamanlarda hızlı bir değişimden geçti."
      },
      {
        "msgID": "MAP25_M_L0073",
        "msgStr": "Yeni toplum, güçsüzlerin hayatta kalacak kadar hızlı uyum sağlayamadığı bir yer."
      },
      {
        "msgID": "MAP25_M_L0074",
        "msgStr": "Bu esnada insanların açgözlülüğü durmaksızın büyümeye devam ediyor ve birbirleriyle olan çatışmalarını körüklüyor."
      },
      {
        "msgID": "MAP25_M_L0075",
        "msgStr": "Toplum ilerleyebilir; ancak insanlık da ona ayak uydurmazsa, bulunduğu o sefil konumun üzerine asla çıkamayacaktır."
      },
      {
        "msgID": "map25_m_m_Devil_D01_042",
        "msgStr": "Jubokko"
      },
      {
        "msgID": "MAP25_M_L0076",
        "msgStr": "Hissediyor musun ufaklık? Şuradaki yaratıklar negatif dalgalar yayıyor."
      },
      {
        "msgID": "MAP25_M_L0077",
        "msgStr": "Hüzün... Melankoli... Umutsuzluk..."
      },
      {
        "msgID": "MAP25_M_L0078",
        "msgStr": "O kuleden her türlü negatif enerji oluk oluk akıyor ve ardı arkası kesilmiyor."
      },
      {
        "msgID": "map25_m_m_Devil_D02_043",
        "msgStr": "Jubokko"
      },
      {
        "msgID": "MAP25_M_L0079",
        "msgStr": "O kahrolası yaratıklar gitti ama öylece buharlaşıp uçmuş olamazlar. Asla efendim."
      },
      {
        "msgID": "MAP25_M_L0080",
        "msgStr": "Nereye gitmiş olabileceklerini veya hâlâ neler karıştırabileceklerini düşünmek bile tüylerimi diken diken ediyor."
      },
      {
        "msgID": "MAP25_M_L0081",
        "msgStr": "İnsanların karması hiç de bakılacak gibi bir şey değildir."
      },
      {
        "msgID": "map25_m_m_Devil_D03_044",
        "msgStr": "Jubokko"
      },
      {
        "msgID": "MAP25_M_L0082",
        "msgStr": "Hissediyor musun ufaklık? Negatif dalgalar birikmeye başlıyor."
      },
      {
        "msgID": "MAP25_M_L0083",
        "msgStr": "Umarım dışarıda hiçbir kimse veya hiçbir şey o enerjiyi kullanmayı planlamıyordur."
      },
      {
        "msgID": "MAP25_M_L0084",
        "msgStr": "İnsanların karması hiç de bakılacak gibi bir şey değildir."
      },
      {
        "msgID": "map25_m_m_Zizou01_01_045",
        "msgStr": "Jizo"
      },
      {
        "msgID": "MAP25_M_L0085",
        "msgStr": "Ah, ağrıyan omuzlarım! Hepsi şu radyo kulesinin suçu."
      },
      {
        "msgID": "MAP25_M_L0086",
        "msgStr": "O lanet Hiruko'lar radyo dalgalarını zehirliyor."
      },
      {
        "msgID": "MAP25_M_L0087",
        "msgStr": "Omuzlarım zaten tutulmuştu, bu da tuz biber ekti! Kaya gibi sertleştiler!"
      },
      {
        "msgID": "map25_m_m_Zizou01_02_046",
        "msgStr": "Jizo"
      },
      {
        "msgID": "MAP25_M_L0088",
        "msgStr": "Hey, sen! Bana bir iyilik yapar mısın?"
      },
      {
        "msgID": "MAP25_M_L0089",
        "msgStr": "Şu Hiruko'ların hepsini başımdan defet! Buralarda o kadar çoklar ki neredeyse kıpırdayamıyorum!"
      },
      {
        "msgID": "MAP25_M_L0090",
        "msgStr": "Al gülüm ver gülüm, değil mi?"
      },
      {
        "msgID": "MAP25_M_L0091",
        "msgStr": "Harika! Anlayacağını biliyordum."
      },
      {
        "msgID": "MAP25_M_L0092",
        "msgStr": "Sana güveniyorum!"
      },
      {
        "msgID": "map25_m_m_Zizou01_03_047",
        "msgStr": "NULL"
      },
      {
        "msgID": "MAP25_M_L0093",
        "msgStr": "> Jizo sanki konuşmuş gibiydi..."
      },
      {
        "msgID": "map25_m_m_Zizou02_01_048",
        "msgStr": "NULL"
      },
      {
        "msgID": "MAP25_M_L0094",
        "msgStr": "> ......"
      },
      {
        "msgID": "MAP25_M_L0095",
        "msgStr": "> Sessizce duran bir Jizo heykeli."
      },
      {
        "msgID": "map25_m_m_Zizou02_02_049",
        "msgStr": "Jizo"
      },
      {
        "msgID": "MAP25_M_L0096",
        "msgStr": "Of, omuzlarım ağrıyor."
      },
      {
        "msgID": "map25_m_m_Zizou03_01_050",
        "msgStr": "Jizo"
      },
      {
        "msgID": "MAP25_M_L0097",
        "msgStr": "Hey, sensin! İyi iş çıkardın!"
      },
      {
        "msgID": "MAP25_M_L0098",
        "msgStr": "Şu omuzlara bir bak! Yumuşacık oldular, değil mi? Ha?"
      },
      {
        "msgID": "MAP25_M_L0099",
        "msgStr": "Minnetimin bir göstergesi olarak bunu kabul et."
      },
      {
        "msgID": "map25_m_m_Zizou03_02_051",
        "msgStr": "NULL"
      },
      {
        "msgID": "MAP25_M_L0100",
        "msgStr": "> Raidou, <ITM_08><COLOR 4>Çakra Damlası<COLOR 0> x1 elde etti."
      },
      {
        "msgID": "map25_m_m_Zizou03_03_052",
        "msgStr": "Jizo"
      },
      {
        "msgID": "MAP25_M_L0101",
        "msgStr": "Üzerine pozitif radyo dalgaları yağsın ve harika bir ömrün olsun dostum."
      },
