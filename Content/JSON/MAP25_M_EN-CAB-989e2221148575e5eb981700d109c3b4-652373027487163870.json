      },
      {
        "msgID": "map25_m_m_TERA02_058",
        "msgStr": "NULL"
      },
      {
        "msgID": "MAP25_M_L0111",
        "msgStr": "> Raidou, Başkent'in huzuru için dua etti."
      },
      {
        "msgID": "map25_m_m_TERA03_059",
        "msgStr": "NULL"
      },
      {
        "msgID": "MAP25_M_L0112",
        "msgStr": "> Raidou, Kaya'nın güvenliği için dua etti."
      },
      {
        "msgID": "map25_m_m_TERA04_060",
        "msgStr": "NULL"
      },
      {
        "msgID": "MAP25_M_L0113",
        "msgStr": "> Raidou, Narumi'nin daha fazla borca batmaması için dua etti."
      },
      {
        "msgID": "map25_m_m_TERA05_061",
        "msgStr": "NULL"
      },
      {
        "msgID": "MAP25_M_L0114",
        "msgStr": "> Raidou hayali için dua etti."
      },
      {
        "msgID": "map25_m_m_TERA06_062",
        "msgStr": "NULL"
      },
      {
        "msgID": "MAP25_M_L0115",
        "msgStr": "> Raidou büyük bir İblis Çağırıcısı olmaya ant içti."
      },
      {
        "msgID": "map25_m_m_TERA07_063",
        "msgStr": "NULL"
      },
      {
        "msgID": "MAP25_M_L0116",
        "msgStr": "> Raidou insanların huzuru için dua etti."
      },
      {
        "msgID": "map25_m_m_TERA08_064",
        "msgStr": "NULL"
      },
      {
        "msgID": "MAP25_M_L0117",
        "msgStr": "> Raidou şapkasının başında sağlam durması için dua etti."
      },
      {
        "msgID": "map25_m_m_TERA09_065",
        "msgStr": "NULL"
      },
      {
        "msgID": "MAP25_M_L0118",
        "msgStr": "> Raidou daha iyi bir insan olmak için dua etti."
      },
      {
        "msgID": "map25_m_m_TERA10_066",
        "msgStr": "NULL"
      },
      {
        "msgID": "MAP25_M_L0119",
        "msgStr": "> Raidou insanların mutluluğu için dua etti."
      },
      {
        "msgID": "map25_m_m_TERA_NO_067",
        "msgStr": "NULL"
      },
      {
        "msgID": "MAP25_M_L0120",
        "msgStr": "> Raidou adak bırakmamaya karar verdi."
