        "msgStr": "Ah, bir <COLOR 1>Ejderha Yükseltisi<COLOR 0>. Bu bariyerler Karanlık Diyar'da doğal olarak oluşur."
      },
      {
        "msgID": "MAP21_M_L0106",
        "msgStr": "<COLOR 3>Ne insanlar ne de iblisler içlerinden geçebilir<COLOR 0>. Başka bir yol bulmamız gerekecek."
      },
      {
        "msgID": "MAP21_M_L0107",
        "msgStr": "ER100"
      },
      {
        "msgID": "map21_m_M_EP01MES_DANSOU02_03_065",
        "msgStr": "Gouto"
      },
      {
        "msgID": "MAP21_M_L0108",
        "msgStr": "Hm, bir Ejderha Yükseltisi daha..."
      },
      {
        "msgID": "MAP21_M_L0109",
        "msgStr": "Başka bir yol bulalım, Raidou."
      },
      {
        "msgID": "map21_m_M_EP01MES_TUISEKI01_066",
        "msgStr": "ER100"
      },
      {
        "msgID": "MAP21_M_L0110",
