        "msgStr": "ER100"
      },
      {
        "msgID": "map21_m_m_msg_ep1_npc_ink01_069",
        "msgStr": "Incubus"
      },
      {
        "msgID": "MAP21_M_L0117",
        "msgStr": "Hey, şuradaki çok güzel bir hanımefendi."
      },
      {
        "msgID": "map21_m_m_msg_ep1_npc_ink02_070",
        "msgStr": "Incubus"
      },
      {
        "msgID": "MAP21_M_L0118",
        "msgStr": "Bu kadar güzel bir hanımefendi gördüğünde ne demen gerektiğini biliyorum."
      },
      {
        "msgID": "map21_m_m_msg_ep1_npc_ink03_071",
        "msgStr": "Incubus"
      },
      {
        "msgID": "MAP21_M_L0119",
        "msgStr": "\"Vay anasını be.\""
      },
      {
        "msgID": "map21_m_m_msg_ep1_npc_ink04_072",
        "msgStr": "Incubus"
      },
      {
        "msgID": "MAP21_M_L0120",
        "msgStr": "Artık <IT_S>sen<IT_E> de biliyorsun!"
      },
      {
        "msgID": "map21_m_m_msg_ep1_npc_ink04_02_073",
        "msgStr": "Incubus"
      },
      {
        "msgID": "MAP21_M_L0121",
        "msgStr": "Gerçekten çok havalı biri."
      },
      {
        "msgID": "MAP21_M_L0122",
        "msgStr": "Ufaları iyileştirebiliyor."
      },
      {
        "msgID": "map21_m_m_msg_ep1_npc_ink04_03_074",
        "msgStr": "Incubus"
      },
      {
        "msgID": "MAP21_M_L0123",
        "msgStr": "Üstelik bunu bedavaya yapacağını söylüyor!"
      },
      {
        "msgID": "MAP21_M_L0124",
        "msgStr": "Hatta MAG'ını bile dolduruyor!"
      },
      {
        "msgID": "map21_m_m_msg_ep1_npc_ink05_075",
        "msgStr": "Incubus"
      },
      {
        "msgID": "MAP21_M_L0125",
        "msgStr": "Şu merdivenlerin ilerisinde çok ama çok kötü bir <COLOR 3>Tsuchigumo<COLOR 0> var. Bir kızı kaçırdı!"
      },
      {
        "msgID": "map21_m_m_msg_ep1_npc_ink06_076",
        "msgStr": "Incubus"
      },
      {
        "msgID": "MAP21_M_L0126",
        "msgStr": "Ben sadece bir çocuğum. Asla öyle kötü bir şey yapmam."
      },
      {
        "msgID": "map21_m_m_msg_ep1_npc_rantan_01_077",
        "msgStr": "Jack-o'-Lantern"
      },
      {
        "msgID": "MAP21_M_L0127",
        "msgStr": "Hee ho!"
      },
      {
        "msgID": "MAP21_M_L0128",
        "msgStr": "Ha? Sen bir hee-insansın, ho!"
      },
      {
        "msgID": "MAP21_M_L0129",
        "msgStr": "Doğru."
      },
      {
        "msgID": "MAP21_M_L0130",
        "msgStr": "......"
      },
      {
        "msgID": "map21_m_m_msg_ep1_npc_rantan_02_078",
        "msgStr": "Jack-o'-Lantern"
      },
      {
        "msgID": "MAP21_M_L0131",
        "msgStr": "Bili-hee-yorum!"
      },
      {
        "msgID": "MAP21_M_L0132",
        "msgStr": "Şu dişi hee-insanla arkadaş mı ol-ho-mak istiyorsun, ho?"
      },
      {
        "msgID": "map21_m_m_msg_ep1_npc_rantan_03_079",
        "msgStr": "Jack-o'-Lantern"
      },
      {
        "msgID": "MAP21_M_L0133",
        "msgStr": "Fiyuu ho!"
      },
      {
        "msgID": "map21_m_m_msg_ep1_npc_rantan_04_080",
        "msgStr": "Jack-o'-Lantern"
      },
      {
        "msgID": "MAP21_M_L0134",
        "msgStr": "Senin adına çok kötü, hee-kaşla göz arasında yem ol-ho-acak, ho."
      },
      {
        "msgID": "MAP21_M_L0135",
        "msgStr": "Hee ho! Hee ho ho!"
      },
      {
        "msgID": "map21_m_m_msg_ep1_npc_rantan_05_081",
        "msgStr": "Jack-o'-Lantern"
      },
      {
        "msgID": "MAP21_M_L0136",
        "msgStr": "Merhaba, hee ho? Evde hee-kimse var mı?"
      },
      {
        "msgID": "MAP21_M_L0137",
        "msgStr": "Çoğu insan böyle yerleri gör-ho-emez, hee ho."
      },
      {
        "msgID": "MAP21_M_L0138",
        "msgStr": "Ama sen buradasın-ho, hee-ben de öyle, ho."
      },
      {
        "msgID": "MAP21_M_L0139",
        "msgStr": "Ne kadar da tuhaf-hee, ho!"
      },
      {
        "msgID": "MAP21_M_L0140",
        "msgStr": "Karanlık Diyar hee-çok ılıman. Sıcağı severim-ho ama nem-hee-i sevmem, ho."
      },
      {
        "msgID": "map21_m_m_msg_ep1_npc_rantan_06_082",
        "msgStr": "Jack-o'-Lantern"
      },
      {
        "msgID": "MAP21_M_L0141",
        "msgStr": "Hee ho!"
      },
      {
        "msgID": "MAP21_M_L0142",
        "msgStr": "Zordaki küçük hanımı kurtardın! Hee-çok havalısın, ho!"
      },
      {
        "msgID": "MAP21_M_L0143",
        "msgStr": "Ben de senin gibi güçlü ol-ho-mak istiyorum, hee ho!"
      },
      {
        "msgID": "map21_m_m_msg_ep1_npc_rantan_07_083",
        "msgStr": "Jack-o'-Lantern"
      },
      {
        "msgID": "MAP21_M_L0144",
        "msgStr": "Arkadaşıma saklambaç oyna-ho-yacağımıza dair söz verdim, ho."
      },
      {
        "msgID": "MAP21_M_L0145",
        "msgStr": "Beni asla bul-ho-amayacağı hee-bir yer bulacağım-ho!"
      },
      {
        "msgID": "map21_m_m_msg_ep1_npc_rantan_08_084",
        "msgStr": "Jack-o'-Lantern"
      },
      {
        "msgID": "MAP21_M_L0146",
        "msgStr": "Nerede oyna-ho-yacağımıza hiç hee-karar vermedik, hee ho."
      },
      {
        "msgID": "MAP21_M_L0147",
        "msgStr": "Bildiğin hee-iyi bir yer var mı, ho?"
      },
      {
        "msgID": "map21_m_m_msg_ep1_npc_neko_01_085",
        "msgStr": "Leanan Sidhe"
      },
      {
        "msgID": "MAP21_M_L0148",
        "msgStr": "Sen çok küçüksün tatlım. Oraya asla uzanamazsın."
      },
      {
        "msgID": "map21_m_m_msg_ep1_npc_neko_02_086",
        "msgStr": "Leanan Sidhe"
      },
      {
        "msgID": "MAP21_M_L0149",
        "msgStr": "Aa, sen entelektüel tiplerden misin?"
      },
      {
        "msgID": "MAP21_M_L0150",
        "msgStr": "Hm... Hoş bir çocuğa benziyorsun ama benim ihtiyacım olan şey gerçek bir <IT_S>erkek<IT_E>."
      },
      {
        "msgID": "map21_m_m_msg_ep1_npc_neko_doku_01_087",
        "msgStr": "Leanan Sidhe"
