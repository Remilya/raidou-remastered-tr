      {
        "msgID": "DVLTKMES_000_L0002",
        "msgStr": "Bir insandan kat kat daha zekiyim!"
      },
      {
        "msgID": "DVLTKMES_000_L0003",
        "msgStr": "Harika değil miyim, Raidou?"
      },
      {
        "msgID": "DVLTKMES_000_L0004",
        "msgStr": "Çocuk oyuncağıydı."
      },
      {
        "msgID": "DVLTKMES_000_L0005",
        "msgStr": "Hı? Çığlık atmıyorlar mı?"
      },
      {
        "msgID": "DVLTKMES_000_L0006",
        "msgStr": "Raidou! Bu hiç iyi değil!"
      },
      {
        "msgID": "DVLTKMES_000_L0007",
        "msgStr": "Sonuçta ben daha çocuğum..."
      },
      {
        "msgID": "DVLTKMES_000_L0008",
        "msgStr": "Of ya, bu çok berbat!"
      },
      {
        "msgID": "DVLTKMES_000_L0009",
        "msgStr": "Yuhuu! Çok eğlenceli!"
      },
      {
        "msgID": "DVLTKMES_000_L0010",
        "msgStr": "Vay be! Kendimi büyümüş gibi hissediyorum!"
      },
      {
        "msgID": "DVLTKMES_000_L0011",
        "msgStr": "İnsanlar hiç eğlenceli değil..."
      },
      {
        "msgID": "DVLTKMES_000_L0012",
        "msgStr": "Hey, Raidou... Sen salak mısın?"
      },
      {
        "msgID": "DVLTKMES_000_L0013",
        "msgStr": "Grrr... Raidou, çok lezzetli görünüyorsun!"
      },
      {
        "msgID": "DVLTKMES_000_L0014",
        "msgStr": "Ah! Seni babama söyleyeceğim!"
      },
      {
        "msgID": "DVLTKMES_000_L0015",
        "msgStr": "Sen kötü bir arkadaşsın, Raidou!"
      },
      {
        "msgID": "DVLTKMES_000_L0016",
        "msgStr": "Dur, küçük dedektif setimi getireyim!"
      },
      {
        "msgID": "DVLTKMES_000_L0017",
        "msgStr": "Ö-Ölecek miyim...?"
      },
      {
        "msgID": "DVLTKMES_000_L0018",
        "msgStr": "Yardımıma ihtiyacın olacağını biliyordum!"
      },
      {
        "msgID": "DVLTKMES_000_L0019",
        "msgStr": "Sen benim babam değilsin!"
      },
      {
        "msgID": "DVLTKMES_000_L0020",
        "msgStr": "Çık... İstemiyorum..."
      },
      {
        "msgID": "DVLTKMES_000_L0021",
        "msgStr": "Bir daha, bir daha!"
      },
      {
        "msgID": "DVLTKMES_000_L0022",
        "msgStr": "Bay bay! Sonra yine oynayalım!"
      },
      {
        "msgID": "DVLTKMES_000_L0023",
        "msgStr": "Bam! Al bakalım!"
      },
      {
        "msgID": "DVLTKMES_000_L0024",
        "msgStr": "Çok komik görünüyorsun, Raidou!"
      },
      {
        "msgID": "DVLTKMES_000_L0025",
        "msgStr": "Ah! Pon!"
      },
      {
        "msgID": "DVLTKMES_000_L0026",
        "msgStr": "Şeeey, chii!"
      },
      {
        "msgID": "DVLTKMES_000_L0027",
        "msgStr": "Yaşasın! Kan!"
      },
      {
        "msgID": "DVLTKMES_000_L0028",
        "msgStr": "Tamamdır! Riichi!"
      },
      {
        "msgID": "DVLTKMES_000_L0029",
        "msgStr": "Oley! Ron!"
      },
      {
        "msgID": "DVLTKMES_000_L0030",
        "msgStr": "Bana biraz MAG versene!"
      },
      {
        "msgID": "DVLTKMES_000_L0031",
        "msgStr": "Raidou!"
      },
      {
        "msgID": "DVLTKMES_000_L0032",
        "msgStr": "Hadi yapalım şu işi!"
      },
      {
        "msgID": "DVLTKMES_000_L0033",
        "msgStr": "Buna tamamen hazırım!"
      },
      {
        "msgID": "DVLTKMES_000_L0034",
        "msgStr": "ER100"
      },
      {
        "msgID": "DVLTKMES_000_L0035",
        "msgStr": "O küçücük şeyin içine sığmamı mı istiyorsun!?"
      },
      {
        "msgID": "DVLTKMES_000_L0036",
        "msgStr": "Acımaz, değil mi?"
      },
      {
        "msgID": "DVLTKMES_000_L0037",
        "msgStr": "Sonsuza dek arkadaş olalım!"
      },
      {
        "msgID": "DVLTKMES_000_L0038",
        "msgStr": "Tanıştığımıza sevindim, Raidou Kuzunoha!"
      },
      {
        "msgID": "DVLTKMES_000_L0039",
        "msgStr": "Çekmeyi bırak! Beni sündürüyorsun!"
      },
      {
        "msgID": "DVLTKMES_000_L0040",
