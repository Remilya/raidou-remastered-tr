      },
      {
        "msgID": "DVLTKMES_000_L0046",
        "msgStr": "Sen kimsin ki?"
      },
      {
        "msgID": "DVLTKMES_000_L0047",
        "msgStr": "14. Raidou Kuzunoha."
      },
      {
        "msgID": "DVLTKMES_000_L0048",
        "msgStr": "<NAME 0>."
      },
      {
        "msgID": "DVLTKMES_000_L0049",
        "msgStr": "Söylemem."
      },
      {
        "msgID": "DVLTKMES_000_L0050",
        "msgStr": "Yani ne, beni bir alet gibi mi kullanacaksın?"
      },
      {
        "msgID": "DVLTKMES_000_L0051",
        "msgStr": "Aynen öyle."
      },
      {
        "msgID": "DVLTKMES_000_L0052",
        "msgStr": "Hiç de değil."
      },
      {
        "msgID": "DVLTKMES_000_L0053",
        "msgStr": "Senin için eğlenceli olabilir."
      },
      {
        "msgID": "DVLTKMES_000_L0054",
        "msgStr": "Sana katılırsam elime ne geçecek?"
      },
      {
        "msgID": "DVLTKMES_000_L0055",
        "msgStr": "Seni güçlendireceğim."
      },
      {
        "msgID": "DVLTKMES_000_L0056",
        "msgStr": "Seni çalıştıracağım."
      },
      {
        "msgID": "DVLTKMES_000_L0057",
        "msgStr": "Seni füzyon için kullanacağım."
      },
      {
        "msgID": "DVLTKMES_000_L0058",
        "msgStr": "İnsanlar ve iblisler arkadaş olabilir mi?"
      },
      {
        "msgID": "DVLTKMES_000_L0059",
        "msgStr": "Elbette olabiliriz."
      },
      {
        "msgID": "DVLTKMES_000_L0060",
        "msgStr": "Hayır, olamayız."
      },
      {
        "msgID": "DVLTKMES_000_L0061",
        "msgStr": "Arkadaştan öte olabiliriz."
      },
      {
        "msgID": "DVLTKMES_000_L0062",
        "msgStr": "Her şeyden çok istediğin şey ne?"
      },
      {
        "msgID": "DVLTKMES_000_L0063",
        "msgStr": "Sonsuz zenginlik."
      },
      {
        "msgID": "DVLTKMES_000_L0064",
        "msgStr": "Sınırsız sevgi."
      },
      {
        "msgID": "DVLTKMES_000_L0065",
        "msgStr": "Tek istediğim sensin."
      },
      {
        "msgID": "DVLTKMES_000_L0066",
        "msgStr": "En sevdiğin şey ne?"
      },
      {
        "msgID": "DVLTKMES_000_L0067",
        "msgStr": "Para."
      },
      {
        "msgID": "DVLTKMES_000_L0068",
        "msgStr": "Şefkat."
      },
      {
        "msgID": "DVLTKMES_000_L0069",
        "msgStr": "Kendim."
      },
      {
        "msgID": "DVLTKMES_000_L0070",
        "msgStr": "Off, acayip acıktım. Ne yesem acaba?"
      },
      {
        "msgID": "DVLTKMES_000_L0071",
        "msgStr": "Ramen."
      },
      {
        "msgID": "DVLTKMES_000_L0072",
