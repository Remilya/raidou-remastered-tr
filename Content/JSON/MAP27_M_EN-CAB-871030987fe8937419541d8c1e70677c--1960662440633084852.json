      },
      {
        "msgID": "MAP27_M_L0206",
        "msgStr": "8. Sayfa."
      },
      {
        "msgID": "MAP27_M_L0207",
        "msgStr": "Boş ver."
      },
      {
        "msgID": "map27_m_m_JunsaL01rej_118",
        "msgStr": "Çaylak Zombi Subay"
      },
      {
        "msgID": "MAP27_M_L0208",
        "msgStr": "ER100"
      },
      {
        "msgID": "map27_m_m_JunsaInfo01_01_119",
        "msgStr": "Kıdemli Zombi Subay"
      },
      {
        "msgID": "MAP27_M_L0209",
        "msgStr": "O sayfa bazı silahların yakınındaydı."
      },
      {
        "msgID": "map27_m_m_JunsaInfo01_02_120",
        "msgStr": "Çaylak Zombi Subay"
      },
      {
        "msgID": "MAP27_M_L0210",
        "msgStr": "Ama onlara yalnızca yetkili personel dokunabilir!"
      },
      {
        "msgID": "map27_m_m_JunsaInfo02_01_121",
        "msgStr": "Kıdemli Zombi Subay"
      },
      {
        "msgID": "MAP27_M_L0211",
        "msgStr": "Etrafına serinlik yayan, tanıdık görünümlü bir iblisin yakınındaydı."
      },
      {
        "msgID": "map27_m_m_JunsaInfo02_02_122",
        "msgStr": "Çaylak Zombi Subay"
      },
      {
        "msgID": "MAP27_M_L0212",
        "msgStr": "O insan kaçarken ona kocaayak dedi, Efendim!"
      },
      {
        "msgID": "map27_m_m_JunsaInfo03_01_123",
        "msgStr": "Kıdemli Zombi Subay"
      },
      {
        "msgID": "MAP27_M_L0213",
        "msgStr": "Şeydeydi... dikkat çekici hiçbir özelliği olmayan sıradan bir yerde."
      },
      {
        "msgID": "map27_m_m_JunsaInfo03_02_124",
        "msgStr": "Çaylak Zombi Subay"
      },
      {
        "msgID": "MAP27_M_L0214",
        "msgStr": "Onu yakınlarda, üç yol ağzında gördüm, Efendim!"
      },
      {
        "msgID": "map27_m_m_JunsaInfo04_01_125",
        "msgStr": "Kıdemli Zombi Subay"
      },
      {
        "msgID": "MAP27_M_L0215",
        "msgStr": "O sayfa büyük kapının yanında."
      },
      {
        "msgID": "map27_m_m_JunsaInfo04_02_126",
        "msgStr": "Çaylak Zombi Subay"
      },
      {
        "msgID": "MAP27_M_L0216",
        "msgStr": "O insan duvarların arasına saklanmaya çalıştı ama yine de onu fark ettim, Efendim!"
      },
      {
        "msgID": "map27_m_m_JunsaInfo05_01_127",
        "msgStr": "Çaylak Zombi Subay"
      },
      {
        "msgID": "MAP27_M_L0217",
        "msgStr": "İnsanın küçük bir deliğe sürünerek girdiğini gördüm. Daha doğrusu çalıların arasındaki bir deliğe."
      },
      {
        "msgID": "map27_m_m_JunsaInfo05_02_128",
        "msgStr": "Kıdemli Zombi Subay"
      },
      {
        "msgID": "MAP27_M_L0218",
        "msgStr": "Oraya sığabilmesine bile şaşırdım. Oraya sadece küçük iblisler girebilir sanıyordum."
      },
      {
        "msgID": "map27_m_m_JunsaInfo06_01_129",
        "msgStr": "Çaylak Zombi Subay"
      },
      {
        "msgID": "MAP27_M_L0219",
        "msgStr": "Çıkmaz bir sokakta, etrafı iyi gören bir noktada."
      },
      {
        "msgID": "map27_m_m_JunsaInfo06_02_130",
        "msgStr": "Kıdemli Zombi Subay"
      },
      {
        "msgID": "MAP27_M_L0220",
        "msgStr": "Evet, orada bir ilah heykeli vardı."
      },
      {
        "msgID": "map27_m_m_JunsaInfo07_01_131",
        "msgStr": "Çaylak Zombi Subay"
      },
      {
        "msgID": "MAP27_M_L0221",
        "msgStr": "Onu bizzat ben gördüm! Bir ağaca takılıp kalmıştı!"
      },
      {
        "msgID": "map27_m_m_JunsaInfo07_02_132",
        "msgStr": "Kıdemli Zombi Subay"
      },
      {
        "msgID": "MAP27_M_L0222",
        "msgStr": "O insan çok yetenekli bir tırmanıcıydı."
      },
      {
        "msgID": "map27_m_m_JunsaInfo08_01_133",
        "msgStr": "Çaylak Zombi Subay"
      },
      {
        "msgID": "MAP27_M_L0223",
        "msgStr": "O sayfa şeydeydi... Iıı..."
      },
      {
        "msgID": "map27_m_m_JunsaInfo08_02_134",
        "msgStr": "Kıdemli Zombi Subay"
      },
      {
        "msgID": "MAP27_M_L0224",
        "msgStr": "Sorun nedir memur? Unuttun mu yoksa?"
      },
      {
        "msgID": "map27_m_m_JunsaInfo08_03_135",
        "msgStr": "Çaylak Zombi Subay"
      },
      {
        "msgID": "MAP27_M_L0225",
        "msgStr": "Evet, Efendim! Özür dilerim, Efendim! Beynimdeki çürüme bazen unutmama yol açıyor, Efendim!"
      },
      {
        "msgID": "map27_m_m_JunsaInfo08_04_136",
        "msgStr": "Çaylak Zombi Subay"
      },
      {
        "msgID": "MAP27_M_L0226",
        "msgStr": "Keşke zihnimi <COLOR 3>uyarmanın<COLOR 0> bir yolu olsaydı... Efendim!"
      },
      {
        "msgID": "map27_m_m_JunsaInfo08_05a_137",
        "msgStr": "Çaylak Zombi Subay"
      },
      {
        "msgID": "MAP27_M_L0227",
        "msgStr": "Vay canına! Hafızamda bir kıvılcım çaktı! Şimdi her şeyi hatırlıyorum!"
      },
      {
        "msgID": "map27_m_m_JunsaInfo08_05b_138",
        "msgStr": "Çaylak Zombi Subay"
      },
      {
        "msgID": "MAP27_M_L0228",
        "msgStr": "Hey, kendimi tazelenmiş hissediyorum! Şimdi her şeyi hatırlıyorum!"
      },
      {
        "msgID": "map27_m_m_JunsaInfo08_05c_139",
        "msgStr": "Çaylak Zombi Subay"
      },
      {
        "msgID": "MAP27_M_L0229",
        "msgStr": "Vay, bu kafamdaki pası silkeledi! Şimdi her şeyi hatırlıyorum!"
      },
      {
        "msgID": "map27_m_m_JunsaInfo08_06_140",
        "msgStr": "Çaylak Zombi Subay"
      },
      {
        "msgID": "MAP27_M_L0230",
        "msgStr": "Artık net bir şekilde hatırlıyorum! Birinin bir belge çaldığını çok iyi anımsıyorum."
      },
      {
        "msgID": "map27_m_m_JunsaInfo08_07_141",
        "msgStr": "Çaylak Zombi Subay"
      },
      {
        "msgID": "MAP27_M_L0231",
        "msgStr": "Ne!? Zombi kanununun bir deri bir kemik kalmış kolundan kaçamayacak!"
      },
      {
        "msgID": "map27_m_m_JunsaInfo08_08_142",
        "msgStr": "Çaylak Zombi Subay"
      },
      {
        "msgID": "MAP27_M_L0232",
        "msgStr": "Tek gözüm hep açık olacak, Efendim!"
      },
      {
        "msgID": "map27_m_m_JunsaInfo08_09_143",
        "msgStr": "Çaylak Zombi Subay"
      },
      {
        "msgID": "MAP27_M_L0233",
        "msgStr": "O belge meslektaşlarımızdan biri tarafından çalındı!"
      },
      {
        "msgID": "MAP27_M_L0234",
        "msgStr": "Merak etmeyin, öyle ya da böyle onu dışarı çekmenin bir yolunu bulacağız."
      },
      {
        "msgID": "MAP27_M_L0235",
        "msgStr": "<COLOR 3>Birisi adliye kapısının önünde kavga çıkarmaya başlarsa kesin ortaya çıkacaktır!<COLOR 0>"
      },
      {
        "msgID": "map27_m_m_JunsaInfoCancelR_144",
        "msgStr": "Kıdemli Zombi Subay"
      },
      {
        "msgID": "MAP27_M_L0236",
        "msgStr": "Anlaşıldı."
      },
      {
        "msgID": "MAP27_M_L0237",
        "msgStr": "Unutmayın—bazı durumlarda <COLOR 3>bölgeyi sadece incelemek yeterli olmayacaktır<COLOR 0>!"
      },
      {
        "msgID": "map27_m_m_JunsaInfoCancelL_145",
        "msgStr": "Çaylak Zombi Subay"
      },
      {
        "msgID": "MAP27_M_L0238",
        "msgStr": "Evet, tamam, anlaşıldı!"
      },
      {
        "msgID": "MAP27_M_L0239",
        "msgStr": "Ama unutmayın ki bazen <COLOR 3>bölgeyi sadece incelemek yeterli olmayacaktır<COLOR 0>!"
      },
      {
        "msgID": "map27_m_m_JunsaInfoAlreadyR_146",
        "msgStr": "Kıdemli Zombi Subay"
      },
      {
        "msgID": "MAP27_M_L0240",
        "msgStr": "Hmm... Bana öyle geliyor ki o sayfayı zaten almışsınız."
      },
      {
        "msgID": "map27_m_m_JunsaInfoAlreadyL_147",
        "msgStr": "Çaylak Zombi Subay"
      },
      {
        "msgID": "MAP27_M_L0241",
        "msgStr": "Hmm... Görünüşe göre o sayfayı zaten almışsınız ama."
      },
      {
        "msgID": "map27_m_m_JunsaR02_148",
        "msgStr": "Kıdemli Zombi Subay"
      },
      {
        "msgID": "MAP27_M_L0242",
        "msgStr": "Ben zombi polis teşkilatından bir memurum. Tanıştığımıza memnun oldum."
      },
      {
        "msgID": "map27_m_m_JunsaL02_149",
        "msgStr": "Çaylak Zombi Subay"
      },
      {
        "msgID": "MAP27_M_L0243",
        "msgStr": "Efendim! Karanlık Kasumidai tamamen temiz!"
      },
      {
        "msgID": "map27_m_m_JunsaDev01_150",
        "msgStr": "Çaylak Zombi Subay"
      },
      {
        "msgID": "MAP27_M_L0244",
        "msgStr": "Buralarda yeni misiniz? Sizi daha önce gördüğümü sanmıyorum."
      },
      {
        "msgID": "map27_m_m_JunsaDev02R_151",
        "msgStr": "Kıdemli Zombi Subay"
      },
      {
        "msgID": "MAP27_M_L0245",
        "msgStr": "Bölgede yeni misiniz? Yüzünüzü pek çıkaramadım."
      },
      {
        "msgID": "map27_m_m_JunsaDev02L_152",
        "msgStr": "Çaylak Zombi Subay"
      },
      {
        "msgID": "MAP27_M_L0246",
        "msgStr": "Şu an devriyedeyiz. Her zaman ikili olarak devriye gezmeye özen gösteririz."
      },
      {
        "msgID": "map27_m_m_Common_IkaiExit01_153",
        "msgStr": "NULL"
      },
      {
        "msgID": "MAP27_M_L0247",
