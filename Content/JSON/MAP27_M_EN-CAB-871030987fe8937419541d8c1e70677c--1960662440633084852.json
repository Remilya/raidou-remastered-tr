      {
        "msgID": "map27_m_m_TsumeInfo01_084",
        "msgStr": "Jack Frost"
      },
      {
        "msgID": "MAP27_M_L0141",
        "msgStr": "Hee ho! Beni olan yaşlı bir adam saklan-hee-baç oynuyordu, ho."
      },
      {
        "msgID": "MAP27_M_L0142",
        "msgStr": "Şu evin arkasına, minik bir hee-deliğin içine, bulduğu her yere saklandı-ho!"
      },
      {
        "msgID": "MAP27_M_L0143",
        "msgStr": "Ama her seferinde yerini bul-hee-dular, ho."
      },
      {
        "msgID": "MAP27_M_L0144",
        "msgStr": "Bir yetişkine göre saklanmakta pek hee-vasat, ho. Ben çok daha hee-iyisini yapardım, ho!"
      },
      {
        "msgID": "map27_m_m_TsumeInfo02_085",
        "msgStr": "Jack Frost"
      },
      {
        "msgID": "MAP27_M_L0145",
        "msgStr": "Hee ho! Saklan-hee-baç oynayan o yaşlı adamla tanışmak istiyorum-ho, ho."
      },
      {
        "msgID": "MAP27_M_L0146",
        "msgStr": "Ona ne kadar iyi olduğumu hee-göstereceğim, ho!"
      },
      {
        "msgID": "map27_m_m_WoodInfo01_086",
        "msgStr": "Leanan Sidhe"
      },
      {
        "msgID": "MAP27_M_L0147",
        "msgStr": "Az önce aklıma geldi..."
      },
      {
        "msgID": "MAP27_M_L0148",
        "msgStr": "Elinde bir kâğıt parçasıyla ayaklarını sürüyerek dolaşan bir zombi vardı."
      },
      {
        "msgID": "MAP27_M_L0149",
        "msgStr": "Bahse girerim onu dövüşte yenersen kâğıdı onun soğuk, ölü ellerinden söküp alabilirsin."
      },
      {
        "msgID": "map27_m_m_WoodInfo02_087",
        "msgStr": "Leanan Sidhe"
      },
      {
        "msgID": "MAP27_M_L0150",
        "msgStr": "Duyduğuma göre bu bölge insan dünyasında önemli bir tesismiş."
      },
      {
        "msgID": "MAP27_M_L0151",
        "msgStr": "O insanlara karşı dikkatli olmalısın. Her zaman tehlikeli fikirler yumurtluyorlar."
      },
      {
        "msgID": "map27_m_m_WoodInfo03_088",
        "msgStr": "Leanan Sidhe"
      },
      {
        "msgID": "MAP27_M_L0152",
        "msgStr": "Bir insanın düşürdüğü kâğıt parçasını mı arıyorsun?"
      },
      {
        "msgID": "MAP27_M_L0153",
        "msgStr": "O konuda hiçbir şey bilmiyorum."
      },
      {
        "msgID": "MAP27_M_L0154",
        "msgStr": "İnsanlara bulaşmaktan asla hayır gelmez."
      },
      {
        "msgID": "map27_m_m_taihou01_089",
        "msgStr": "NULL"
      },
      {
        "msgID": "MAP27_M_L0155",
        "msgStr": "> Bu bir top."
      },
      {
        "msgID": "map27_m_m_taihou02_090",
        "msgStr": "NULL"
      },
      {
        "msgID": "MAP27_M_L0156",
        "msgStr": "> Bir Ordu topu."
      },
      {
        "msgID": "MAP27_M_L0157",
        "msgStr": "> Konumu ve açısı göz önüne alındığında savunma amaçlı olması pek olası görünmüyor."
      },
      {
        "msgID": "MAP27_M_L0158",
        "msgStr": "> Barut ve gülle çoktan doldurulmuş. Geriye sadece fitili ateşlemek kalmış."
      },
      {
        "msgID": "map27_m_m_taihou03_091",
        "msgStr": "NULL"
      },
      {
        "msgID": "MAP27_M_L0159",
        "msgStr": "> Top ateşlendi."
      },
      {
        "msgID": "map27_m_m_taihou04_092",
        "msgStr": "Askerlerin Sesleri"
      },
      {
        "msgID": "MAP27_M_L0160",
        "msgStr": "ER100"
      },
      {
        "msgID": "MAP27_M_L0161",
        "msgStr": "O ses toptan mı geldi? Öğle yemeği vakti geldi mi ki? Biraz erken değil mi?"
      },
      {
        "msgID": "MAP27_M_L0162",
        "msgStr": "Sana göre öyle. Hadi gidelim, karnım acıktı."
      },
      {
        "msgID": "MAP27_M_L0163",
        "msgStr": "Pekâlâ, vardiya değişimi vakti! Hadi yemeğe!"
      },
      {
        "msgID": "MAP27_M_L0164",
        "msgStr": "Hey, hadi radyoyu açalım! Şu spikerin sesine bayılıyorum."
      },
      {
        "msgID": "map27_m_m_taihou05_093",
        "msgStr": "NULL"
      },
      {
        "msgID": "MAP27_M_L0165",
        "msgStr": "> Askerler kandırılarak öğle yemeği molasına erken çıktılar."
      },
      {
