      },
      {
        "msgID": "MAP27_M_L0047",
        "msgStr": "Gerçekten çetin bir uğraştı... Aferin Raidou."
      },
      {
        "msgID": "MAP27_M_L0048",
        "msgStr": "Şimdi gidip şu Sadakichi denen adama bu gizli projeyi soralım."
      },
      {
        "msgID": "map27_m_m_ReportRest01_029",
        "msgStr": "Utai-Gaikotsu"
      },
      {
        "msgID": "MAP27_M_L0049",
        "msgStr": "O adamın düşürdüğü dosyaları mı topluyorsun? Valla ne angarya iş ama."
      },
      {
        "msgID": "MAP27_M_L0050",
        "msgStr": "Dur sana bir el atayım. Daha kaç tane bulman gerektiğini bilmek ister misin?"
      },
      {
        "msgID": "MAP27_M_L0051",
        "msgStr": "Bakalım şu ana kadar kaç tane bulmuşsun."
      },
      {
        "msgID": "map27_m_m_ReportRest02_00_030",
        "msgStr": "Utai-Gaikotsu"
      },
      {
        "msgID": "MAP27_M_L0052",
        "msgStr": "Hey, hepsini toplamışsın! Artık buralarda vakit kaybetmene gerek yok."
      },
      {
        "msgID": "map27_m_m_ReportRest02_01_031",
        "msgStr": "Utai-Gaikotsu"
      },
      {
        "msgID": "MAP27_M_L0053",
        "msgStr": "Vay, sadece bir tane kalmış! Eminim İraden onu bulmak için yanıp tutuşuyordur, ha?"
      },
      {
        "msgID": "map27_m_m_ReportRest02_02_032",
        "msgStr": "Utai-Gaikotsu"
      },
      {
        "msgID": "MAP27_M_L0054",
        "msgStr": "Hey, geriye iki tane kalmış. Neredeyse bitirdin, ha?"
      },
      {
        "msgID": "map27_m_m_ReportRest02_03_033",
        "msgStr": "Utai-Gaikotsu"
      },
      {
        "msgID": "MAP27_M_L0055",
        "msgStr": "Üç tane kaldı. Son düzlüğe girdin."
      },
      {
        "msgID": "map27_m_m_ReportRest02_04_034",
        "msgStr": "Utai-Gaikotsu"
      },
      {
        "msgID": "MAP27_M_L0056",
        "msgStr": "Hmm, görünüşe göre dört tane daha lazım. Yolun yarısındasın."
      },
      {
        "msgID": "map27_m_m_ReportRest02_05_035",
        "msgStr": "Utai-Gaikotsu"
      },
      {
        "msgID": "MAP27_M_L0057",
        "msgStr": "Beş tane kaldı. Bu işi bitirmek istiyorsan rehavete kapılmamalısın."
      },
      {
        "msgID": "map27_m_m_ReportRest02_06_036",
        "msgStr": "Utai-Gaikotsu"
      },
      {
        "msgID": "MAP27_M_L0058",
        "msgStr": "Altı tane kaldı. Yavaş yavaş elin alışıyor mu?"
      },
      {
        "msgID": "map27_m_m_ReportRest02_07_037",
        "msgStr": "Utai-Gaikotsu"
      },
      {
        "msgID": "MAP27_M_L0059",
        "msgStr": "Hmm, dışarıda hâlâ yedi tane daha var. Elini çabuk tutsan iyi olur."
      },
      {
        "msgID": "map27_m_m_ReportRest02_08_038",
        "msgStr": "Utai-Gaikotsu"
      },
      {
        "msgID": "MAP27_M_L0060",
        "msgStr": "Hey, elinde bir tane bile yok! Çık dışarı da avla şunları!"
      },
      {
        "msgID": "map27_m_m_ReportRest03_039",
        "msgStr": "Utai-Gaikotsu"
      },
      {
        "msgID": "MAP27_M_L0061",
        "msgStr": "Yine o raporları sormaya mı geldin? İnsanlar angarya işlere bayılıyor doğrusu..."
