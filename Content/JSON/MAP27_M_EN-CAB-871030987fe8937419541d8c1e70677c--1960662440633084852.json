      {
        "msgID": "map27_m_m_JunsaFirst01_106",
        "msgStr": "Kıdemli Zombi Subay"
      },
      {
        "msgID": "MAP27_M_L0187",
        "msgStr": "Merhaba. Biz Zombi Subaylarız. Devriyeye her zaman ikili olarak çıkarız."
      },
      {
        "msgID": "map27_m_m_JunsaFirst02_107",
        "msgStr": "Çaylak Zombi Subay"
      },
      {
        "msgID": "MAP27_M_L0188",
        "msgStr": "Anladığım kadarıyla bazı belgeler arıyorsunuz?"
      },
      {
        "msgID": "map27_m_m_JunsaFirst03_108",
        "msgStr": "Kıdemli Zombi Subay"
      },
      {
        "msgID": "MAP27_M_L0189",
        "msgStr": "Hm... Az önce buralarda koşturan bir insan vardı."
      },
      {
        "msgID": "MAP27_M_L0190",
        "msgStr": "Ve siz bahsedince hatırladım, gerçekten de birkaç kâğıt düşürmüştü."
      },
      {
        "msgID": "map27_m_m_JunsaFirst04_109",
        "msgStr": "Çaylak Zombi Subay"
      },
      {
        "msgID": "MAP27_M_L0191",
        "msgStr": "Karanlık Başkent'in vatandaşlarına yardım etmek bizim görevimizdir!"
      },
      {
        "msgID": "map27_m_m_JunsaFirst05_110",
        "msgStr": "Kıdemli Zombi Subay"
      },
      {
        "msgID": "MAP27_M_L0192",
        "msgStr": "Size elimizden gelen en iyi şekilde yardımcı olmak için bildiğimiz her şeyi anlatacağız."
      },
      {
        "msgID": "map27_m_m_JunsaFirst06_111",
        "msgStr": "Çaylak Zombi Subay"
      },
      {
        "msgID": "MAP27_M_L0193",
        "msgStr": "Yardıma ihtiyacınız olursa bize sormaktan çekinmeyin!"
      },
      {
        "msgID": "map27_m_m_JunsaFirst07_112",
        "msgStr": "Her İki Zombi Subay"
      },
      {
        "msgID": "MAP27_M_L0194",
        "msgStr": "Selam dur!"
      },
      {
        "msgID": "map27_m_m_JunsaR01_113",
        "msgStr": "Kıdemli Zombi Subay"
      },
      {
        "msgID": "MAP27_M_L0195",
        "msgStr": "Raporun hangi bölümünü arıyorsunuz?"
      },
      {
        "msgID": "map27_m_m_JunsaR01s SEL_114",
        "msgStr": "Kıdemli Zombi Subay"
      },
      {
        "msgID": "MAP27_M_L0196",
        "msgStr": "1. Sayfa."
      },
      {
        "msgID": "MAP27_M_L0197",
