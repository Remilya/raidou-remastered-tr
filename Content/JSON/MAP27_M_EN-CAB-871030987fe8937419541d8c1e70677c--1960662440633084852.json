      },
      {
        "msgID": "MAP27_M_L0199",
        "msgStr": "4. Sayfa."
      },
      {
        "msgID": "MAP27_M_L0200",
        "msgStr": "Boş ver."
      },
      {
        "msgID": "map27_m_m_JunsaR01rej_115",
        "msgStr": "Kıdemli Zombi Subay"
      },
      {
        "msgID": "MAP27_M_L0201",
        "msgStr": "ER100"
      },
      {
        "msgID": "map27_m_m_JunsaL01_116",
        "msgStr": "Çaylak Zombi Subay"
      },
      {
        "msgID": "MAP27_M_L0202",
        "msgStr": "Raporun hangi kısmını arıyorsunuz?"
      },
      {
        "msgID": "map27_m_m_JunsaL01s SEL_117",
        "msgStr": "Çaylak Zombi Subay"
      },
      {
        "msgID": "MAP27_M_L0203",
        "msgStr": "5. Sayfa."
      },
      {
        "msgID": "MAP27_M_L0204",
        "msgStr": "6. Sayfa."
      },
      {
        "msgID": "MAP27_M_L0205",
