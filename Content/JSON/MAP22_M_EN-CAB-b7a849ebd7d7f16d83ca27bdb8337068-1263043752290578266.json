      {
        "msgID": "map22_m_mplan_ep02_poru_01_02_027",
        "msgStr": "Poltergeist"
      },
      {
        "msgID": "MAP22_M_L0047",
        "msgStr": "Şimdi bunu gizemli bir şekilde hareket ettirip ödünü patlatacağım!"
      },
      {
        "msgID": "MAP22_M_L0048",
        "msgStr": "İşte başlıyorum! Önce bir gaza gelmem lazım... Bir, iki, üç... Kımılda!"
