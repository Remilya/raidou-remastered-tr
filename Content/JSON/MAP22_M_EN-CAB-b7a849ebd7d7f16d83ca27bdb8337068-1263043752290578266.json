      },
      {
        "msgID": "MAP22_M_L0010",
        "msgStr": "Peşinden git Raidou! İzi kaybettirmesine izin verme!"
      },
      {
        "msgID": "map22_m_mplan_ep02_necoikai02_008",
        "msgStr": "Gouto"
      },
      {
        "msgID": "MAP22_M_L0011",
        "msgStr": "Tüh, Oboroguruma haklıymış. Ayaklarına bayağı çabuk!"
      },
      {
        "msgID": "map22_m_mplan_ep02_necoikai03_009",
        "msgStr": "Gouto"
      },
      {
        "msgID": "MAP22_M_L0012",
        "msgStr": "Bu taraftan kaçamazsın, Kırmızı Pelerin!"
      },
      {
        "msgID": "map22_m_mplan_ep02_necoikai04_010",
        "msgStr": "Gouto"
      },
      {
        "msgID": "MAP22_M_L0013",
        "msgStr": "Bekle, Raidou."
      },
      {
        "msgID": "MAP22_M_L0014",
        "msgStr": "Bizi atlatmak için daireler çizerek koşup duruyor."
      },
      {
        "msgID": "MAP22_M_L0015",
        "msgStr": "<COLOR 3>Döngüsünü kapatabilirsek<COLOR 0> onu kıstırırız."
      },
      {
        "msgID": "MAP22_M_L0016",
        "msgStr": "Yolunu kesmenin bir çaresine bakalım."
      },
      {
        "msgID": "map22_m_mplan_ep02_necoikai05_011",
        "msgStr": "Gouto"
      },
      {
        "msgID": "MAP22_M_L0017",
        "msgStr": "Pekâlâ, yavaşlıyor. Az daha gayret edersek onu yakalayacağız."
      },
      {
        "msgID": "MAP22_M_L0018",
        "msgStr": "ER100"
      },
      {
        "msgID": "map22_m_mplan_ep02_necoikai06_012",
        "msgStr": "Gouto"
      },
      {
        "msgID": "MAP22_M_L0019",
        "msgStr": "İşte geliyor. Çıkardığı o tuhaf sese dikkat et."
      },
      {
        "msgID": "MAP22_M_L0020",
        "msgStr": "ER100"
      },
      {
        "msgID": "MAP22_M_L0021",
        "msgStr": "ER100"
      },
      {
        "msgID": "map22_m_mplan_ep02_necoikai07_013",
        "msgStr": "Gouto"
      },
      {
        "msgID": "MAP22_M_L0022",
        "msgStr": "Raidou, böyle koşmaya devam ederse onu asla yakalayamayacağız."
      },
      {
        "msgID": "MAP22_M_L0023",
        "msgStr": "Yakınlarda bir <COLOR 3>otomobil<COLOR 0> vardı. Onunla yolunu kesmeyi dene."
      },
      {
        "msgID": "MAP22_M_L0024",
        "msgStr": "Bir İblis Çağırıcısı gibi düşün."
      },
      {
        "msgID": "MAP22_M_L0025",
        "msgStr": "Burada sana ben yardım edemem ama belki iblislerin edebilir."
      },
      {
        "msgID": "map22_m_mplan_ep02_necoikai08_014",
        "msgStr": "Gouto"
      },
      {
        "msgID": "MAP22_M_L0026",
        "msgStr": "Bekle Raidou. Kırmızı Pelerin hemen ileride."
      },
      {
        "msgID": "MAP22_M_L0027",
        "msgStr": "Dövüş için tamamen hazır olduğundan emin ol."
