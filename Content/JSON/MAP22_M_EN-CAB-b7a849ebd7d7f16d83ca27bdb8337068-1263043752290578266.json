      {
        "msgID": "map22_m_mplan_ep02_poru_01_03_028",
        "msgStr": "Poltergeist"
      },
      {
        "msgID": "MAP22_M_L0049",
        "msgStr": "Şey... Sanırım bu benim için biraz fazla ağır."
      },
      {
        "msgID": "MAP22_M_L0050",
        "msgStr": "Galiba bunu sadece <COLOR 3>gerçekten güçlü bir iblis<COLOR 0> hareket ettirebilir."
      },
      {
        "msgID": "MAP22_M_L0051",
        "msgStr": "Hıh..."
