      {
        "msgID": "map22_m_mplan_ep02_poru_02_029",
        "msgStr": "Poltergeist"
      },
      {
        "msgID": "MAP22_M_L0052",
        "msgStr": "Vay be, harika!"
      },
      {
        "msgID": "MAP22_M_L0053",
        "msgStr": "Büyüyünce ben de onun kadar güçlü olmak istiyorum!"
      },
      {
        "msgID": "map22_m_mplan_ep02_poru_03_030",
        "msgStr": "Poltergeist"
      },
      {
        "msgID": "MAP22_M_L0054",
        "msgStr": "Ben Poltergeist!"
      },
      {
        "msgID": "MAP22_M_L0055",
        "msgStr": "Bir gün büyüdüğümde insanları korkutmak için bir sürü şeyi yerinden oynatacağım."
      },
      {
        "msgID": "map22_m_mplan_ep02_poru_04_031",
        "msgStr": "Poltergeist"
      },
      {
        "msgID": "MAP22_M_L0056",
        "msgStr": "Hey, sen!"
      },
      {
        "msgID": "MAP22_M_L0057",
        "msgStr": "Çekil şuradan! O otomobili ben hareket ettiriyorum!"
      },
      {
        "msgID": "MAP22_M_L0058",
        "msgStr": "Hareket ettirmek için kendine başka otomobil bul! Bu benim!"
      },
      {
        "msgID": "map22_m_mplan_ep02_poru_05_032",
        "msgStr": "Poltergeist"
      },
      {
        "msgID": "MAP22_M_L0059",
        "msgStr": "Bazen Kurisu-zaka'daki otomobiller hurdaya çevriliyor."
      },
      {
        "msgID": "MAP22_M_L0060",
        "msgStr": "Duyduğuma göre bunu Kırmızı Pelerin yapıyormuş."
      },
      {
        "msgID": "MAP22_M_L0061",
        "msgStr": "Bayağı korkutucu biri, o yüzden burada kalıp bu otomobille oynayacağım."
      },
      {
        "msgID": "map22_m_mplan_ep02_poru_06_033",
        "msgStr": "Poltergeist"
      },
      {
        "msgID": "MAP22_M_L0062",
        "msgStr": "Hey! Bu yaptığın hiç hoş değil!"
      },
      {
        "msgID": "MAP22_M_L0063",
        "msgStr": "Hıh!"
      },
      {
        "msgID": "map22_m_mplan_ep02_poru_07_034",
        "msgStr": "Poltergeist"
      },
      {
        "msgID": "MAP22_M_L0064",
        "msgStr": "Bazen Kurisu-zaka'daki otomobiller hurdaya çevriliyor."
      },
      {
        "msgID": "MAP22_M_L0065",
        "msgStr": "Duyduğuma göre bunu Kırmızı Pelerin yapıyormuş."
      },
      {
        "msgID": "MAP22_M_L0066",
        "msgStr": "Bayağı korkutucu biri, o yüzden burada kalıp bu otomobille oynayacağım."
      },
      {
        "msgID": "MAP22_M_L0067",
        "msgStr": "Of ya... Bu araba o kadar ağır ki yerinden bile oynatamıyorum."
      },
      {
        "msgID": "MAP22_M_L0068",
        "msgStr": "Hıh..."
      },
      {
        "msgID": "map22_m_mplan_ep02_poru_08_035",
        "msgStr": "Poltergeist"
      },
      {
        "msgID": "MAP22_M_L0069",
        "msgStr": "Hayıııır! Canavar!"
      },
      {
        "msgID": "MAP22_M_L0070",
        "msgStr": "Ühühü! Korkuyorum! Hayalet var!"
      },
      {
        "msgID": "map22_m_mplan_ep02_poru_09_036",
        "msgStr": "NULL"
      },
      {
        "msgID": "MAP22_M_L0071",
        "msgStr": "> Poltergeist kaçtı..."
      },
      {
        "msgID": "map22_m_mplan_ep02_ikai_exit2_037",
        "msgStr": "NULL"
      },
      {
        "msgID": "MAP22_M_L0072",
        "msgStr": "> İsimsiz Tapınak'a dönülsün mü?"
      },
      {
        "msgID": "map22_m_mplan_ep02_akuma1_01_038",
        "msgStr": "Oni"
      },
      {
        "msgID": "MAP22_M_L0073",
        "msgStr": "Kırmızı Pelerin'i görüp görmediğimi mi bilmek istiyorsun?"
      },
      {
        "msgID": "map22_m_mplan_ep02_akuma1_02_039",
        "msgStr": "Oni"
      },
      {
        "msgID": "MAP22_M_L0074",
        "msgStr": "Tabii, gördüm onu."
      },
      {
        "msgID": "MAP22_M_L0075",
        "msgStr": "Evet, şuradaki merdivenlerden çıktı. Köşeyi dön, görürsün."
      },
      {
        "msgID": "map22_m_mplan_ep02_akuma1_03_040",
        "msgStr": "Oni"
      },
      {
        "msgID": "MAP22_M_L0076",
        "msgStr": "Tabii, çene çalacak biraz vaktim var, aç kulağını dinle."
      },
      {
        "msgID": "MAP22_M_L0077",
        "msgStr": "Şuradaki merdivenlerden çıktı. Köşeyi dön, görürsün."
      },
      {
        "msgID": "map22_m_mplan_ep02_akuma1_04_041",
        "msgStr": "Oni"
      },
      {
        "msgID": "MAP22_M_L0078",
        "msgStr": "O Kırmızı Pelerin kaçtı, ha?"
      },
      {
        "msgID": "MAP22_M_L0079",
        "msgStr": "Valla bu tarafa geldiğini görmedim."
      },
      {
        "msgID": "map22_m_mplan_ep02_akuma1_05_042",
        "msgStr": "Oni"
      },
      {
        "msgID": "MAP22_M_L0080",
        "msgStr": "Bana sorarsan tramvaylar insanların en büyük icadı."
      },
      {
        "msgID": "MAP22_M_L0081",
        "msgStr": "Ben doğduğumda böyle şeyler yoktu."
      },
      {
        "msgID": "MAP22_M_L0082",
        "msgStr": "Gerçi ben doğduğumda <IT_S>insanlar<IT_E> da yoktu ya."
      },
      {
        "msgID": "map22_m_mplan_ep02_akuma1_06_043",
        "msgStr": "Oni"
      },
      {
        "msgID": "MAP22_M_L0083",
        "msgStr": "Tramvaylara binmek için Ginza-cho'ya geldim."
      },
      {
        "msgID": "MAP22_M_L0084",
        "msgStr": "Acaba iblislere ayrılmış koltukları var mıdır..."
      },
      {
        "msgID": "map22_m_mplan_ep02_akuma2_01_044",
        "msgStr": "Lamia"
      },
      {
        "msgID": "MAP22_M_L0085",
        "msgStr": "Aaa, merhaba delikanlı."
      },
      {
        "msgID": "MAP22_M_L0086",
        "msgStr": "Benden bir isteğin mi vardı?"
      },
      {
        "msgID": "MAP22_M_L0087",
        "msgStr": "Kırmızı Pelerin'i arıyorum."
      },
      {
        "msgID": "MAP22_M_L0088",
        "msgStr": "Gerçek bir güzellik arıyorum."
      },
      {
        "msgID": "MAP22_M_L0089",
        "msgStr": "Hayır, bir şey yok."
      },
      {
        "msgID": "map22_m_mplan_ep02_akuma2_02_045",
        "msgStr": "Lamia"
      },
      {
        "msgID": "MAP22_M_L0090",
        "msgStr": "Ah, evet, onu gördüm."
      },
      {
        "msgID": "MAP22_M_L0091",
        "msgStr": "Ama buralarda değil."
      },
      {
        "msgID": "MAP22_M_L0092",
        "msgStr": "Oradan oraya dolaşıp duruyordu."
      },
      {
        "msgID": "MAP22_M_L0093",
        "msgStr": "Etrafa yeterince bakınırsan eminim sonunda onu bulursun."
      },
      {
        "msgID": "map22_m_mplan_ep02_akuma2_03_046",
        "msgStr": "Lamia"
      },
      {
        "msgID": "MAP22_M_L0094",
        "msgStr": "Aman ne kadar da tatlısın! Ne terbiyeli bir delikanlı."
      },
      {
        "msgID": "MAP22_M_L0095",
        "msgStr": "Ama benim olmak istiyorsan biraz daha büyümen gerekecek."
      },
      {
        "msgID": "MAP22_M_L0096",
        "msgStr": "Merak etme... Bekleyebilirim."
      },
      {
        "msgID": "map22_m_mplan_ep02_akuma2_04_047",
        "msgStr": "Lamia"
      },
      {
        "msgID": "MAP22_M_L0097",
        "msgStr": "Ah, anlıyorum... Ne yazık."
      },
      {
        "msgID": "map22_m_mplan_ep02_akuma2_05_048",
        "msgStr": "Lamia"
      },
      {
        "msgID": "MAP22_M_L0098",
        "msgStr": "...!"
      },
      {
        "msgID": "MAP22_M_L0099",
        "msgStr": "Kırmızı Pelerin az önce buradaydı!"
      },
      {
        "msgID": "MAP22_M_L0100",
        "msgStr": "Hâlâ buralarda bir yerde olabilir... Belki..."
      },
      {
        "msgID": "map22_m_mplan_ep02_akuma2_06_049",
        "msgStr": "Lamia"
      },
      {
        "msgID": "MAP22_M_L0101",
        "msgStr": "Sanırım onu şantiyenin alt geçidinde gördüm."
      },
      {
        "msgID": "MAP22_M_L0102",
        "msgStr": "Ama o değilse kusura bakma. Seni yanlış yönlendirmek istemem."
      },
      {
        "msgID": "map22_m_mplan_ep02_akuma2_07_050",
        "msgStr": "Lamia"
      },
      {
        "msgID": "MAP22_M_L0103",
        "msgStr": "Kırmızı Pelerin'i kısa bir süre önce gördüm."
      },
      {
        "msgID": "MAP22_M_L0104",
        "msgStr": "Biliyor musun, bir canavara göre çok hüzünlü gözleri vardı..."
      },
      {
        "msgID": "MAP22_M_L0105",
        "msgStr": "Ona \"Kırmızı Pelerin\" diyorlar ama bence o kırmızı bir trajedi."
      },
      {
        "msgID": "map22_m_mplan_ep02_akuma2_08_051",
        "msgStr": "NULL"
      },
      {
        "msgID": "MAP22_M_L0106",
        "msgStr": "> İblis ilgisizce başını başka yöne çevirdi."
      },
      {
        "msgID": "map22_m_mplan_ep02_akuma2_09_052",
        "msgStr": "Lamia"
      },
      {
        "msgID": "MAP22_M_L0107",
        "msgStr": "Başkent'e yakın zamanda taşındım."
      },
