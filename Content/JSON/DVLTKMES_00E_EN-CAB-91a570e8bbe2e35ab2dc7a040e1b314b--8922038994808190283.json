      },
      {
        "msgID": "DVLTKMES_00E_L0043",
        "msgStr": "Adınızı alabilir miyim lütfen!"
      },
      {
        "msgID": "DVLTKMES_00E_L0044",
        "msgStr": "14. Raidou Kuzunoha."
      },
      {
        "msgID": "DVLTKMES_00E_L0045",
        "msgStr": "<NAME 0>."
      },
      {
        "msgID": "DVLTKMES_00E_L0046",
        "msgStr": "Söylemem."
      },
      {
        "msgID": "DVLTKMES_00E_L0047",
        "msgStr": "Demek sıradan bir insan, tanrıları ve iblisleri kendi iradesine boyun eğdirebileceğini sanıyor?"
      },
      {
        "msgID": "DVLTKMES_00E_L0048",
        "msgStr": "Doğru, istiyorum."
      },
      {
        "msgID": "DVLTKMES_00E_L0049",
        "msgStr": "Hayır, istemiyorum."
      },
      {
        "msgID": "DVLTKMES_00E_L0050",
        "msgStr": "Sandığın kadar kötü değil."
      },
      {
        "msgID": "DVLTKMES_00E_L0051",
        "msgStr": "Diyelim ki sana katıldım. Büyük planında benim rolüm ne olacak?"
      },
      {
        "msgID": "DVLTKMES_00E_L0052",
        "msgStr": "Omuz omuza savaşacağız."
      },
      {
        "msgID": "DVLTKMES_00E_L0053",
        "msgStr": "Evcil hayvanım olacaksın."
      },
      {
        "msgID": "DVLTKMES_00E_L0054",
        "msgStr": "Seni füzyon için kullanacağım."
      },
      {
        "msgID": "DVLTKMES_00E_L0055",
        "msgStr": "Seninle güçlerimi birleştirirsem—tüm ayrıntılarıyla söyle bakalım—bundan benim çıkarım ne olacak?"
      },
      {
        "msgID": "DVLTKMES_00E_L0056",
        "msgStr": "Seni güçlendireceğim."
      },
      {
        "msgID": "DVLTKMES_00E_L0057",
        "msgStr": "Seni çalıştıracağım."
      },
      {
        "msgID": "DVLTKMES_00E_L0058",
        "msgStr": "Seni füzyon için kullanacağım."
      },
      {
        "msgID": "DVLTKMES_00E_L0059",
        "msgStr": "Bazıları insanlarla iblislerin dost olabileceğine inanır. Sen ne diyorsun?"
      },
      {
        "msgID": "DVLTKMES_00E_L0060",
        "msgStr": "Elbette olabiliriz."
      },
      {
        "msgID": "DVLTKMES_00E_L0061",
        "msgStr": "Hayır, olamayız."
      },
      {
        "msgID": "DVLTKMES_00E_L0062",
        "msgStr": "Arkadaştan öte olabiliriz."
      },
      {
        "msgID": "DVLTKMES_00E_L0063",
        "msgStr": "Bir İblis Çağırıcısı her an iblislere yem olabilir. Bu seni endişelendirmiyor mu?"
      },
      {
        "msgID": "DVLTKMES_00E_L0064",
        "msgStr": "Üstesinden gelebilirim."
      },
      {
        "msgID": "DVLTKMES_00E_L0065",
        "msgStr": "Bunu istemiyorum."
      },
      {
        "msgID": "DVLTKMES_00E_L0066",
        "msgStr": "Bu hiçbir şey değil."
      },
      {
        "msgID": "DVLTKMES_00E_L0067",
        "msgStr": "Bana şunun cevabını ver dedektif: Soruşturmalarında seni yönlendiren amaç nedir?"
      },
      {
        "msgID": "DVLTKMES_00E_L0068",
        "msgStr": "Gerçek suçluları yakalamak."
      },
      {
        "msgID": "DVLTKMES_00E_L0069",
        "msgStr": "Başkent'i korumak."
      },
      {
        "msgID": "DVLTKMES_00E_L0070",
        "msgStr": "Görevimi yerine getirmek."
      },
      {
        "msgID": "DVLTKMES_00E_L0071",
        "msgStr": "İlk kez yemek üzerine bir program bölümü çekiyorum! Hangi yemeği sipariş etmeliyim?"
      },
      {
        "msgID": "DVLTKMES_00E_L0072",
        "msgStr": "Ramen."
      },
      {
        "msgID": "DVLTKMES_00E_L0073",
        "msgStr": "Hayashi pilavı."
      },
      {
        "msgID": "DVLTKMES_00E_L0074",
        "msgStr": "Şinitzel."
      },
      {
        "msgID": "DVLTKMES_00E_L0075",
        "msgStr": "İlk kez yemek üzerine bir program bölümü çekiyorum! Hangi yemeği sipariş etmeliyim?"
      },
      {
        "msgID": "DVLTKMES_00E_L0076",
        "msgStr": "Köri."
      },
      {
        "msgID": "DVLTKMES_00E_L0077",
        "msgStr": "Omletli pilav."
      },
      {
        "msgID": "DVLTKMES_00E_L0078",
        "msgStr": "Kroket."
      },
      {
        "msgID": "DVLTKMES_00E_L0079",
        "msgStr": "Ne olağanüstü bir yanıt! Zappo!"
      },
      {
        "msgID": "DVLTKMES_00E_L0080",
        "msgStr": "Tahmin ettiğim gibi, karşımızdaki sıradan bir Çağırıcı değil!"
      },
      {
        "msgID": "DVLTKMES_00E_L0081",
        "msgStr": "İşte bu millet! İstediğim cevap tam olarak buydu!"
      },
      {
        "msgID": "DVLTKMES_00E_L0082",
        "msgStr": "Zappo! Bunu anlatacak başka kelime yok! Zappo!"
      },
      {
        "msgID": "DVLTKMES_00E_L0083",
        "msgStr": "Ne nahoş bir cevap. En içten özürlerimi sunarım."
      },
      {
        "msgID": "DVLTKMES_00E_L0084",
        "msgStr": "Ahh, duymak istediğim şey bu değildi! Belki de bir şeyleri gözden kaçırıyoruz."
      },
      {
        "msgID": "DVLTKMES_00E_L0085",
        "msgStr": "Görünüşe göre küçük bir dil sürçmesi yaşadık. Zappo!"
      },
      {
        "msgID": "DVLTKMES_00E_L0086",
        "msgStr": "Süre doldu, başka soru yok! Ne büyük talihsizlik!"
      },
      {
        "msgID": "DVLTKMES_00E_L0087",
