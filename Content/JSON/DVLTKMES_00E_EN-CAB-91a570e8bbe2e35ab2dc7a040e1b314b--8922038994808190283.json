      },
      {
        "msgID": "DVLTKMES_00E_L0001",
        "msgStr": "İşte karşınızda, millet!"
      },
      {
        "msgID": "DVLTKMES_00E_L0002",
        "msgStr": "Görünüşe göre karşı taraf zorlanıyor!"
      },
      {
        "msgID": "DVLTKMES_00E_L0003",
        "msgStr": "İçimi güçlü bir coşku kaplıyor!"
      },
      {
        "msgID": "DVLTKMES_00E_L0004",
        "msgStr": "Ah, soruşturmanın verdiği o tatmin duygusu..."
      },
      {
        "msgID": "DVLTKMES_00E_L0005",
        "msgStr": "Gerçekten de soğuk ve acımasız bir dünya..."
      },
      {
        "msgID": "DVLTKMES_00E_L0006",
        "msgStr": "Daha fazla kan dökememiş olmamız ne yazık."
      },
      {
        "msgID": "DVLTKMES_00E_L0007",
        "msgStr": "Korkarım benim için yolun sonu. Zappo!"
      },
      {
        "msgID": "DVLTKMES_00E_L0008",
        "msgStr": "Belki de konuşmalıyız. Zappo..."
      },
      {
        "msgID": "DVLTKMES_00E_L0009",
        "msgStr": "Ve şimdi zafer avucumuzun içinde!"
      },
      {
        "msgID": "DVLTKMES_00E_L0010",
        "msgStr": "Şimdi onları köşeye sıkıştırdık!"
      },
      {
        "msgID": "DVLTKMES_00E_L0011",
        "msgStr": "Eyvah! Moraller düşük görünüyor!"
      },
      {
        "msgID": "DVLTKMES_00E_L0012",
        "msgStr": "Havlu atma vakti geldi! Zappo!"
      },
      {
        "msgID": "DVLTKMES_00E_L0013",
        "msgStr": "Durum tam bir deliliğe dönüştü!"
      },
      {
        "msgID": "DVLTKMES_00E_L0014",
        "msgStr": "Sanki kalbim yerinden çıkacakmış gibi atıyor!"
      },
      {
        "msgID": "DVLTKMES_00E_L0015",
        "msgStr": "Ne trajik bir gelişme..."
      },
      {
        "msgID": "DVLTKMES_00E_L0016",
        "msgStr": "Kusurlu dedektif sahneye çıkıyor!"
      },
      {
        "msgID": "DVLTKMES_00E_L0017",
        "msgStr": "Dişimi sıksam iyi olacak!"
      },
      {
        "msgID": "DVLTKMES_00E_L0018",
        "msgStr": "Bu akşam size katılmak büyük bir zevk!"
      },
      {
        "msgID": "DVLTKMES_00E_L0019",
        "msgStr": "Hm, harekete geçme emri verildi..."
      },
      {
        "msgID": "DVLTKMES_00E_L0020",
        "msgStr": "Fevkalade, Bay Raidou!"
      },
      {
        "msgID": "DVLTKMES_00E_L0021",
        "msgStr": "Bu sonumuz olabilir millet!"
      },
      {
        "msgID": "DVLTKMES_00E_L0022",
        "msgStr": "Bir dahaki sefere görüşmek üzere!"
      },
      {
        "msgID": "DVLTKMES_00E_L0023",
        "msgStr": "Dimdik ayaktayım! Zappo!"
      },
      {
        "msgID": "DVLTKMES_00E_L0024",
        "msgStr": "Bay Raidou sağlıksız bir görünüme büründü!"
      },
      {
        "msgID": "DVLTKMES_00E_L0025",
        "msgStr": "Hamlem... pon."
      },
      {
        "msgID": "DVLTKMES_00E_L0026",
