      {
        "msgID": "map09_m_m_mes_akunpc_01_064",
        "msgStr": "Azumi"
      },
      {
        "msgID": "MAP09_M_L0089",
        "msgStr": "Ah, aksi şeytan. Gözlüğümü hiçbir yerde bulamıyorum."
      },
      {
        "msgID": "MAP09_M_L0090",
        "msgStr": "Bu kahrolası geçitlerin hepsi gözüme aynı görünüyor."
      },
      {
        "msgID": "MAP09_M_L0091",
        "msgStr": "Gözlüğüm olmadan burnumun ucunu bile göremiyorum..."
      },
      {
        "msgID": "map09_m_m_mes_akunpc_02_065",
        "msgStr": "Oshichi"
      },
      {
        "msgID": "MAP09_M_L0092",
        "msgStr": "Ahh, bu kadarı da pes doğrusu! Bunca yıllık ömrümde bu kadar sinir bozucu bir şey görmedim!"
      },
      {
        "msgID": "MAP09_M_L0093",
        "msgStr": "Gittiğim her yer duvar, duvar, duvar! Bu zevksiz labirenti kim tasarladı?"
      },
      {
        "msgID": "MAP09_M_L0094",
        "msgStr": "Gerçekten! Bana sorarsan birinin terbiye edilmesi gerekiyor."
      },
      {
        "msgID": "map09_m_m_mes_akunpc_03_01_066",
        "msgStr": "Oni"
      },
      {
        "msgID": "MAP09_M_L0095",
        "msgStr": "Vay!"
      },
      {
        "msgID": "MAP09_M_L0096",
        "msgStr": "Sen sıradan bir insansın, değil mi?"
      },
      {
        "msgID": "MAP09_M_L0097",
        "msgStr": "Yok dostum, öyle demek istemedim. Az önce tuhaf kırmızı bir tipin ışık hızıyla yanımdan vızıldayarak geçtiğini gördüm de."
      },
      {
        "msgID": "MAP09_M_L0098",
        "msgStr": "Ama o kırmızı pelerini bayağı havalıydı. Bir dahaki gelişinde onu araklayacağım."
      },
      {
        "msgID": "map09_m_m_mes_akunpc_03_02_067",
        "msgStr": "Oni"
      },
      {
        "msgID": "MAP09_M_L0099",
        "msgStr": "Vay! Ha, dur... bu sadece siyah olanıymış."
      },
      {
        "msgID": "MAP09_M_L0100",
        "msgStr": "Biraz önce yanımdan koşarak geçtin ama o senin kırmızı halindi."
      },
      {
        "msgID": "MAP09_M_L0101",
        "msgStr": "Sen şey misin, nadir bulunan siyah varyant falan mı?"
      },
      {
        "msgID": "map09_m_m_mes_akunpc_03_03_068",
        "msgStr": "Oni"
      },
      {
        "msgID": "MAP09_M_L0102",
        "msgStr": "Hey, buralarda acayip havalı kırmızı bir tip gördün mü?"
      },
      {
        "msgID": "MAP09_M_L0103",
        "msgStr": "İnsan mı iblis mi bilmiyorum ama o kırmızı pelerinle felaket havalı görünüyordu."
      },
      {
        "msgID": "MAP09_M_L0104",
        "msgStr": "Gerçi ortalıktan toz oldu. Senin kankan falan mı?"
      },
      {
        "msgID": "map09_m_m_mes_akunpc_04_069",
        "msgStr": "Jack Frost"
      },
      {
        "msgID": "MAP09_M_L0105",
        "msgStr": "Hee ho..."
      },
      {
        "msgID": "MAP09_M_L0106",
        "msgStr": "Arkadaşımı gördün mü-ho, hee ho?"
      },
      {
        "msgID": "MAP09_M_L0107",
        "msgStr": "Hee-saklambaç oynuyoruz, ho. Ama arkadaşımı bulamıyorum, ho..."
      },
      {
        "msgID": "MAP09_M_L0108",
        "msgStr": "B-Bensiz hee-eve mi gittiler yoksa, hee-ho!?"
      },
      {
        "msgID": "MAP09_M_L0109",
        "msgStr": "Yalnızım, ho..."
      },
      {
        "msgID": "map09_m_m_mes_akunpc_05_070",
        "msgStr": "Jack-o'-Lantern"
      },
      {
        "msgID": "MAP09_M_L0110",
        "msgStr": "Hee ho! Hee-saklambaç, ho!"
      },
      {
        "msgID": "MAP09_M_L0111",
        "msgStr": "Dışarıdan-ho gelmediğin sürece hee-buraya ulaşamazsın, hee ho."
      },
      {
        "msgID": "MAP09_M_L0112",
        "msgStr": "Hee-burada güvendeyim, ho!"
      },
      {
        "msgID": "MAP09_M_L0113",
        "msgStr": "Ama yorulmaya başladım, ho..."
      },
      {
        "msgID": "map09_m_m_mes_tckey_get_01_071",
        "msgStr": "NULL"
      },
      {
        "msgID": "MAP09_M_L0114",
        "msgStr": "> Üç parça Raidou'nun elinde birleşmeye başladı..."
      },
      {
        "msgID": "map09_m_m_mes_tckey_get_01d_072",
        "msgStr": "ER100"
      },
      {
        "msgID": "MAP09_M_L0115",
        "msgStr": "ER100"
      },
      {
        "msgID": "map09_m_m_mes_tckey_get_02_073",
        "msgStr": "NULL"
      },
      {
        "msgID": "MAP09_M_L0116",
        "msgStr": "> Üç parça kaynaşarak kızıl bir mücevhere dönüştü."
      },
      {
        "msgID": "map09_m_m_mes_tckey_get_03_074",
        "msgStr": "ER100"
      },
      {
        "msgID": "MAP09_M_L0117",
        "msgStr": "ER100"
      },
      {
        "msgID": "map09_m_m_mes_tckey_get_04_075",
        "msgStr": "NULL"
      },
      {
        "msgID": "MAP09_M_L0118",
        "msgStr": "> Raidou, <ITM_04><COLOR 4>Kan Krizoberili<COLOR 0>'ni elde etti."
      },
      {
        "msgID": "map09_m_m_mes_tckey_get_04d_076",
        "msgStr": "ER100"
      },
      {
        "msgID": "MAP09_M_L0119",
        "msgStr": "ER100"
      },
      {
        "msgID": "map09_m_m_mes_tckey_get_05_077",
        "msgStr": "Gouto"
      },
      {
        "msgID": "MAP09_M_L0120",
        "msgStr": "Artık o mührü kırabilmemiz lazım, Raidou."
      },
      {
        "msgID": "MAP09_M_L0121",
        "msgStr": "ER100"
      },
      {
        "msgID": "map09_m_m_mes_tckey_get_06_078",
        "msgStr": "ER100"
      },
      {
        "msgID": "MAP09_M_L0122",
        "msgStr": "ER100"
      },
      {
        "msgID": "map09_m_m_mes_ep03_paiget_00_079",
        "msgStr": "NULL"
      },
      {
        "msgID": "MAP09_M_L0123",
        "msgStr": "> Yerde bir şey var. Alınsın mı?"
      },
      {
        "msgID": "map09_m_m_mes_ep03_paiget_YES_080",
        "msgStr": "NULL"
      },
      {
        "msgID": "MAP09_M_L0124",
        "msgStr": "> Raidou, <ITM_04><COLOR 4>Sayı Taşları<COLOR 0> elde etti."
      },
      {
        "msgID": "map09_m_m_mes_ep03_paiget_YES02_081",
        "msgStr": "NULL"
      },
      {
        "msgID": "MAP09_M_L0125",
        "msgStr": "> <devil 0>, <ITM_04><COLOR 4>Sayı Taşları<COLOR 0> elde etti."
      },
      {
        "msgID": "map09_m_m_mes_ep03_paiget_NO_082",
        "msgStr": "NULL"
      },
      {
        "msgID": "MAP09_M_L0126",
        "msgStr": "> Raidou onu orada bıraktı."
      },
      {
        "msgID": "map09_m_m_mes_ep03_paiget_NO_02_083",
        "msgStr": "NULL"
      },
      {
        "msgID": "MAP09_M_L0127",
        "msgStr": "> <devil 0> onu almamaya karar verdi."
      },
      {
        "msgID": "map09_m_m_mes_ep03_maekojo_00_084",
        "msgStr": "Okiku-Mushi"
      },
      {
        "msgID": "MAP09_M_L0128",
