        "msgStr": "<NAME 0>, iblis çağırmana izin verildi."
      },
      {
        "msgID": "MAP16_E_L0000_01",
        "msgStr": "Tüpe aldığın Ukobach'ı çağır ve savaşta onun yardımından faydalan."
      },
      {
        "msgID": "MAP16_E_L0001",
        "msgStr": "Gerçek sınav başlamak üzere. Herhangi bir tereddüdün var mı?"
      },
      {
        "msgID": "MAP16_E_L0002",
        "msgStr": "Öyle mi? Dürüstlüğünü takdir ediyorum. Ancak tüm korkular zamanla dinecektir."
      },
      {
        "msgID": "MAP16_E_L0003",
