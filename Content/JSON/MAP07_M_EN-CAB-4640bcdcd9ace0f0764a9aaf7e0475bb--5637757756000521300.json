      {
        "msgID": "map07_m_m_SadaInfo10_039",
        "msgStr": "NULL"
      },
      {
        "msgID": "MAP07_M_L0067",
        "msgStr": "> Ordu askerleri işlerinin başına dönerken yakınmaya devam ettiler..."
      },
      {
        "msgID": "map07_m_m_SadaInfo11_040",
        "msgStr": "Gouto"
      },
      {
        "msgID": "MAP07_M_L0068",
        "msgStr": "<COLOR 3>Yüzünde ben olan bir asker kaçağı<COLOR 0> diyorlar... Bu, Tae'nin muhbiri olabilir."
      },
      {
        "msgID": "MAP07_M_L0069",
        "msgStr": "Bunu kontrol etmeliyiz. <COLOR 3>Şu sözde nöbetçi kulübesini bir ziyaret edelim<COLOR 0>."
      },
      {
        "msgID": "map07_m_m_SadaInfoSt01_041",
        "msgStr": "Şaşkın Ordu Askeri"
      },
      {
        "msgID": "MAP07_M_L0070",
        "msgStr": "Duyduğuma göre <COLOR 3>o asker kaçağı nöbetçi kulübesinin etrafında dolanıyormuş<COLOR 0>."
      },
      {
        "msgID": "MAP07_M_L0071",
        "msgStr": "Dur bir dakika, bu nöbetçi kulübesinde görevlendirilen askerin... o asker kaçağı olduğu anlamına mı geliyor?"
      },
      {
        "msgID": "MAP07_M_L0072",
        "msgStr": "Beni olup olmadığını hatırlayamıyorum. Genelde insanların yüzüne dik dik bakmam."
      },
      {
        "msgID": "map07_m_m_don01_042",
        "msgStr": "Yakınan Ordu Askeri"
      },
      {
        "msgID": "MAP07_M_L0073",
        "msgStr": "Meiji döneminden beri o şey gümbürdeyip duruyor. Sesi hoşuma gidiyor, anlıyor musun?"
      },
      {
        "msgID": "MAP07_M_L0074",
        "msgStr": "Ama Meclis son sözü söyledi... O topun günleri sayılı. Onu gerçekten özleyeceğim."
      },
      {
        "msgID": "map07_m_m_don01ext_043",
        "msgStr": "NULL"
      },
      {
        "msgID": "MAP07_M_L0075",
        "msgStr": "> <devil 0> askeri alışılmadık bir ilgiyle izliyor."
      },
      {
        "msgID": "map07_m_m_don02_01_044",
        "msgStr": "Boşboğaz Ordu Askeri"
      },
      {
        "msgID": "MAP07_M_L0076",
        "msgStr": "Buraya gelirken o topu gördün, değil mi? Sakın dokunma."
      },
      {
        "msgID": "MAP07_M_L0077",
        "msgStr": "Acemi bir askeri öğrenci, onun <COLOR 3>nöbet değişim sinyali<COLOR 0> olduğunu bilmeden ateşledi ve onu disiplin koğuşuna tıktılar."
      },
      {
        "msgID": "MAP07_M_L0078",
        "msgStr": "O kargaşada <COLOR 3>tüm nöbetçiler görev yerlerini terk etti<COLOR 0>... Kasumidai tamamen savunmasız kaldı."
      },
      {
        "msgID": "map07_m_m_don02_02_045",
        "msgStr": "Gouto"
      },
      {
        "msgID": "MAP07_M_L0079",
        "msgStr": "Oo, bak <IT_S>bu<IT_E> gerçekten ilginçmiş..."
      },
      {
        "msgID": "MAP07_M_L0080",
        "msgStr": "<COLOR 3>Demek top nöbetçiler için bir sinyal, öyle mi?<COLOR 0> Bunu bir kenara not etsen iyi olur, Raidou."
      },
      {
        "msgID": "map07_m_m_don02ext_046",
        "msgStr": "NULL"
      },
      {
        "msgID": "MAP07_M_L0081",
        "msgStr": "> <devil 0> şeytani bir gülümsemeyle izliyor."
      },
      {
        "msgID": "map07_m_m_Hara01_047",
        "msgStr": "Övüngen Ordu Askeri"
      },
      {
        "msgID": "MAP07_M_L0082",
        "msgStr": "Umarım üzerinde hiç kibrit yoktur. Varsa el koymamız gerekecek."
      },
      {
        "msgID": "MAP07_M_L0083",
        "msgStr": "Açık bir alev <COLOR 3>topa<COLOR 0> fazla yaklaşırsa felaket olur."
      },
      {
        "msgID": "map07_m_m_Hara01ext_048",
        "msgStr": "NULL"
      },
      {
        "msgID": "MAP07_M_L0084",
        "msgStr": "> <devil 0> boş gözlerle insana bakıyor."
      },
      {
        "msgID": "map07_m_m_Radio01_049",
        "msgStr": "Telsizci Ordu Askeri"
      },
      {
        "msgID": "MAP07_M_L0085",
        "msgStr": "Hey, evlat. Radyo dinler misin?"
      },
      {
        "msgID": "map07_m_m_Radio01s SEL_050",
        "msgStr": "NULL"
      },
      {
        "msgID": "MAP07_M_L0086",
        "msgStr": "Evet."
      },
      {
        "msgID": "MAP07_M_L0087",
        "msgStr": "Hayır."
      },
      {
        "msgID": "MAP07_M_L0088",
        "msgStr": "Pek bana göre değil."
      },
      {
        "msgID": "map07_m_m_Radio01a_051",
        "msgStr": "Telsizci Ordu Askeri"
      },
      {
        "msgID": "MAP07_M_L0089",
        "msgStr": "Şahane! Ben de!"
      },
      {
        "msgID": "map07_m_m_Radio01b_052",
        "msgStr": "Telsizci Ordu Askeri"
      },
      {
        "msgID": "MAP07_M_L0090",
        "msgStr": "Aa... Ne kötü."
      },
      {
        "msgID": "map07_m_m_Radio01c_053",
        "msgStr": "Telsizci Ordu Askeri"
      },
      {
        "msgID": "MAP07_M_L0091",
        "msgStr": "Bir şans vermelisin. Bayılacağına eminim."
      },
      {
        "msgID": "map07_m_m_Radio02_054",
        "msgStr": "Telsizci Ordu Askeri"
      },
      {
        "msgID": "MAP07_M_L0092",
        "msgStr": "Radyo dinlemeye bayılırım. Elimde olsa bütün gün dinlerim."
      },
      {
        "msgID": "MAP07_M_L0093",
        "msgStr": "<COLOR 3>Öğlen nöbet değişimi<COLOR 0> çalar çalmaz doğrudan kışlaya doğru ok gibi fırlarım."
      },
      {
        "msgID": "MAP07_M_L0094",
        "msgStr": "Öğlene ne kadar kaldı...?"
