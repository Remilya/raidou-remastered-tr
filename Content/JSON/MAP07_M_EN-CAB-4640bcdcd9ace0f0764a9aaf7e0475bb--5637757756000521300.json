      },
      {
        "msgID": "MAP07_M_L0056",
        "msgStr": "> Raidou konuşan askerleri duyabiliyor."
      },
      {
        "msgID": "map07_m_m_SadaInfo01_030",
        "msgStr": "Soldaki Asker"
      },
      {
        "msgID": "MAP07_M_L0057",
        "msgStr": "Hey, şu <COLOR 3>asker kaçağını<COLOR 0> buldun mu?"
      },
      {
        "msgID": "map07_m_m_SadaInfo02_031",
        "msgStr": "Sağdaki Asker"
      },
      {
        "msgID": "MAP07_M_L0058",
        "msgStr": "<COLOR 3>Nöbetçi kulübesinin<COLOR 0> etrafında o tarife uyan bir adam olduğunu duydum..."
      },
      {
        "msgID": "map07_m_m_SadaInfo03_032",
        "msgStr": "Soldaki Asker"
      },
      {
        "msgID": "MAP07_M_L0059",
        "msgStr": "Biliyor musun, düşünüyordum da... mangamızda <COLOR 3>yüzünde ben olan bir adam<COLOR 0> var mı ki?"
      },
      {
        "msgID": "map07_m_m_SadaInfo04_033",
        "msgStr": "Sağdaki Asker"
      },
      {
        "msgID": "MAP07_M_L0060",
        "msgStr": "Bize adını veya birliğini söylemezlerse onu nasıl bulmamızı bekliyorlar?"
      },
      {
        "msgID": "map07_m_m_SadaInfo05_034",
        "msgStr": "ER100"
      },
