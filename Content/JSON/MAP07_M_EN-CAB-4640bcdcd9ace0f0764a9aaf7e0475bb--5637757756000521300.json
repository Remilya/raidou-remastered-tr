        "msgID": "map07_m_m_sys_riki_006",
        "msgStr": "NULL"
      },
      {
        "msgID": "MAP07_M_L0007",
        "msgStr": "> <devil 0> tüm gücüyle vurdu!"
      },
      {
        "msgID": "map07_m_m_Mihari01_007",
        "msgStr": "Gözcü Ordu Askeri"
      },
      {
        "msgID": "MAP07_M_L0008",
        "msgStr": "Senin gibi bir çocuğun burada işi yok. Hadi evine git."
      },
      {
        "msgID": "map07_m_m_Mihari02_008",
        "msgStr": "Gouto"
      },
      {
        "msgID": "MAP07_M_L0009",
        "msgStr": "Beklendiği gibi güvenlik sıkı. Yüzünde ben olan adamımızı bu şekilde asla bulamayız."
      },
      {
        "msgID": "MAP07_M_L0010",
        "msgStr": "Bu durumda, <COLOR 3>bu nöbetçiyi buradan uzaklaştırmanın<COLOR 0> bir yolunu düşünmeliyiz."
      },
      {
        "msgID": "MAP07_M_L0011",
        "msgStr": "Önce <COLOR 3>bölgedeki askerlerin neler söylediğine bir kulak verelim<COLOR 0>."
      },
      {
        "msgID": "map07_m_m_heisi02_009",
