        "msgID": "map07_m_m_taihou01_010",
        "msgStr": "NULL"
      },
      {
        "msgID": "MAP07_M_L0017",
        "msgStr": "> Bir top. Üzerine yapıştırılmış el yazısı bir not var."
      },
      {
        "msgID": "MAP07_M_L0018",
        "msgStr": "\"Bu top her zaman ateşlenmeye hazırdır. Yetkisiz personel: DOKUNMAYIN.\""
      },
      {
        "msgID": "MAP07_M_L0019",
        "msgStr": "\"Fitilden açık alevleri uzak tutun.\""
      },
      {
        "msgID": "map07_m_m_taihou02_011",
        "msgStr": "NULL"
      },
      {
        "msgID": "MAP07_M_L0020",
        "msgStr": "> Bir Ordu topu."
      },
      {
        "msgID": "MAP07_M_L0021",
        "msgStr": "> Konumu ve açısı göz önüne alındığında, savunma amaçlı olması pek olası görünmüyor."
      },
      {
        "msgID": "MAP07_M_L0022",
        "msgStr": "> Barut ve gülle çoktan doldurulmuş. Geriye sadece fitili ateşlemek kalmış."
      },
      {
        "msgID": "map07_m_m_taihou03_012",
        "msgStr": "NULL"
      },
      {
        "msgID": "MAP07_M_L0023",
        "msgStr": "> <devil 0> topun fitilini ateşledi!"
      },
      {
        "msgID": "map07_m_m_taihou03rej_013",
        "msgStr": "Gouto"
      },
      {
        "msgID": "MAP07_M_L0024",
        "msgStr": "Raidou, yapma."
      },
      {
        "msgID": "MAP07_M_L0025",
        "msgStr": "Cazip geldiğini biliyorum ama ne olacağı hakkında hiçbir fikrimiz yok."
      },
      {
        "msgID": "MAP07_M_L0026",
        "msgStr": "Ateşle oynamayalım. Hemen <COLOR 3>nöbetçi kulübesine<COLOR 0> gitmeliyiz."
      },
      {
        "msgID": "map07_m_m_taihou03rej2_014",
        "msgStr": "NULL"
      },
      {
        "msgID": "MAP07_M_L0027",
        "msgStr": "> Raidou alevi hızla söndürdü."
      },
      {
        "msgID": "map07_m_m_taihou04_015",
        "msgStr": "Askerlerin Sesleri"
      },
      {
        "msgID": "MAP07_M_L0028",
        "msgStr": "O ses toptan mı geldi? Saat şimdiden öğlen mi oldu?"
      },
      {
        "msgID": "MAP07_M_L0029",
        "msgStr": "Biraz erken gibi, değil mi?"
      },
      {
        "msgID": "MAP07_M_L0030",
        "msgStr": "Gerçekten mi? Çünkü ben öğle yemeğine tamamen hazırım."
      },
      {
        "msgID": "MAP07_M_L0031",
        "msgStr": "Her halükârda nöbetimiz bitti. Ben kışlaya dönüyorum."
      },
      {
        "msgID": "map07_m_m_taihou05_01_016",
        "msgStr": "Gouto"
      },
      {
        "msgID": "MAP07_M_L0032",
        "msgStr": "Bak sen şu işe, görünüşe göre top atışı o askerleri yanılttı."
      },
      {
        "msgID": "MAP07_M_L0033",
        "msgStr": "İyi düşündün, Raidou."
      },
      {
        "msgID": "MAP07_M_L0034",
        "msgStr": "Bu nöbetçiler meselesini çözecektir. <COLOR 3>Nöbetçi kulübesine gidelim ve şu benli adamımızı arayalım.<COLOR 0>"
      },
      {
        "msgID": "map07_m_m_taihou05_02_017",
        "msgStr": "Gouto"
      },
      {
        "msgID": "MAP07_M_L0035",
        "msgStr": "Görünüşe göre tam da söylendiği gibi işe yaradı."
      },
      {
        "msgID": "MAP07_M_L0036",
        "msgStr": "Bu nöbetçiler meselesini çözecektir. <COLOR 3>Nöbetçi kulübesine gidelim ve şu benli adamımızı arayalım.<COLOR 0>"
