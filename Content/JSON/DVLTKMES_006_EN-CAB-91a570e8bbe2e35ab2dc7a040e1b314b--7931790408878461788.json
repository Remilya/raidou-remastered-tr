      },
      {
        "msgID": "DVLTKMES_006_L0035",
        "msgStr": "Hop, yavaş ol evlat!"
      },
      {
        "msgID": "DVLTKMES_006_L0036",
        "msgStr": "Sana katılacağım, yeter ki şu kadar sert çekmeyi bırak!"
      },
      {
        "msgID": "DVLTKMES_006_L0037",
        "msgStr": "Oh be... Bayağı iyi geldi."
      },
      {
        "msgID": "DVLTKMES_006_L0038",
        "msgStr": "Bir dahaki sefere aynısını sırtıma da uygula evlat."
      },
      {
        "msgID": "DVLTKMES_006_L0039",
        "msgStr": "Demek yeni Raidou Kuzunoha sensin, ha?"
      },
      {
        "msgID": "DVLTKMES_006_L0040",
        "msgStr": "Eh, benden öğreneceğin bir iki şey vardır herhalde."
      },
      {
        "msgID": "DVLTKMES_006_L0041",
