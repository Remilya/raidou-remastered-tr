      {
        "msgID": "DVLTKMES_006_L0019",
        "msgStr": "Hararet yapma evlat."
      },
      {
        "msgID": "DVLTKMES_006_L0020",
        "msgStr": "Amma da dediğim dedik bir veletsin, ha?"
      },
      {
        "msgID": "DVLTKMES_006_L0021",
