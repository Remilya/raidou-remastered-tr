      {
        "msgID": "DVLTKMES_006_L0048",
        "msgStr": "ER100"
      },
      {
        "msgID": "DVLTKMES_006_L0049",
        "msgStr": "Hadi ama Çağırıcı. Önce kendini tanıtmak nezaket kuralıdır. Adın ne senin?"
      },
      {
        "msgID": "DVLTKMES_006_L0050",
        "msgStr": "14. Raidou Kuzunoha."
      },
      {
        "msgID": "DVLTKMES_006_L0051",
        "msgStr": "<NAME 0>."
      },
      {
        "msgID": "DVLTKMES_006_L0052",
        "msgStr": "Söylemem."
      },
      {
        "msgID": "DVLTKMES_006_L0053",
        "msgStr": "Yani gerçekten bana patronluk taslayabileceğini mi sanıyorsun evlat?"
      },
      {
        "msgID": "DVLTKMES_006_L0054",
        "msgStr": "Evet."
      },
      {
        "msgID": "DVLTKMES_006_L0055",
        "msgStr": "Sanırım hayır."
      },
      {
        "msgID": "DVLTKMES_006_L0056",
        "msgStr": "Senin patron olmanı tercih ederim."
      },
      {
        "msgID": "DVLTKMES_006_L0057",
        "msgStr": "Sana katıldıktan sonra bundan benim çıkarım ne olacak evlat?"
      },
      {
        "msgID": "DVLTKMES_006_L0058",
        "msgStr": "Seni güçlendireceğim."
      },
      {
        "msgID": "DVLTKMES_006_L0059",
        "msgStr": "Seni çalıştıracağım."
      },
      {
        "msgID": "DVLTKMES_006_L0060",
        "msgStr": "Seni füzyon için kullanacağım."
      },
      {
        "msgID": "DVLTKMES_006_L0061",
        "msgStr": "Çağırıcı olarak kalırsan büyük ihtimalle korkunç bir ölüm seni bulur. Senin için hava hoş mu?"
      },
      {
        "msgID": "DVLTKMES_006_L0062",
        "msgStr": "Üstesinden gelebilirim."
      },
      {
        "msgID": "DVLTKMES_006_L0063",
        "msgStr": "Bunu istemiyorum."
      },
      {
        "msgID": "DVLTKMES_006_L0064",
        "msgStr": "Bu hiçbir şey değil."
      },
      {
        "msgID": "DVLTKMES_006_L0065",
        "msgStr": "Hoho, yaşama sebebin nedir bakalım?"
      },
      {
        "msgID": "DVLTKMES_006_L0066",
        "msgStr": "Ölmemek için."
      },
      {
        "msgID": "DVLTKMES_006_L0067",
        "msgStr": "Yapmam gereken bir şey var."
      },
      {
        "msgID": "DVLTKMES_006_L0068",
        "msgStr": "Hayatın kanunu bu."
      },
      {
        "msgID": "DVLTKMES_006_L0069",
        "msgStr": "Ho ho, nihayet sana katılıyorum. Biraz daha beklesem tahtalı köyü boylayacaktım."
      },
      {
        "msgID": "DVLTKMES_006_L0070",
        "msgStr": "Beklettiğim için üzgünüm."
      },
      {
        "msgID": "DVLTKMES_006_L0071",
        "msgStr": "Gerçekten mi?"
      },
      {
        "msgID": "DVLTKMES_006_L0072",
        "msgStr": "Yalan söylüyorsun..."
      },
      {
        "msgID": "DVLTKMES_006_L0073",
        "msgStr": "En çok istediğin şey nedir evlat?"
      },
      {
        "msgID": "DVLTKMES_006_L0074",
        "msgStr": "Sonsuz zenginlik."
      },
      {
        "msgID": "DVLTKMES_006_L0075",
        "msgStr": "Sınırsız sevgi."
      },
      {
        "msgID": "DVLTKMES_006_L0076",
        "msgStr": "Tek istediğim sensin."
      },
      {
        "msgID": "DVLTKMES_006_L0077",
        "msgStr": "Yatagarasu hakkında ne düşünüyorsun?"
      },
      {
        "msgID": "DVLTKMES_006_L0078",
        "msgStr": "İyilerdir."
      },
      {
        "msgID": "DVLTKMES_006_L0079",
        "msgStr": "Kötülerdir."
      },
      {
        "msgID": "DVLTKMES_006_L0080",
        "msgStr": "Ben sadece işimi yapıyorum..."
      },
      {
        "msgID": "DVLTKMES_006_L0081",
        "msgStr": "Hey, burada açlıktan ölüyorum. Ne yememi önerirsin?"
      },
      {
        "msgID": "DVLTKMES_006_L0082",
        "msgStr": "Ramen."
      },
      {
        "msgID": "DVLTKMES_006_L0083",
        "msgStr": "Hayashi pilavı."
      },
      {
        "msgID": "DVLTKMES_006_L0084",
        "msgStr": "Şinitzel."
      },
      {
        "msgID": "DVLTKMES_006_L0085",
        "msgStr": "Ah, bunu duymayı bekliyordum işte!"
      },
      {
        "msgID": "DVLTKMES_006_L0086",
        "msgStr": "İşte bu kulağıma müzik gibi geldi!"
      },
      {
