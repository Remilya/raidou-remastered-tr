      },
      {
        "msgID": "MAP22_E_L0001",
        "msgStr": "Shizu'nun kocasına saldıran bu muydu?"
      },
      {
        "msgID": "map22_e_EPI02_SCENE21_04_002",
        "msgStr": "Gouto"
      },
      {
        "msgID": "MAP22_E_L0002",
        "msgStr": "Belki dolunay yüzündendir ama konuşarak anlaşmak pek mümkün görünmüyor."
      },
      {
        "msgID": "map22_e_EPI02_SCENE21_05_003",
        "msgStr": "Oboroguruma"
      },
      {
        "msgID": "MAP22_E_L0003",
        "msgStr": "DoLuNaY aDıNa, SeNi Ezİp GeÇeCeĞiM!"
      },
      {
        "msgID": "map22_e_EPI02_SCENE22_01_004",
        "msgStr": "Oboroguruma"
      },
      {
        "msgID": "MAP22_E_L0004",
        "msgStr": "YaNLıŞ aDaM mIyMıŞsIn!? BaŞtAn SöYLeSeNe O zAmAn! HeR yErİm GöÇtÜ şİmDi..."
      },
      {
        "msgID": "map22_e_EPI02_SCENE22_02_005",
        "msgStr": "Gouto"
      },
      {
        "msgID": "MAP22_E_L0005",
        "msgStr": "Son zamanlarda bu bölgede birinin taksilere saldırdığını duyduk."
      },
      {
        "msgID": "map22_e_EPI02_SCENE22_03_006",
        "msgStr": "Oboroguruma"
      },
      {
        "msgID": "MAP22_E_L0006",
        "msgStr": "BeN sALdIrMaM! ÖncE bAnA sALdIrDıLaR!"
      },
      {
        "msgID": "MAP22_E_L0007",
        "msgStr": "o KıRmIzI pELeRiNLİ aDaM! HeM bAnA hEm De TaKsiLeRe SaLdIrDı!"
      },
      {
        "msgID": "MAP22_E_L0008",
        "msgStr": "SeNiNkİ gİbİ pELeRiNi VaRdI aMa KıRmIzIyDı! BuNu DüŞüRdÜ!"
      },
      {
        "msgID": "MAP22_E_L0009",
        "msgStr": "GeÇeN gÜn OnU gÖrDüM! İntİkAm İçİn PeŞiNe DüŞtÜm!"
      },
      {
        "msgID": "MAP22_E_L0010",
        "msgStr": "AmA kAçTı... DüZ yOLdA oNa YeTiŞeMeDiM..."
      },
      {
        "msgID": "MAP22_E_L0011",
        "msgStr": "AaAh! NaRiN kALbİm PaRçA pİnÇiK oLdU!"
      },
      {
        "msgID": "MAP22_E_L0012",
        "msgStr": "Al ŞuNu ŞiMdİ. SaDeCe YaLnIz KaLmAk İsTiYoRuM..."
      },
      {
        "msgID": "map22_e_EPI02_SCENE22_08_007",
        "msgStr": "NULL"
      },
      {
        "msgID": "MAP22_E_L0013",
        "msgStr": "> Raidou bir <ITM_04><COLOR 4>Çekçek Topuzu<COLOR 0> elde etti."
      },
      {
        "msgID": "map22_e_EPI02_SCENE27_01_008",
        "msgStr": "NULL"
