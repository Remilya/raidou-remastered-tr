      {
        "msgID": "DVLTKMES_001_L0050",
        "msgStr": "Adın ne senin, insan?"
      },
      {
        "msgID": "DVLTKMES_001_L0051",
        "msgStr": "14. Raidou Kuzunoha."
      },
      {
        "msgID": "DVLTKMES_001_L0052",
