      },
      {
        "msgID": "DVLTKMES_001_L0053",
        "msgStr": "Söylemem."
      },
      {
        "msgID": "DVLTKMES_001_L0054",
        "msgStr": "Ee... Benimle ne yapmayı planlıyorsun?"
      },
      {
        "msgID": "DVLTKMES_001_L0055",
        "msgStr": "Omuz omuza savaşacağız."
      },
      {
        "msgID": "DVLTKMES_001_L0056",
        "msgStr": "Sana göz kulak olacağım."
      },
      {
        "msgID": "DVLTKMES_001_L0057",
        "msgStr": "Seni füzyon için kullanacağım."
      },
      {
        "msgID": "DVLTKMES_001_L0058",
        "msgStr": "Benimle bulaşmak istediğine emin misin?"
      },
      {
        "msgID": "DVLTKMES_001_L0059",
        "msgStr": "Kesinlikle."
      },
      {
        "msgID": "DVLTKMES_001_L0060",
        "msgStr": "Belki de değilimdir..."
      },
      {
        "msgID": "DVLTKMES_001_L0061",
        "msgStr": "İşi profesyonel tutalım."
      },
      {
        "msgID": "DVLTKMES_001_L0062",
        "msgStr": "Peki sana katılırsam karşılığında ne alacağım?"
      },
      {
        "msgID": "DVLTKMES_001_L0063",
        "msgStr": "Seni güçlendireceğim."
      },
      {
        "msgID": "DVLTKMES_001_L0064",
        "msgStr": "Seni çalıştıracağım."
      },
      {
        "msgID": "DVLTKMES_001_L0065",
        "msgStr": "Seni füzyon için kullanacağım."
      },
      {
        "msgID": "DVLTKMES_001_L0066",
        "msgStr": "Sence insanlar ve iblisler arkadaş olabilir mi?"
      },
      {
        "msgID": "DVLTKMES_001_L0067",
        "msgStr": "Elbette olabiliriz."
      },
      {
        "msgID": "DVLTKMES_001_L0068",
        "msgStr": "Hayır, olamayız."
      },
      {
        "msgID": "DVLTKMES_001_L0069",
        "msgStr": "Arkadaştan öte olabiliriz."
      },
      {
        "msgID": "DVLTKMES_001_L0070",
        "msgStr": "Beni mutlu edecek misin?"
      },
      {
        "msgID": "DVLTKMES_001_L0071",
        "msgStr": "Elimden geleni yapacağım."
      },
      {
        "msgID": "DVLTKMES_001_L0072",
        "msgStr": "Pek sanmam."
      },
      {
        "msgID": "DVLTKMES_001_L0073",
        "msgStr": "Şimdiden mutlu olmalısın."
      },
      {
        "msgID": "DVLTKMES_001_L0074",
        "msgStr": "Sonunda sana katılabiliyorum! Hep bunu beklemiştim..."
      },
      {
        "msgID": "DVLTKMES_001_L0075",
        "msgStr": "Beklettiğim için üzgünüm."
      },
      {
        "msgID": "DVLTKMES_001_L0076",
        "msgStr": "Gerçekten mi?"
      },
      {
        "msgID": "DVLTKMES_001_L0077",
        "msgStr": "Yalan söylüyorsun..."
      },
      {
        "msgID": "DVLTKMES_001_L0078",
        "msgStr": "Acıktım. Bana bir şey önersene."
      },
      {
        "msgID": "DVLTKMES_001_L0079",
