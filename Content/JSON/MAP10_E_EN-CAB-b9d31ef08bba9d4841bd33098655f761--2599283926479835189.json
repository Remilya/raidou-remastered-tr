        "msgStr": "Narumi"
      },
      {
        "msgID": "MAP10_E_L0181",
        "msgStr": "<lips 17 5>"
      },
      {
        "msgID": "MAP10_E_L0182",
        "msgStr": "Dışarıdaki o canavar mı dersin? Hadi, gidip bir bakalım!\n<lips_stop>"
