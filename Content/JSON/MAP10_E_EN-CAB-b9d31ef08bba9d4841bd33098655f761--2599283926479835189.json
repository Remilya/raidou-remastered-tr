        "msgStr": "Narumi"
      },
      {
        "msgID": "MAP10_E_L0162",
        "msgStr": "<lips 17 5>"
      },
      {
        "msgID": "MAP10_E_L0163",
        "msgStr": "Casusluk yaptığım dönemde pek çok gizli bilgiyle temasım oldu.\n<lips_stop>"
      },
      {
        "msgID": "MAP10_E_L0164",
        "msgStr": "<lips 17 5>"
      },
      {
        "msgID": "MAP10_E_L0165",
        "msgStr": "Meğer dünya birbirleriyle kıyasıya kapışan uluslarüstü gruplarla doluymuş.\n<lips_stop>"
