      {
        "msgID": "MAP10_E_L0179_05",
        "msgStr": "<lips 17 5>"
      },
      {
        "msgID": "MAP10_E_L0179_06",
        "msgStr": "Ama senin ne olursa olsun yılmadan ilerlediğini görmek... Dışarıda senin gibi insanların olduğunu bilmek bile gözlerimi açtı.\n<lips_stop>"
      },
      {
        "msgID": "MAP10_E_L0179_07",
        "msgStr": "<lips 17 5>"
      },
      {
        "msgID": "MAP10_E_L0179_08",
        "msgStr": "Tek bir hakikatten fazlası var. Herkesin <IT_S>kendi<IT_E> hakikati var.\n<lips_stop>"
