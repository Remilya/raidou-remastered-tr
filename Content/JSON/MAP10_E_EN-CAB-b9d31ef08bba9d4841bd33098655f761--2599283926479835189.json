      {
        "msgID": "MAP10_E_L0185",
        "msgStr": "<lips 17 5>"
      },
      {
        "msgID": "MAP10_E_L0186",
        "msgStr": "Bu silahla muhtemelen o zombilerle bile zar zor başa çıkabilirdim.\n<lips_stop>"
