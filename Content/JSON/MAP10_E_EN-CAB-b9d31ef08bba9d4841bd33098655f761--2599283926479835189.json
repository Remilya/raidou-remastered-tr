      {
        "msgID": "MAP10_E_L0175",
        "msgStr": "ER100"
      },
      {
        "msgID": "MAP10_E_L0176",
        "msgStr": "<lips 17 5>"
      },
      {
        "msgID": "MAP10_E_L0177",
        "msgStr": "Açıkçası, sonumun tıpkı Munakata gibi olması işten bile değildi.\n<lips_stop>"
      },
      {
        "msgID": "MAP10_E_L0178",
        "msgStr": "<lips 17 5>"
      },
      {
        "msgID": "MAP10_E_L0179",
        "msgStr": "Ama... öyle olmadı. Ve bu senin sayende, Raidou.\n<lips_stop>"
