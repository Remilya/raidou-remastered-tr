      {
        "msgID": "MAP10_E_L0179_09",
        "msgStr": "<lips 17 5>"
      },
      {
        "msgID": "MAP10_E_L0179_10",
        "msgStr": "Zaten en başında dedektif olmamın sebebi de buydu—insanların <IT_S>kendi hakikatlerini<IT_E> bulmalarına yardım etmek.\n<lips_stop>"
