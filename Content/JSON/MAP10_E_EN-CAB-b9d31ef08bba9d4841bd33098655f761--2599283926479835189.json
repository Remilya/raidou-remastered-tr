      {
        "msgID": "MAP10_E_L0142",
        "msgStr": "<lips 30 5>"
      },
      {
        "msgID": "MAP10_E_L0143",
        "msgStr": "Hepsi ıstırap içinde günahlarını düşünerek helak olacak!\n<lips_stop>"
      },
      {
        "msgID": "map10_e_EPI10_SCENE08_14_026",
        "msgStr": "Narumi"
      },
      {
        "msgID": "MAP10_E_L0144",
        "msgStr": "<lips 17 5>"
      },
      {
        "msgID": "MAP10_E_L0145",
        "msgStr": "Binlerce yıl öncesinden kalma bir kinin bugünün dünyasıyla hiçbir ilgisi yok!\n<lips_stop>"
      },
      {
        "msgID": "map10_e_EPI10_SCENE08_15_027",
        "msgStr": "Sukuna-Hikona"
      },
      {
        "msgID": "MAP10_E_L0146",
        "msgStr": "<lips 30 5>"
      },
      {
        "msgID": "MAP10_E_L0147",
        "msgStr": "Sırf o iblislerin soyundan gelmek bile başlı başına bir günahtır!\n<lips_stop>"
      },
      {
        "msgID": "map10_e_EPI10_SCENE08_16_028",
        "msgStr": "Narumi"
      },
      {
        "msgID": "MAP10_E_L0148",
        "msgStr": "<lips 17 5>"
      },
      {
        "msgID": "MAP10_E_L0149",
        "msgStr": "Sen delirmişsin...\n<lips_stop>"
      },
      {
        "msgID": "map10_e_EPI10_SCENE08_17_029",
        "msgStr": "Sukuna-Hikona"
      },
      {
        "msgID": "MAP10_E_L0150",
        "msgStr": "<lips 30 5>"
      },
      {
        "msgID": "MAP10_E_L0151",
        "msgStr": "Siz insanlar çağlar süren ezilmişliğimizi anlamayı umamazsınız bile!\n<lips_stop>"
      },
      {
        "msgID": "MAP10_E_L0152",
        "msgStr": "<lips 30 5>"
      },
      {
        "msgID": "MAP10_E_L0153",
        "msgStr": "Şimdi... değerli Başkent'iniz yerle bir olurken geberin!\n<lips_stop>"
