        "msgID": "MAP10_E_L0158",
        "msgStr": "<lips 17 5>"
      },
      {
        "msgID": "MAP10_E_L0159",
        "msgStr": "Ya da belki o iblis sadece ondan faydalandı.\n<lips_stop>"
      },
      {
        "msgID": "MAP10_E_L0160",
        "msgStr": "<lips 17 5>"
      },
      {
        "msgID": "MAP10_E_L0161",
        "msgStr": "Her iki durumda da... Ne büyük bir trajedi...\n<lips_stop>"
