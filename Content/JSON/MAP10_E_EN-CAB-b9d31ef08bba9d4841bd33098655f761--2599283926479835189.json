      {
        "msgID": "MAP10_E_L0179_01",
        "msgStr": "<lips 17 5>"
      },
      {
        "msgID": "MAP10_E_L0179_02",
        "msgStr": "Seninle tanışmak bir şeyi fark etmemi sağladı.\n<lips_stop>"
      },
      {
        "msgID": "MAP10_E_L0179_03",
        "msgStr": "<lips 17 5>"
      },
      {
        "msgID": "MAP10_E_L0179_04",
        "msgStr": "Eskiden bu acımasız gerçekliğin dünyadaki tek hakikat olduğunu düşünürdüm.\n<lips_stop>"
