      {
        "msgID": "map10_e_EPI10_SCENE09_01_030",
        "msgStr": "Narumi"
      },
      {
        "msgID": "MAP10_E_L0154",
        "msgStr": "<lips 17 5>"
      },
      {
        "msgID": "MAP10_E_L0155",
        "msgStr": "Demek Munakata bir iblis tarafından ele geçirilmişti?\n<lips_stop>"
      },
      {
        "msgID": "MAP10_E_L0156",
        "msgStr": "<lips 17 5>"
      },
      {
        "msgID": "MAP10_E_L0157",
        "msgStr": "Bu nasıl oldu? Gerçekten istediği şey bu muydu?\n<lips_stop>"
