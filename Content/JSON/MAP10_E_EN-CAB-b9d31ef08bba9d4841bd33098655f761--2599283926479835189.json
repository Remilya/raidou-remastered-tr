      {
        "msgID": "MAP10_E_L0168",
        "msgStr": "<lips 17 5>"
      },
      {
        "msgID": "MAP10_E_L0169",
        "msgStr": "Ve bizler de onların oyununda sadece birer piyonuz...\n<lips_stop>"
