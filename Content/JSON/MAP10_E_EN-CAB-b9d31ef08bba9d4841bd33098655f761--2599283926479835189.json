      {
        "msgID": "MAP10_E_L0134",
        "msgStr": "<lips 5 5>"
      },
      {
        "msgID": "MAP10_E_L0135",
        "msgStr": "Siz aptal insanların tamamının kökünün kazınması için haykırıyorlar!\n<lips_stop>"
      },
      {
        "msgID": "map10_e_EPI10_SCENE08_10_023",
        "msgStr": "Narumi"
      },
      {
        "msgID": "MAP10_E_L0136",
        "msgStr": "<lips 17 5>"
      },
      {
        "msgID": "MAP10_E_L0137",
        "msgStr": "Buradaki tek \"aptal insan\" sensin, Munakata.\n<lips_stop>"
      },
      {
        "msgID": "map10_e_EPI10_SCENE08_11_024",
        "msgStr": "Munakata"
      },
      {
        "msgID": "MAP10_E_L0138",
        "msgStr": "<lips 5 5>"
      },
      {
        "msgID": "MAP10_E_L0139",
        "msgStr": "Demek bir \"insanım\", öyle mi?\n<lips_stop>"
