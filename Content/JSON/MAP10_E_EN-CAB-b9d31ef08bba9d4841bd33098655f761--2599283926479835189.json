      {
        "msgID": "MAP10_E_L0166",
        "msgStr": "<lips 17 5>"
      },
      {
        "msgID": "MAP10_E_L0167",
        "msgStr": "Gücü elinde bulunduranlar, yetkilerini tarihi kendi çıkarlarına göre yeniden yazmak için kullanıyorlar.\n<lips_stop>"
