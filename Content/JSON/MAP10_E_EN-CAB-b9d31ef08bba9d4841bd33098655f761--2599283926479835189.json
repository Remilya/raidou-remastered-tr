      },
      {
        "msgID": "MAP10_E_L0183",
        "msgStr": "<lips 17 5>"
      },
      {
        "msgID": "MAP10_E_L0184",
        "msgStr": "Dürüst olmak gerekirse, burada olduğuna bayağı sevindim.\n<lips_stop>"
