      },
      {
        "msgID": "MAP10_E_L0140",
        "msgStr": "<lips 30 5>"
      },
      {
        "msgID": "MAP10_E_L0141",
        "msgStr": "Ruhsuz Tanrı, Başkent'teki milyonları yok edecek.\n<lips_stop>"
