      {
        "msgID": "map03_m_m_NozokiDevil01_01_01_120",
        "msgStr": "Şüpheli Adam"
      },
      {
        "msgID": "MAP03_M_L0218",
        "msgStr": "İkile ufaklık, beni rahatsız etmeyi kes! Tam da en heyecanlı yerine geliyordu...!"
      },
      {
        "msgID": "map03_m_m_NozokiDevil01_01_02_121",
        "msgStr": "Şüpheli Adam"
      },
      {
        "msgID": "MAP03_M_L0219",
        "msgStr": "Kocasının neden hep evden uzakta olduğunu merak ederken kedere boğulan bir insan eş..."
      },
      {
        "msgID": "MAP03_M_L0220",
        "msgStr": "Heheh... Böyle şeylere doyamıyorum."
      },
      {
        "msgID": "map03_m_m_NozokiDevil01_01_03_122",
        "msgStr": "NULL"
      },
      {
        "msgID": "MAP03_M_L0221",
        "msgStr": "> Görünüşe göre iblisleri görebiliyor..."
      },
      {
        "msgID": "map03_m_m_NozokiDevil01_02_01_123",
        "msgStr": "Şüpheli Adam"
      },
      {
        "msgID": "MAP03_M_L0222",
        "msgStr": "Oh...? Bu da ne şimdi?"
      },
      {
        "msgID": "map03_m_m_NozokiDevil01_02_02_124",
        "msgStr": "Şüpheli Adam"
      },
      {
        "msgID": "MAP03_M_L0223",
        "msgStr": "Oooh, şuna bak hele. Evet, aradığım şey tam da bu..."
      },
      {
        "msgID": "MAP03_M_L0224",
        "msgStr": "İnsan dünyası güzel, şey, manzaralarla dolup taşıyor. Kendime engel olamıyorum; <IT_S>bakmak<IT_E> zorundayım!"
      },
      {
        "msgID": "MAP03_M_L0225",
        "msgStr": "Heheheh..."
      },
      {
        "msgID": "map03_m_m_NozokiDevil01_02_03a_125",
        "msgStr": "İblis"
      },
      {
        "msgID": "MAP03_M_L0226",
        "msgStr": "Ne oluyor be...?"
      },
      {
        "msgID": "map03_m_m_NozokiDevil01_02_03b_126",
        "msgStr": "İblis"
      },
      {
        "msgID": "MAP03_M_L0227",
        "msgStr": "Kahretsin! İnsan kılığımdan çıktım!"
      },
      {
        "msgID": "map03_m_m_NozokiDevil01_02_04_127",
        "msgStr": "İblis"
      },
      {
        "msgID": "MAP03_M_L0228",
        "msgStr": "Hey, sen! Hiçbir şey görmedin, tamam mı? Lütfen?"
      },
      {
        "msgID": "MAP03_M_L0229",
        "msgStr": "İnsanları dikizlemek hayattaki tek eğlencem!"
      },
      {
        "msgID": "map03_m_m_NozokiDevil01_02_05_128",
        "msgStr": "İblis"
      },
      {
        "msgID": "MAP03_M_L0230",
        "msgStr": "...Heh, ne diye yalvarıyorsam?"
      },
      {
        "msgID": "MAP03_M_L0231",
        "msgStr": "Seni mideme indiririm, böylece kusursuz bir suç olur!"
      },
      {
        "msgID": "map03_m_m_NozokiDevil01_02_06_129",
        "msgStr": "ER100"
      },
      {
        "msgID": "MAP03_M_L0232",
        "msgStr": "ER100"
