      },
      {
        "msgID": "MAP03_M_L0096",
        "msgStr": "Denpachi burada değil... <COLOR 3>Belki de Ryugu'dadır?<COLOR 0>"
      },
      {
        "msgID": "map03_m_m_Misemono01_054",
        "msgStr": "NULL"
      },
      {
        "msgID": "MAP03_M_L0097",
        "msgStr": "> İlerideki bir teşhir salonunda bir sergi var gibi görünüyor."
      },
      {
        "msgID": "map03_m_m_Misemono02_01_055",
        "msgStr": "Ufak Tefek Adam"
      },
      {
        "msgID": "MAP03_M_L0098",
        "msgStr": "Gelin, toplanın! Şanslı gününüzdesiniz, çünkü bu hayatta bir kez karşınıza çıkacak bir fırsat!"
      },
      {
        "msgID": "MAP03_M_L0099",
        "msgStr": "Beni dinleyin ve korkuyu tanıyın! Gerçeği öğrenin ve tir tir titreyin! Gözleriniz bayram etsin ve dehşetle ürperin!"
      },
      {
        "msgID": "MAP03_M_L0100",
        "msgStr": "Karanlık Diyar'ın iblislerine kendi gözlerinizle tanık olun!"
      },
      {
        "msgID": "map03_m_m_Misemono02_01_dev_056",
        "msgStr": "NULL"
      },
      {
        "msgID": "MAP03_M_L0101",
        "msgStr": "> <devil 0> teşhir salonuna girdi."
      },
      {
        "msgID": "MAP03_M_L0102",
        "msgStr": "> İçeride sergilenen yaratığın gerçek bir iblisle uzaktan yakından alakası yoktu."
      },
      {
        "msgID": "MAP03_M_L0103",
        "msgStr": "> <devil 0> iç çekerek teşhir salonundan çıktı..."
      },
      {
        "msgID": "map03_m_m_Misemono02_02_057",
        "msgStr": "Ufak Tefek Adam"
      },
      {
        "msgID": "MAP03_M_L0104",
        "msgStr": "Hey, evlat! Neden kendin bir göz atmıyorsun?"
      },
      {
        "msgID": "map03_m_m_Misemono02_02_01_058",
        "msgStr": "Ufak Tefek Adam"
      },
      {
        "msgID": "MAP03_M_L0105",
        "msgStr": "Haftanın ucubesi, bizim \"denizkızı\" demeyi sevdiğimiz bir yaratık!"
      },
      {
        "msgID": "map03_m_m_Misemono02_02_02_059",
        "msgStr": "Ufak Tefek Adam"
      },
      {
        "msgID": "MAP03_M_L0106",
        "msgStr": "Bu seferki haftanın ucubesi bir \"dev\"!"
      },
      {
        "msgID": "map03_m_m_Misemono02_02_03_060",
        "msgStr": "Ufak Tefek Adam"
      },
      {
        "msgID": "MAP03_M_L0107",
        "msgStr": "Bu haftaki ucubemiz ise bir \"...ağızlı... kadın...\"!"
      },
      {
        "msgID": "map03_m_m_Misemono02_02s SEL_061",
        "msgStr": "NULL"
      },
      {
        "msgID": "MAP03_M_L0108",
        "msgStr": "Bir göz at"
      },
      {
        "msgID": "MAP03_M_L0109",
        "msgStr": "Gözlerini kaçır"
      },
      {
        "msgID": "map03_m_m_Misemono02_02a_062",
        "msgStr": "NULL"
      },
      {
        "msgID": "MAP03_M_L0110",
        "msgStr": "> Burası denizkızının odası..."
      },
      {
        "msgID": "MAP03_M_L0111",
        "msgStr": "> İçeride, ölü balıklarla dolu bir odada balık şeklinde pantolon giymiş bir çalışan var."
      },
      {
        "msgID": "MAP03_M_L0112",
        "msgStr": "> Çığırtkana göre bu leş koku, denizkızının gerçek olduğunun kanıtıymış."
      },
      {
        "msgID": "MAP03_M_L0113",
        "msgStr": "> Müşterilerin hem kokudan hem de bu ucuz numaradan mideleri bulanmış durumda..."
      },
      {
        "msgID": "map03_m_m_Misemono02_02b_063",
        "msgStr": "NULL"
      },
      {
        "msgID": "MAP03_M_L0114",
        "msgStr": "> Burası devin odası..."
      },
      {
        "msgID": "MAP03_M_L0115",
        "msgStr": "> Yüksek bir çatının altında, uzun boylu biri odanın içinde dengesizce sallanarak yürüyor."
      },
      {
        "msgID": "MAP03_M_L0116",
        "msgStr": "> Çığırtkana göre bu kadar uzun boylu biri tartışmasız bir devmiş."
      },
      {
        "msgID": "MAP03_M_L0117",
        "msgStr": "> Müşterilerin hiçbiri, açıkça birinin diğerinin omuzlarına çıktığı bu numaraya kanmıyor..."
      },
      {
        "msgID": "map03_m_m_Misemono02_02c_064",
        "msgStr": "NULL"
      },
      {
        "msgID": "MAP03_M_L0118",
        "msgStr": "> Karanlık odada bir kadın var."
      },
      {
        "msgID": "MAP03_M_L0119",
        "msgStr": "> Loş ışık yüzünden onu net görmek zor."
      },
      {
        "msgID": "MAP03_M_L0120",
        "msgStr": "> Müşteriler onun neye benzediğini hayal ederek korkuyla yutkunuyor."
      },
      {
        "msgID": "MAP03_M_L0121",
        "msgStr": "> Çığırtkan konuşmaya başladı."
      },
      {
        "msgID": "MAP03_M_L0122",
        "msgStr": "> Ona göre kadın tek kelime bile etmiyormuş, bu da onu hakiki bir \"kapalı ağızlı kadın\" yapıyormuş."
      },
      {
        "msgID": "MAP03_M_L0123",
        "msgStr": "> Müşteriler de kendilerini ne kadar aptal hissettiklerini belli etmemek için ağızlarını kapalı tuttu."
      },
      {
        "msgID": "map03_m_m_Misemono02_03_065",
        "msgStr": "Gouto"
      },
      {
        "msgID": "MAP03_M_L0124",
        "msgStr": "Böyle olacağını tahmin etmiştim."
      },
      {
        "msgID": "MAP03_M_L0125",
        "msgStr": "Sen ve ben çok daha akılalmaz şeyler gördük."
      },
      {
        "msgID": "map03_m_m_Misemono03_066",
        "msgStr": "NULL"
      },
      {
        "msgID": "MAP03_M_L0126",
        "msgStr": "> Bir tabelada \"Nihai robot Gyakutensoku'nun dünya prömiyeri sergisi!\" yazıyor."
      },
      {
        "msgID": "MAP03_M_L0127",
        "msgStr": "> Camekânın içindeki tek şey ucuz görünümlü mekanik bir bebek."
      },
      {
        "msgID": "map03_m_m_House01_067",
        "msgStr": "NULL"
      },
      {
        "msgID": "MAP03_M_L0128",
        "msgStr": "ER100"
      },
      {
        "msgID": "map03_m_m_House02_068",
        "msgStr": "NULL"
      },
      {
        "msgID": "MAP03_M_L0129",
        "msgStr": "ER100"
      },
      {
        "msgID": "map03_m_m_House03_069",
        "msgStr": "NULL"
      },
      {
        "msgID": "MAP03_M_L0130",
        "msgStr": "> Burası bir ev."
      },
      {
        "msgID": "MAP03_M_L0131",
        "msgStr": "> İçeride günlük ev işlerini yapan bir kadın var."
      },
      {
        "msgID": "map03_m_m_House04_070",
        "msgStr": "NULL"
      },
      {
        "msgID": "MAP03_M_L0132",
        "msgStr": "> Burası ahşap bir sıra ev."
      },
      {
        "msgID": "MAP03_M_L0133",
        "msgStr": "> İçeride üzerinde sadece iç çamaşırı olan bir adam tembel tembel uzanıyor."
      },
      {
        "msgID": "map03_m_m_House04_dev_071",
        "msgStr": "NULL"
      },
      {
        "msgID": "MAP03_M_L0134",
        "msgStr": "> Burası ahşap bir sıra ev."
      },
      {
        "msgID": "MAP03_M_L0135",
        "msgStr": "> <devil 0>, iç çamaşırlı bir adamın aslında ne kadar savunmasız olduğunu öğrendi."
      },
      {
        "msgID": "map03_m_m_House05_072",
        "msgStr": "NULL"
      },
      {
        "msgID": "MAP03_M_L0136",
        "msgStr": "> Burası ahşap bir sıra ev."
      },
      {
        "msgID": "MAP03_M_L0137",
        "msgStr": "> İçerideki kadın ağlayan bebeğini sakinleştirmeye çalışıyor."
      },
      {
        "msgID": "map03_m_m_House05_dev_073",
        "msgStr": "NULL"
      },
      {
        "msgID": "MAP03_M_L0138",
        "msgStr": "> Burası ahşap bir sıra ev."
      },
      {
        "msgID": "MAP03_M_L0139",
        "msgStr": "> <devil 0> ağlayan bebeğin gözlerinin içine baktı."
      },
      {
        "msgID": "MAP03_M_L0140",
        "msgStr": "> Bebek neşeyle kıkırdadı."
      },
      {
        "msgID": "map03_m_m_House06_074",
        "msgStr": "NULL"
      },
      {
        "msgID": "MAP03_M_L0141",
        "msgStr": "> Burası Japon tarzı bir ev."
      },
      {
        "msgID": "MAP03_M_L0142",
        "msgStr": "> O kadar külüstür görünüyor ki bir hapşırıkla yerle bir olabilir."
      },
      {
        "msgID": "map03_m_m_House06_dev_075",
        "msgStr": "NULL"
      },
      {
        "msgID": "MAP03_M_L0143",
        "msgStr": "> Burası Japon tarzı bir ev."
      },
      {
        "msgID": "MAP03_M_L0144",
        "msgStr": "> <devil 0>, bir insanın neden tavana çiçek saksısı asacağına anlam veremedi."
      },
      {
        "msgID": "map03_m_m_House07_076",
        "msgStr": "NULL"
      },
      {
        "msgID": "MAP03_M_L0145",
        "msgStr": "> Burası Japon tarzı bir ev."
      },
      {
        "msgID": "MAP03_M_L0146",
        "msgStr": "> Kapının önüne çeşitli sandaletler özenle dizilmiş."
      },
      {
        "msgID": "map03_m_m_House07_dev_077",
        "msgStr": "NULL"
      },
      {
        "msgID": "MAP03_M_L0147",
        "msgStr": "> Burası Japon tarzı bir ev."
      },
      {
        "msgID": "MAP03_M_L0148",
        "msgStr": "> <devil 0>, sandaletlerin kendisine dik dik baktığını hissedip ödünü patlattı ve kaçtı."
      },
      {
        "msgID": "map03_m_m_House08_078",
        "msgStr": "NULL"
      },
      {
        "msgID": "MAP03_M_L0149",
        "msgStr": "> Burası ahşap bir sıra ev."
      },
      {
        "msgID": "MAP03_M_L0150",
        "msgStr": "> İçerideki çocuk boş bir portakal sandığının üzerinde güzel yazı alıştırması yapıyor."
      },
      {
        "msgID": "map03_m_m_House08_dev_079",
        "msgStr": "NULL"
      },
      {
        "msgID": "MAP03_M_L0151",
        "msgStr": "> Burası ahşap bir sıra ev."
      },
      {
        "msgID": "MAP03_M_L0152",
        "msgStr": "> <devil 0>, çocuğun masa olarak kullandığı sandıktan gelen narenciye kokusunu aldı."
      },
      {
        "msgID": "map03_m_m_House09_080",
        "msgStr": "NULL"
      },
      {
        "msgID": "MAP03_M_L0153",
        "msgStr": "> Burası ahşap bir sıra ev."
      },
      {
        "msgID": "MAP03_M_L0154",
        "msgStr": "> Kırık camı kapatmak için Başkent Günlüğü'nün eski sayıları asılmış."
      },
      {
        "msgID": "map03_m_m_House09_dev_081",
        "msgStr": "NULL"
      },
      {
        "msgID": "MAP03_M_L0155",
        "msgStr": "> Burası ahşap bir sıra ev."
      },
      {
        "msgID": "MAP03_M_L0156",
        "msgStr": "> <devil 0>, tentenin altında bir kırlangıç yuvası keşfetti."
      },
      {
        "msgID": "map03_m_m_House10_082",
        "msgStr": "NULL"
      },
      {
        "msgID": "MAP03_M_L0157",
        "msgStr": "> Burası Japon tarzı bir ev."
      },
      {
        "msgID": "MAP03_M_L0158",
        "msgStr": "> Kapının altında gazeteler ve el ilanları birikmiş."
      },
      {
        "msgID": "map03_m_m_House10_dev_083",
        "msgStr": "NULL"
      },
      {
        "msgID": "MAP03_M_L0159",
        "msgStr": "> Burası Japon tarzı bir ev."
      },
      {
        "msgID": "MAP03_M_L0160",
        "msgStr": "> İçeride kimsenin olmadığını anlamak için <devil 0> adına altıncı hisse gerek yok."
      },
      {
        "msgID": "map03_m_m_Jinriki01_084",
        "msgStr": "NULL"
      },
      {
        "msgID": "MAP03_M_L0161",
        "msgStr": "> Burası eski bir çekçek."
      },
      {
        "msgID": "MAP03_M_L0162",
        "msgStr": "> Eski bir model gibi görünüyor ama çok iyi bakılmış."
      },
      {
        "msgID": "map03_m_m_Jinriki01_dev_085",
        "msgStr": "NULL"
      },
      {
        "msgID": "MAP03_M_L0163",
        "msgStr": "> Burası eski bir çekçek."
