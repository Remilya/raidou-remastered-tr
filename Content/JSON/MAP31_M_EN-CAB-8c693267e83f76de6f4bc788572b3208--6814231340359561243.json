  "_TextMsgData": {
    "Array": [
      {
        "msgID": "map31_m_m_Exit01_000",
        "msgStr": "NULL"
      },
      {
        "msgID": "MAP31_M_L0000",
        "msgStr": "> Karanlık Sakuradayama'ya dönülsün mü?"
      },
      {
        "msgID": "map31_m_m_Exit01s SEL_001",
        "msgStr": "NULL"
      },
      {
        "msgID": "MAP31_M_L0001",
        "msgStr": "Dön"
      },
      {
        "msgID": "MAP31_M_L0002",
        "msgStr": "Burada kal"
      },
      {
        "msgID": "map31_m_m_EP08_HIRUKO_01_002",
        "msgStr": "NULL"
      },
      {
        "msgID": "MAP31_M_L0003",
        "msgStr": "> Hiruko'lar yolu kapatıyor."
      },
      {
        "msgID": "map31_m_m_EP08_HIRUKO_02_003",
        "msgStr": "NULL"
      },
      {
        "msgID": "MAP31_M_L0004",
        "msgStr": "> Onları ortadan kaldır?"
      },
      {
        "msgID": "map31_m_m_akuma01_004",
        "msgStr": "Incubus"
      },
      {
        "msgID": "MAP31_M_L0005",
        "msgStr": "Vuhuu, çok eğlenceliydi! Süzülen Hiruko'lara binmeye bayılıyorum!"
      },
      {
        "msgID": "MAP31_M_L0006",
        "msgStr": "Ama insanlar bunca Hiruko ile ne yapmak istiyor ki? Harbiden çok tuhaf tipler."
      },
      {
        "msgID": "map31_m_m_akuma02_005",
        "msgStr": "Incubus"
      },
      {
        "msgID": "MAP31_M_L0007",
        "msgStr": "......"
      },
      {
        "msgID": "MAP31_M_L0008",
        "msgStr": "Onun için de \"Vay anasını be\" demeli miyim?"
      },
      {
        "msgID": "MAP31_M_L0009",
        "msgStr": "Bilmiyorum ki. Yani... sonuçta o bir böcek, değil mi?"
      },
      {
        "msgID": "map31_m_m_akuma02_01_006",
        "msgStr": "Okiku-Mushi"
      },
      {
        "msgID": "MAP31_M_L0010",
        "msgStr": "Hiruko'ların da duyguları vardır tatlım."
      },
      {
        "msgID": "MAP31_M_L0011",
        "msgStr": "Bu yüzden gelenin sen mi yoksa iblislerin mi olduğuna bağlı olarak <COLOR 3>farklı yerlere götürülürsün<COLOR 0>."
      },
      {
        "msgID": "map31_m_m_akuma02_02_007",
        "msgStr": "Okiku-Mushi"
      },
      {
        "msgID": "MAP31_M_L0012",
        "msgStr": "Şuradaki hazineyi görüyor musun? Onu tek başına alabileceğinden pek emin değilim."
      },
      {
        "msgID": "map31_m_m_akuma02_03_008",
        "msgStr": "Okiku-Mushi"
      },
      {
        "msgID": "MAP31_M_L0013",
        "msgStr": "Ah, ama merak etme şekerim, sen halledersin. Hiruko'ların duygularından anlıyorsun."
      },
      {
        "msgID": "MAP31_M_L0014",
        "msgStr": "Tek yapman gereken suyuna gitmek; o zaman seni sırtlarında taşırlar."
      },
      {
        "msgID": "map31_m_m_akuma03_01_009",
        "msgStr": "NULL"
      },
      {
        "msgID": "MAP31_M_L0015",
        "msgStr": "> İblis uzaklara dalıp gitmiş..."
      },
      {
        "msgID": "map31_m_m_akuma03_02_010",
        "msgStr": "Thoth"
      },
      {
        "msgID": "MAP31_M_L0016",
        "msgStr": "Gece gündüz durmadan düşüp duruyorum. Ne yorucu bir numara ama..."
      },
      {
        "msgID": "MAP31_M_L0017",
        "msgStr": "Üstelik arkadaşımı da bulamıyorum! Her şey çok iç karartıcı değil mi? Ühü..."
      },
      {
        "msgID": "map31_m_m_akuma03_03_011",
        "msgStr": "Thoth"
      },
      {
        "msgID": "MAP31_M_L0018",
        "msgStr": "Memleket hasreti çekiyor olmalıyım. Mısır'daki hayatımı düşünmeden edemiyorum."
      },
      {
        "msgID": "map31_m_m_akuma04_01_012",
        "msgStr": "Muu Shuwuu"
      },
      {
        "msgID": "MAP31_M_L0019",
        "msgStr": "Kih kih kih!"
      },
      {
        "msgID": "MAP31_M_L0020",
        "msgStr": "Bu Hiruko'nun üstüne atladığımda beni her yere götürüyor!"
      },
      {
        "msgID": "map31_m_m_akuma04_02_013",
        "msgStr": "Muu Shuwuu"
      },
      {
        "msgID": "MAP31_M_L0021",
        "msgStr": "Gerçi bu Hiruko..."
      },
      {
        "msgID": "MAP31_M_L0022",
        "msgStr": "<COLOR 3>İnsanlardan pek hoşlanmaz<COLOR 0>, o yüzden bir insan binmeye çalışırsa başka bir yere gider."
      },
      {
        "msgID": "map31_m_m_akuma05_01_014",
        "msgStr": "Naga Raja"
      },
      {
        "msgID": "MAP31_M_L0023",
        "msgStr": "Off, burası berbat bir yer..."
      },
      {
        "msgID": "MAP31_M_L0024",
        "msgStr": "Bu Hiruko'lar iblis ya da insan olmana göre seni farklı yerlere götürüyor."
      },
      {
        "msgID": "map31_m_m_akuma05_02_015",
        "msgStr": "Naga Raja"
      },
      {
        "msgID": "MAP31_M_L0025",
        "msgStr": "Ahbabım yukarı çıkmak istedi, ben de onu oraya fırlattım ama hâlâ dönmedi!"
      },
      {
        "msgID": "MAP31_M_L0026",
        "msgStr": "Off, bu iş cidden çok can sıkıcı..."
      },
