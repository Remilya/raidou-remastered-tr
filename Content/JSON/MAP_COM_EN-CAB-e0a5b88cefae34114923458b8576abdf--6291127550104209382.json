      },
      {
        "msgID": "MAP_COM_L0168",
        "msgStr": "> Aril Yarığı temizlensin mi?"
      },
      {
        "msgID": "MAP_COM_L0169",
        "msgStr": "Evet"
      },
      {
        "msgID": "MAP_COM_L0170",
        "msgStr": "Hayır"
      },
      {
        "msgID": "map_com_MAP_KIRETSU_002",
        "msgStr": "Gouto"
      },
      {
        "msgID": "MAP_COM_L0171",
        "msgStr": "Raidou, Aril Yarığı'nın ötesinde gücü seninkini katbekat aşan bir iblis seziyorum. Yine de onu temizlemek istiyor musun?"
      },
      {
        "msgID": "map_com_MAP_KIRETSU_003",
        "msgStr": "Gouto"
      },
      {
        "msgID": "MAP_COM_L0172",
        "msgStr": "O halde sana engel olmayacağım. Tetikte ol."
      },
      {
        "msgID": "map_com_MAP_KIRETSU_004",
        "msgStr": "Gouto"
      },
      {
        "msgID": "MAP_COM_L0173",
        "msgStr": "Raidou, bu çatlak Karanlık Diyar'a bağlanıyor. İblis Çağırıcıları tarafından Aril Yarığı olarak bilinen bir ucubeliktir."
      },
      {
        "msgID": "MAP_COM_L0174",
        "msgStr": "İçeride pusuya yatmış iblisleri alt edersen Aril Yarığı'nı temizleyebilirsin."
      },
      {
        "msgID": "MAP_COM_L0175",
        "msgStr": "Ancak bu temizlik yalnızca geçicidir. Birkaç gün sonra yarık tekrar ortaya çıkacaktır."
      },
      {
        "msgID": "MAP_COM_L0176",
        "msgStr": "Başkent'i korumaya ant içmiş bir Kuzunoha olarak onları başıboş bırakmamak en iyisidir. Vakit buldukça icaplarına bakmayı unutma."
      },
      {
        "msgID": "map_com_MAP_KIRETSU_004_01",
        "msgStr": "NULL"
      },
      {
        "msgID": "MAP_COM_L0177",
        "msgStr": "ER100"
      },
      {
        "msgID": "MAP_COM_L0178",
        "msgStr": "ER100"
      },
      {
        "msgID": "map_com_MAP_KIRETSU_004_02",
        "msgStr": "Gouto"
      },
      {
        "msgID": "MAP_COM_L0179",
        "msgStr": "Aril Yarıklarının nasıl işlediğini şimdi anladın mı?"
      },
      {
        "msgID": "map_com_MAP_KIRETSU_005",
        "msgStr": "Gouto"
      },
      {
        "msgID": "MAP_COM_L0180",
        "msgStr": "Güzel, o halde gidelim."
      },
      {
        "msgID": "map_com_MAP_KIRETSU_006",
        "msgStr": "Gouto"
      },
      {
        "msgID": "MAP_COM_L0181",
        "msgStr": "Bu bilgi İblis Çağırıcıları için hayati önem taşır. Dikkatle dinle."
      },
      {
        "msgID": "map_com_MAP_KIRETSU_007",
        "msgStr": "NULL"
      },
      {
        "msgID": "MAP_COM_L0182",
        "msgStr": "> Raidou, eşsiz Aril Yarıklarından <V 0> tanesini temizledi!"
      },
      {
        "msgID": "MAP_COM_L0183",
        "msgStr": "> İsimsiz Tapınak'taki sol tilki heykeli bir ödül hazırladı."
      },
      {
        "msgID": "MAP_COM_L0184",
        "msgStr": "> Raidou, Başkent'teki tüm eşsiz Aril Yarıklarını temizledi!"
      },
      {
        "msgID": "MAP_COM_L0185",
        "msgStr": "> İsimsiz Tapınak'taki sol tilki heykeli bir ödül hazırladı."
      },
      {
        "msgID": "map_com_MAP_KIRETSU_008",
        "msgStr": "Gouto"
      },
      {
        "msgID": "MAP_COM_L0186",
        "msgStr": "Mmm, İblis Çağırıcısı ve Başkent'in koruyucusu Raidou Kuzunoha'dan da beklediğim buydu."
      },
      {
        "msgID": "MAP_COM_L0187",
        "msgStr": "Kuzunoha klanına mensup bir diğeri olarak çıkardığın işle gurur duyuyorum."
      },
      {
        "msgID": "MAP_COM_L0188",
        "msgStr": "Oh? Yine başardın demek, öyle mi?"
      },
      {
        "msgID": "MAP_COM_L0189",
        "msgStr": "Bununla birlikte sayısız Başkent sakinini bitmek bilmeyen iblis tehdidinden kurtardığına şüphe yok."
      },
      {
        "msgID": "MAP_COM_L0190",
        "msgStr": "Halkı koruma çabalarına devam edeceğini umuyorum, Ondördüncü."
      },
      {
