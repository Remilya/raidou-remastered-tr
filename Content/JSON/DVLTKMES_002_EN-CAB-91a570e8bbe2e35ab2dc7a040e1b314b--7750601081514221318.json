        "msgStr": "Belki de değilimdir..."
      },
      {
        "msgID": "DVLTKMES_002_L0070",
        "msgStr": "İşi profesyonel tutalım."
      },
      {
        "msgID": "DVLTKMES_002_L0071",
        "msgStr": "Sana katıldıktan sonra benim çıkarım ne olacak?"
      },
      {
        "msgID": "DVLTKMES_002_L0072",
        "msgStr": "Seni güçlendireceğim."
      },
      {
        "msgID": "DVLTKMES_002_L0073",
        "msgStr": "Seni çalıştıracağım."
      },
      {
        "msgID": "DVLTKMES_002_L0074",
