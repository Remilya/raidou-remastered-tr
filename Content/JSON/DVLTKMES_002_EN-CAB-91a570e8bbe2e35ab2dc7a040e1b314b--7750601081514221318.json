      },
      {
        "msgID": "DVLTKMES_002_L0075",
        "msgStr": "Sen dedektifsin, değil mi?"
      },
      {
        "msgID": "DVLTKMES_002_L0076",
        "msgStr": "Neden etrafta dolaşıp davaları çözüyorsun?"
