      },
      {
        "msgID": "DVLTKMES_002_L0047",
        "msgStr": "Hemen adını söyle, seni pislik!"
      },
      {
        "msgID": "DVLTKMES_002_L0048",
        "msgStr": "14. Raidou Kuzunoha."
      },
      {
        "msgID": "DVLTKMES_002_L0049",
        "msgStr": "<NAME 0>."
      },
      {
        "msgID": "DVLTKMES_002_L0050",
        "msgStr": "Söylemem."
      },
      {
        "msgID": "DVLTKMES_002_L0051",
        "msgStr": "Demek sıska bir insan iblisleri kullanmak istiyor, ha?"
      },
      {
        "msgID": "DVLTKMES_002_L0052",
        "msgStr": "Doğru, istiyorum."
      },
      {
        "msgID": "DVLTKMES_002_L0053",
        "msgStr": "Hayır, istemiyorum."
      },
      {
        "msgID": "DVLTKMES_002_L0054",
        "msgStr": "O kadar da kötü olmayacak."
      },
      {
        "msgID": "DVLTKMES_002_L0055",
        "msgStr": "Bir insandan emir almam ben. Beni şimdiden öldürsen daha iyi!"
      },
      {
        "msgID": "DVLTKMES_002_L0056",
        "msgStr": "Öyle olsun."
      },
      {
        "msgID": "DVLTKMES_002_L0057",
        "msgStr": "Bunu yapmayacağım."
      },
      {
        "msgID": "DVLTKMES_002_L0058",
        "msgStr": "Sakin ol biraz."
      },
      {
        "msgID": "DVLTKMES_002_L0059",
        "msgStr": "Gerçekten bana patronluk taslayabileceğini mi sanıyorsun?"
      },
      {
        "msgID": "DVLTKMES_002_L0060",
        "msgStr": "Evet."
      },
      {
        "msgID": "DVLTKMES_002_L0061",
        "msgStr": "Sanırım hayır."
      },
      {
        "msgID": "DVLTKMES_002_L0062",
        "msgStr": "Senin patron olmanı tercih ederim."
      },
      {
        "msgID": "DVLTKMES_002_L0063",
        "msgStr": "Benim için planların ne bakalım, ha?"
      },
      {
        "msgID": "DVLTKMES_002_L0064",
        "msgStr": "Omuz omuza savaşacağız."
      },
      {
        "msgID": "DVLTKMES_002_L0065",
        "msgStr": "Evcil hayvanım olacaksın."
      },
      {
        "msgID": "DVLTKMES_002_L0066",
        "msgStr": "Seni füzyon için kullanacağım."
      },
      {
        "msgID": "DVLTKMES_002_L0067",
        "msgStr": "Benim gibi bir iblisle takılmak istediğine emin misin?"
      },
      {
        "msgID": "DVLTKMES_002_L0068",
        "msgStr": "Gönder gelsin."
      },
      {
