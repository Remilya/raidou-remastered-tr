      {
        "msgID": "GOH_BIRTH_L0155",
        "msgStr": "Ben <COLOR 4><V 0><COLOR 0>! <COLOR 4><V 4><COLOR 0> Düzeni'ne a-hee-itim, ho!"
      },
      {
        "msgID": "GOH_BIRTH_L0156",
        "msgStr": "<COLOR 0>Tanıştığımıza me-hee-mnun oldum, ho!"
