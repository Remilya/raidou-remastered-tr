      },
      {
        "msgID": "GOH_BIRTH_L0153",
        "msgStr": "Ben <COLOR 4><V 0><COLOR 0>! <COLOR 4><V 4><COLOR 0> Düzeni'ne a-hee-itim, ho!"
      },
      {
        "msgID": "GOH_BIRTH_L0154",
        "msgStr": "<COLOR 0>Tüm düşmanlarımıza deh-hee-şet saçacağım, ho!"
