      },
      {
        "msgID": "E651_001_L0000",
        "msgStr": "Meiji Restorasyonu'nun üzerinden 60 yıldan fazla zaman geçti.\n<mw 180>"
      },
      {
        "msgID": "e651_001_e651_02_001",
        "msgStr": "NULL"
      },
      {
        "msgID": "E651_001_L0001",
        "msgStr": "Bir zamanlar Edo olarak bilinen Başkent...\nEh, hızla büyüdüğünü söylemek yeterli.\n<mw 180>"
      },
      {
        "msgID": "e651_001_e651_03_002",
        "msgStr": "NULL"
      },
      {
        "msgID": "E651_001_L0002",
        "msgStr": "Bugünlerde her şey modern olmakla ilgili.\nPara ve bilim kral olmuş durumda.\n<mw 180>"
      },
      {
        "msgID": "e651_001_e651_04_003",
        "msgStr": "NULL"
      },
      {
        "msgID": "E651_001_L0003",
        "msgStr": "Kimsenin kalbinde ruhlara, tanrılara\nve doğaüstü olaylara yer yok.\n<mw 180>"
      },
      {
        "msgID": "e651_001_e651_05_004",
        "msgStr": "NULL"
      },
      {
        "msgID": "E651_001_L0004",
        "msgStr": "Ama sakın yanılmayın.\n<mw 180>"
      },
      {
        "msgID": "e651_001_e651_06_005",
        "msgStr": "NULL"
      },
      {
        "msgID": "E651_001_L0005",
        "msgStr": "Bugün bile gölgelerde pusuya yatmış,\nbizi izleyip halimize gülüyorlar.\n<mw 180>"
      },
      {
        "msgID": "e651_001_e651_07_006",
        "msgStr": "NULL"
      },
      {
        "msgID": "E651_001_L0006",
        "msgStr": "Ama burada, Taisho döneminde—bu tür işlerde\nuzmanlaşmış tek dedektifler biziz.\n<mw 180>"
      },
      {
        "msgID": "e651_001_e651_08_007",
        "msgStr": "ER100"
      },
      {
        "msgID": "E651_001_L0007",
        "msgStr": "ER100"
      },
      {
        "msgID": "e651_001_e651_08_008",
