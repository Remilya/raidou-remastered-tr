      },
      {
        "msgID": "E651_001_L0008",
        "msgStr": "ER100"
      },
      {
        "msgID": "E651_001_L0009",
        "msgStr": "Sakuradayama Radyosu'nu dinliyorsunuz.\n<mw 181>"
      },
      {
        "msgID": "E651_001_L0010",
        "msgStr": "Dün sabahın erken saatlerinde, açıklanamayan bir kayıp vakasının daha yaşandığı bildirildi.\n<mw 280>"
      },
      {
        "msgID": "E651_001_L0011",
        "msgStr": "Bu olay, süregelen tuhaf hadiseler zincirinin son halkası.\n<mw 270>"
      },
      {
        "msgID": "E651_001_L0012",
        "msgStr": "Görgü tanıkları, olay yerinde kırmızı pelerinli tuhaf bir canavar gördüklerini bildirdi.\n<mw 320>"
      },
      {
        "msgID": "E651_001_L0013",
        "msgStr": "Yerel yetkililer arama çalışmalarını sürdürürken…"
      },
      {
        "msgID": "e651_002_e651_02_000",
        "msgStr": "Narumi"
      },
      {
        "msgID": "E651_002_L0000",
        "msgStr": "Yapacak daha iyi bir iş yok.<mw 80> Görünüşe göre bu davaya biz bakıyoruz, Raidou.\n<mw 180>"
      },
