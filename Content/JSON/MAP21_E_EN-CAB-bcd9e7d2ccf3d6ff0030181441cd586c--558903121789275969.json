      },
      {
        "msgID": "MAP21_E_L0010",
        "msgStr": "Sen de güçlü görünüyorsun. Bir başka ben hakkında bunu söyleyebildiğime sevindim.\n<lips_stop>"
      },
      {
        "msgID": "MAP21_E_L0011",
        "msgStr": "<lips 21 5>"
      },
      {
        "msgID": "MAP21_E_L0012",
        "msgStr": "Yatagarasu seninle etkileşimimi en aza indirmemi tavsiye etti, bu yüzden çok şey söyleyemem ama beni dinle.\n<lips_stop>"
      },
      {
        "msgID": "MAP21_E_L0013",
