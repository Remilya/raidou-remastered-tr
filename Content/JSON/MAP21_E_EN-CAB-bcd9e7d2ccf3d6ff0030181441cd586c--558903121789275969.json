      },
      {
        "msgID": "MAP21_E_L0014",
        "msgStr": "Bu zaman çizgisinde, birkaç nesil sonraki gelecekten gelen ve bir kızın bilincini ele geçirmeye çalışan bir Raidou var.\n<lips_stop>"
      },
      {
        "msgID": "MAP21_E_L0021",
        "msgStr": "<lips 21 5>"
      },
      {
        "msgID": "MAP21_E_L0022",
