      {
        "msgID": "E690_004_L0004",
        "msgStr": "[dua mırıldanır]"
      },
      {
        "msgID": "E690_004_L0005",
        "msgStr": "Ortaya çık!"
      },
      {
        "msgID": "e690_004_e690_004_001_000",
        "msgStr": "Ukobach"
      },
      {
        "msgID": "E690_004_L0000",
        "msgStr": "Pekâlâ. Artık bu işte sonuna kadar varım. O yüzden önemli yerlerde beni sahaya sürsen iyi edersin, duydun mu!?\n<mw 180>"
      },
      {
        "msgID": "e690_005_e690_005_001_000",
        "msgStr": "Köy Muhtarı"
      },
      {
        "msgID": "E690_005_L0000",
        "msgStr": "Köy, bu vesileyle sana şu adı bahşediyor...\n<mw 180>"
      },
      {
        "msgID": "e690_005_e690_005_002_001",
        "msgStr": "Köy Muhtarı"
      },
      {
        "msgID": "E690_005_L0001",
        "msgStr": "<COLOR 1>Raidou Kuzunoha<COLOR 0>!\n<mw 180>"
      },
      {
        "msgID": "e690_005_e690_005_003_002",
        "msgStr": "Köy Muhtarı"
      },
      {
        "msgID": "E690_005_L0002",
        "msgStr": "<COLOR 0>Bu adı taşıyan <COLOR 1>ondördüncü<COLOR 0> kişisin!\n<mw 180>"
      },
      {
        "msgID": "e690_005_e690_005_004_003",
        "msgStr": "Köy Muhtarı"
      },
      {
        "msgID": "E690_005_L0003",
        "msgStr": "Doğum adın olan <NAME 0>,\nköyde kalacak.\n<mw 180>"
      },
      {
        "msgID": "e690_005_e690_005_005_004",
        "msgStr": "Köy Muhtarı"
      },
      {
        "msgID": "E690_005_L0004",
        "msgStr": "Şu andan itibaren, Ondördüncü Raidou Kuzunoha olacaksın.\n<mw 180>"
      },
      {
        "msgID": "e690_005_e690_005_006_005",
        "msgStr": "Köy Muhtarı"
      },
      {
        "msgID": "E690_005_L0005",
        "msgStr": "İblis Çağırıcısı, Başkent senin ellerinde!\n<mw 180>"
      },
      {
        "msgID": "e690_005_e690_005_007_006",
        "msgStr": "Köy Muhtarı"
      },
      {
        "msgID": "E690_005_L0006",
        "msgStr": "Ancak bu yükü tek başına sırtlamayacaksın.\n<mw 180>"
      },
      {
        "msgID": "e690_005_e690_005_008_007",
        "msgStr": "Köy Muhtarı"
      },
      {
        "msgID": "E690_005_L0007",
        "msgStr": "<COLOR 1>Gouto-Douji<COLOR 0>, öne çık!\n<mw 120>"
      },
      {
        "msgID": "e690_005_e690_005_009_008",
        "msgStr": "Kara Kedi"
      },
      {
        "msgID": "E690_005_L0008",
        "msgStr": "Demek sıradaki Raidou bu çocuk, öyle mi?\n<mw 180>"
      },
      {
        "msgID": "e690_005_e690_005_010_009",
        "msgStr": "Kara Kedi"
      },
      {
        "msgID": "E690_005_L0009",
        "msgStr": "Eh, köyün arzusu buysa öyle olsun.\n<mw 120>"
      },
      {
        "msgID": "e690_005_e690_005_011_010",
        "msgStr": "Kara Kedi"
      },
      {
        "msgID": "E690_005_L0010",
        "msgStr": "Pekâlâ, bana Gouto diyebilirsin.\n<mw 120>"
      },
      {
        "msgID": "e690_005_e690_005_012_011",
        "msgStr": "Gouto"
      },
      {
        "msgID": "E690_005_L0011",
        "msgStr": "Tanıştığımıza memnun oldum, Ondördüncü Raidou.\n<mw 180>"
      },
      {
        "msgID": "e690_005_e690_005_013_012",
        "msgStr": "NULL"
      },
      {
        "msgID": "E690_005_L0012",
        "msgStr": "> Ve böylece <NAME 0> adlı gencin yolculuğu—"
      },
      {
        "msgID": "E690_005_L0013",
        "msgStr": "> Daha doğrusu, Ondördüncü Raidou Kuzunoha'nın yolculuğu, o ve Gouto köyden ayrılırken başladı."
      },
      {
        "msgID": "e696_001_e696_001_001_000",
        "msgStr": "Gizemli Ses"
      },
      {
        "msgID": "E696_001_L0000",
        "msgStr": "Ra...do... on... dör...cü...\n<mw 100>"
      },
      {
        "msgID": "e696_001_e696_001_002_001",
        "msgStr": "Gizemli Ses"
      },
      {
        "msgID": "E696_001_L0001",
        "msgStr": "Ondördüncü Raidou Kuzunoha!\n<mw 100>"
      },
      {
        "msgID": "e696_001_e696_001_003_002",
        "msgStr": "Gizemli Ses"
      },
      {
        "msgID": "E696_001_L0002",
        "msgStr": "<mw 100>"
      },
      {
        "msgID": "e696_001_e696_001_004_003",
        "msgStr": "Gizemli Ses"
      },
      {
        "msgID": "E696_001_L0003",
        "msgStr": "Ne kadar utanç verici! <mw 80>Bizi büyük bir hayal kırıklığına uğrattın.\n<mw 80>"
      },
      {
        "msgID": "e696_001_e696_001_005_004",
        "msgStr": "Gizemli Ses"
      },
      {
        "msgID": "E696_001_L0004",
        "msgStr": "Yeteneklerin—seleflerinin yanında çok sönük kalıyor!\n<mw 120>"
      },
      {
        "msgID": "e696_001_e696_001_006_005",
        "msgStr": "Gizemli Ses"
      },
      {
        "msgID": "E696_001_L0005",
        "msgStr": "Seni sıradaki Raidou Kuzunoha ilan etmek vahim bir hata olur.\n<mw 120>"
      },
      {
        "msgID": "e696_001_e696_001_007_006",
        "msgStr": "Gizemli Ses"
      },
      {
        "msgID": "E696_001_L0006",
        "msgStr": "Başka seçeneğimiz yok. Raidou'nun kutsal adına leke sürdün.\n<mw 100>"
      },
      {
        "msgID": "e696_001_e696_001_008_007",
        "msgStr": "Gizemli Ses"
      },
      {
        "msgID": "E696_001_L0007",
