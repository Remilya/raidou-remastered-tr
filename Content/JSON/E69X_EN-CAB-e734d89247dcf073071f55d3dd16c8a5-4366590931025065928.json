        "msgStr": "Ses"
      },
      {
        "msgID": "E690_001_L0002",
        "msgStr": "Aynı şekilde, insanın olduğu yerde karanlık da vardır.<mw 100>\nBiz o karanlığı yok etmek için varız.\n<mw 150>"
      },
      {
        "msgID": "e690_001_e690_001_004_003",
