      },
      {
        "msgID": "MAP16_M_L0047",
        "msgStr": "Evet, aldığın eğitim kesinlikle meyvesini vermiş."
      },
      {
        "msgID": "MAP16_M_L0048",
        "msgStr": "Kendine ait bir iblisi yönetmenin vakti geldi."
      },
      {
        "msgID": "MAP16_M_L0049",
        "msgStr": "Buraya bir iblis salınacak. Köyün bariyeri içinde tehlike az olsa da yine de tetikte ol."
      },
      {
        "msgID": "MAP16_M_L0049_01",
        "msgStr": "İlk olarak <NAME 0>, hapsedilme sanatını kullanmana izin vereceğiz."
      },
      {
        "msgID": "MAP16_M_L0049_02",
        "msgStr": "Şimdi, iblisi müttefikin yap."
      },
      {
        "msgID": "map16_m_mplan_ep00_akuma01_017",
        "msgStr": "İblis"
      },
      {
        "msgID": "MAP16_M_L0050",
        "msgStr": "Hım?"
      },
      {
        "msgID": "MAP16_M_L0051",
        "msgStr": "Hey, Cehennem'in kazanlarını harlayan belalı Ukobach'ı, yani beni bu çöplüğe çağırmanın amacı ne?"
      },
      {
        "msgID": "map16_m_mplan_ep00_akuma01_017_01",
        "msgStr": "Ukobach"
      },
      {
        "msgID": "MAP16_M_L0052",
        "msgStr": "Dur bakalım, beni müttefikin yapmaya çalışmayı düşünmüyorsun, değil mi?"
      },
      {
        "msgID": "map16_m_mplan_ep00_akuma02_018",
        "msgStr": "Ukobach"
      },
      {
        "msgID": "MAP16_M_L0053",
        "msgStr": "Hyahahaha! İyi şakaydı evlat."
      },
      {
        "msgID": "MAP16_M_L0054",
        "msgStr": "Ama ne var biliyor musun? Yürekli olduğunu kabul edeceğim."
      },
      {
        "msgID": "MAP16_M_L0055",
        "msgStr": "Gücümü o kadar çok istiyorsan gel de al bakalım!"
      },
      {
        "msgID": "map16_m_mplan_ep00_akuma03_019",
        "msgStr": "Ukobach"
      },
      {
        "msgID": "MAP16_M_L0056",
        "msgStr": "Hyahahaha! Elbette düşünmüyorsundur!"
      },
      {
        "msgID": "MAP16_M_L0057",
        "msgStr": "Senin gibi muhallebi çocuğu bir serseri benimle oynarken donunu kirletir."
      },
      {
        "msgID": "MAP16_M_L0058",
        "msgStr": "Ama bir iblisi boşuna çağırmadın, değil mi?"
      },
      {
        "msgID": "MAP16_M_L0059",
        "msgStr": "O zaman biraz takılıp havai fişeklerin tadını çıkarmaya ne dersin!?"
      },
      {
        "msgID": "MAP16_M_L0060",
        "msgStr": "Evet, düşünüyorum."
      },
