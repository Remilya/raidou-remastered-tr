      },
      {
        "msgID": "MAP16_M_L0031",
        "msgStr": "Bir iblisi başarıyla evcilleştirdin. Böylece ilk adım tamamlandı."
      },
      {
        "msgID": "map16_m_mplan_ep00_setumei03_AFTER_011",
        "msgStr": "Köy Muhtarı"
      },
      {
        "msgID": "MAP16_M_L0031_01",
        "msgStr": "Hapsedilme sanatı, bir iblisi müttefikin hâline getirebileceğin tekniktir."
      },
      {
        "msgID": "MAP16_M_L0033",
