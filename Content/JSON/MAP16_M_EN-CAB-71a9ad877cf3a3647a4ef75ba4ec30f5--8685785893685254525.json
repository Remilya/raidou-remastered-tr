      {
        "msgID": "map16_m_mplan_ep00_koe01_003",
        "msgStr": "Köy Muhtarı"
      },
      {
        "msgID": "MAP16_M_L0004",
        "msgStr": "Sorun nedir? Cesaretini mi kaybettin?"
      },
      {
        "msgID": "MAP16_M_L0005",
        "msgStr": "Bir İblis Çağırıcısı olarak gücünü göstermeden buradan ayrılmana izin yok."
      },
      {
        "msgID": "MAP16_M_L0006",
        "msgStr": "Şimdi, ilerle."
      },
      {
        "msgID": "map16_m_mplan_ep00_koe02_004",
        "msgStr": "Ses"
      },
      {
        "msgID": "MAP16_M_L0007",
        "msgStr": "Ben Kuzunoha köyünün muhtarıyım."
      },
      {
        "msgID": "MAP16_M_L0008",
        "msgStr": "Durduğun yer Kuzunoha Eğitim Salonu."
      },
      {
        "msgID": "map16_m_mplan_ep00_koe02__005",
        "msgStr": "Köy Muhtarı"
      },
      {
        "msgID": "MAP16_M_L0009",
        "msgStr": "<NAME 0>, köyün eğitimine göğüs gererek ve bu rol için aday statüsüne yükselerek iyi iş çıkardın."
      },
      {
        "msgID": "MAP16_M_L0010",
        "msgStr": "Biz, Kuzunoha klanı olarak karanlıktaki canavarlarla mücadele ettik ve 1.300 yıl boyunca oluşturdukları tehdidi bertaraf ettik."
      },
      {
        "msgID": "MAP16_M_L0011",
        "msgStr": "Birazdan gireceğin sınav, saygın saflarımıza katılmaya uygun olup olmadığını belirleyecek."
      },
      {
        "msgID": "MAP16_M_L0012",
        "msgStr": "Bu yüzden soruyorum..."
      },
      {
        "msgID": "MAP16_M_L0013",
        "msgStr": "Bir İblis Çağırıcısının hayatını sürmeye hazır mısın?"
      },
      {
        "msgID": "map16_m_mmplan_ep00_Select SEL_001",
        "msgStr": "NULL"
      },
      {
        "msgID": "MAP16_M_L0013_01",
        "msgStr": "Hazırım."
      },
      {
        "msgID": "MAP16_M_L0013_02",
        "msgStr": "İblis Çağırıcısı nedir?"
      },
      {
        "msgID": "map16_m_mplan_ep00_koe02__006",
        "msgStr": "Köy Muhtarı"
      },
      {
        "msgID": "MAP16_M_L0013_03",
        "msgStr": "Savaştığımız canavarlar \"iblis\" olarak bilinir."
      },
      {
        "msgID": "MAP16_M_L0013_04",
        "msgStr": "İblisler büyük bir zekâya ve güce sahiptir. Bu özelliklerini insanlığı avlamak, hem et hem de ruhla ziyafet çekmek için kullanırlar."
      },
      {
        "msgID": "MAP16_M_L0013_05",
        "msgStr": "Toplumumuzun huzurunu tehdit eden aşağılık ucubelerdir."
      },
      {
        "msgID": "MAP16_M_L0013_06",
        "msgStr": "Kuzunoha'lar bu tehditle mücadele etmek için çivi çiviyi söker anlayışıyla bizzat iblisleri evcilleştirip onlara hükmeder."
      },
      {
        "msgID": "MAP16_M_L0013_07",
        "msgStr": "İblislerin kudretini kullanarak onların aşağılık soydaşlarını katletmek; İblis Çağırıcısı olmanın anlamı budur."
      },
      {
        "msgID": "map16_m_mplan_ep00_koe02__007",
        "msgStr": "Köy Muhtarı"
      },
      {
        "msgID": "MAP16_M_L0013_08",
        "msgStr": "Çok güzel. Bu kararlılığını koruyacağına güveniyorum."
      },
      {
        "msgID": "MAP16_M_L0013_09",
        "msgStr": "Şimdi sınavı başlatacağız."
      },
      {
        "msgID": "MAP16_M_L0013_10",
        "msgStr": "Bu sınava girecek son aday sen olacaksın. Şu ana kadar kimse başarılı olamadı."
      },
      {
        "msgID": "MAP16_M_L0013_11",
        "msgStr": "ER100"
      },
      {
        "msgID": "MAP16_M_L0013_12",
        "msgStr": "ER100"
      },
      {
        "msgID": "MAP16_M_L0014",
        "msgStr": "Umarım en azından hayatta kalırsın."
      },
      {
        "msgID": "map16_m_mplan_ep00_setumei01_006",
        "msgStr": "Köy Muhtarı"
      },
      {
        "msgID": "MAP16_M_L0015",
        "msgStr": "İlk olarak kılıç becerilerini sergile."
      },
      {
        "msgID": "MAP16_M_L0016",
        "msgStr": "ER100"
      },
      {
        "msgID": "MAP16_M_L0017",
        "msgStr": "Bu sınavda yozlaşmayla dolu kuklalar düşmanın olacak. Onları tereddüt etmeden yere ser."
      },
      {
        "msgID": "MAP16_M_L0018",
        "msgStr": "ER100"
      },
      {
        "msgID": "map16_m_mplan_ep00_setumei02_007",
        "msgStr": "Köy Muhtarı"
      },
      {
        "msgID": "MAP16_M_L0019",
        "msgStr": "Sırada nişancılığını sergileyeceksin."
      },
      {
        "msgID": "MAP16_M_L0020",
        "msgStr": "Saf gümüşten mermiler iblislere yeterince zarar verir. Sakinliğini koru, aksi takdirde hedeflerine ulaşamamaları kaçınılmaz olur."
      },
      {
        "msgID": "MAP16_M_L0021",
        "msgStr": "Kendini topla ve mermilerinin düşmanlarını delip geçmesine izin ver."
      },
      {
        "msgID": "MAP16_M_L0022",
        "msgStr": "ER100"
      },
      {
        "msgID": "MAP16_M_L0023",
        "msgStr": "ER100"
