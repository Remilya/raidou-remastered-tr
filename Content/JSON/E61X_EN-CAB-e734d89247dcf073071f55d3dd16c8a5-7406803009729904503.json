      {
        "msgID": "e613_001_e613_001_01_000",
        "msgStr": "Rasputin"
      },
      {
        "msgID": "E613_001_L0000",
        "msgStr": "...Hayır, ciddiyim. Sen, ben ve muhteşem bir gece.\n<mw 180>"
      },
      {
        "msgID": "e613_001_e613_001_02_001",
        "msgStr": "Rasputin"
      },
      {
        "msgID": "E613_001_L0001",
        "msgStr": "Ne kadar harika olduğumu görecek—\n<mw 180>"
      },
      {
        "msgID": "e613_001_e613_001_03_002",
        "msgStr": "Rasputin"
      },
      {
        "msgID": "E613_001_L0002",
        "msgStr": "...Hm? Şimdi olmaz, meşgulüm.\n<mw 180>"
      },
      {
        "msgID": "e613_001_e613_001_04_003",
        "msgStr": "Rasputin"
      },
      {
        "msgID": "E613_001_L0003",
        "msgStr": "Khuy! <mw 40>Kaç kere söylemem gere— <mw 20>Gah!?\n<mw 120>"
      },
      {
        "msgID": "e613_001_e613_001_05_004",
        "msgStr": "Rasputin"
      },
      {
        "msgID": "E613_001_L0004",
        "msgStr": "Kusura bakma. <mw 20>Nerede kalmıştım—\n<mw 100>"
      },
      {
        "msgID": "e613_002_e613_002_01_000",
        "msgStr": "Victor"
      },
      {
        "msgID": "E613_002_L0000",
        "msgStr": "Muazzam! Tıpkı rüyalarımdaki gibi!\n<mw 180>"
      },
      {
        "msgID": "e613_002_e613_002_02_001",
        "msgStr": "Rasputin"
      },
      {
        "msgID": "E613_002_L0001",
        "msgStr": "Hm... Hey! Ne halt ettiğini sanıyorsun sen!?\n<mw 180>"
      },
      {
        "msgID": "e613_002_e613_002_03_002",
        "msgStr": "Victor"
      },
      {
        "msgID": "E613_002_L0002",
        "msgStr": "İhtişamının tadını çıkarıyorum.\n<mw 180>"
      },
      {
        "msgID": "e613_002_e613_002_04_003",
        "msgStr": "Victor"
      },
      {
        "msgID": "E613_002_L0003",
        "msgStr": "Ne kadar da nadide bir sanat eseri.\n<mw 180>"
      },
      {
        "msgID": "e613_002_e613_002_05_004",
        "msgStr": "Rasputin"
      },
      {
        "msgID": "E613_002_L0004",
        "msgStr": "...Hey!\n<mw 180>"
      },
      {
        "msgID": "e613_002_e613_002_06_005",
        "msgStr": "Rasputin"
      },
      {
        "msgID": "E613_002_L0005",
        "msgStr": "Orada bana dokunma! Yeter! Hey, çekil geri!\n<mw 150>"
      },
      {
        "msgID": "e613_002_e613_002_07_006",
        "msgStr": "Gouto"
      },
      {
        "msgID": "E613_002_L0006",
        "msgStr": "İkinizin işi bitti mi artık?\n<mw 120>"
      },
      {
        "msgID": "e613_002_e613_002_08_007",
        "msgStr": "Victor"
      },
      {
        "msgID": "E613_002_L0007",
        "msgStr": "...Afedersiniz. Kendimi biraz fazla kaptırmış olabilirim.\n<mw 140>"
      },
      {
        "msgID": "e613_002_e613_002_09_008",
        "msgStr": "Rasputin"
      },
      {
        "msgID": "E613_002_L0008",
        "msgStr": "İlahi, hiç mi utanman yok senin!?\n<mw 150>"
      },
      {
        "msgID": "e614_001_e614_001_01_000",
        "msgStr": "Raidou XL"
      },
      {
        "msgID": "E614_001_L0000",
        "msgStr": "Tanıştığımıza memnun oldum... gerçi\no şerefe daha önce erişmiştik.\n<mw 120>"
      },
      {
        "msgID": "e614_001_e614_001_02_001",
        "msgStr": "Raidou XL"
      },
      {
        "msgID": "E614_001_L0001",
        "msgStr": "Söyle bakalım, zamanda yolculuğun nasıl geçti?\n<mw 180>"
      },
      {
        "msgID": "e614_001_e614_001_03_002",
        "msgStr": "Raidou XL"
      },
      {
        "msgID": "E614_001_L0002",
        "msgStr": "İnsanoğlunun aptallığına kendi gözlerinle tanık oldun mu?\n<mw 180>"
      },
      {
        "msgID": "e614_002_e614_002_01_000",
        "msgStr": "Raidou XL"
      },
      {
        "msgID": "E614_002_L0000",
        "msgStr": "Benim zamanımda toplum çoktan mahvolmuş durumda.\n<mw 180>"
      },
      {
        "msgID": "e614_002_e614_002_02_001",
        "msgStr": "Raidou XL"
      },
      {
        "msgID": "E614_002_L0001",
        "msgStr": "Bir umutsuzluk döngüsüne hapsolmuş...\n<mw 120>"
      },
      {
        "msgID": "e614_002_e614_002_03_002",
        "msgStr": "Raidou XL"
      },
      {
        "msgID": "E614_002_L0002",
        "msgStr": "Ve geri dönüşü olmayan noktayı çoktan geçtik.\n<mw 180>"
      },
      {
        "msgID": "e614_002_e614_002_04_003",
        "msgStr": "Raidou XL"
      },
      {
        "msgID": "E614_002_L0003",
        "msgStr": "Her şeyi silip sıfırdan başlamaktan başka çarem yok.\n<mw 180>"
      },
      {
        "msgID": "e614_002_CC_00",
        "msgStr": "NULL"
      },
      {
        "msgID": "E614_002_L0004",
        "msgStr": "Hm!"
      },
      {
        "msgID": "E614_002_L0005",
        "msgStr": "Haaah!"
      },
      {
        "msgID": "E615_001_L0000",
        "msgStr": "Raidou...\n<mw 120>"
      },
      {
        "msgID": "e615_001_E615_001_02_000",
        "msgStr": "Narumi"
      },
      {
        "msgID": "E615_001_L0001",
        "msgStr": "Başımız... <mw 105>Başımız belada...\n<mw 120>"
      },
      {
        "msgID": "e615_001_E615_001_03_001",
        "msgStr": "Narumi"
      },
      {
        "msgID": "E615_001_L0002",
        "msgStr": "Başımız belada..."
      },
      {
        "msgID": "e616_001_e616_001_01_000",
        "msgStr": "Kaya"
      },
      {
        "msgID": "E616_001_L0000",
        "msgStr": "Neredeyim ben...?\n<mw 90>"
      },
      {
        "msgID": "e616_001_e616_001_02_001",
        "msgStr": "Kaya"
      },
      {
        "msgID": "E616_001_L0001",
        "msgStr": "Ha? Saçım... Saçlarım...\n<mw 120>"
      },
      {
        "msgID": "e616_001_e616_001_03_002",
        "msgStr": "Kaya"
      },
      {
        "msgID": "E616_001_L0002",
        "msgStr": "Ah... Demek rüya değilmiş.\n<mw 180>"
      },
      {
        "msgID": "e616_001_e616_001_04_003",
        "msgStr": "Kaya"
      },
      {
        "msgID": "E616_001_L0003",
        "msgStr": "Ama... rüya olmasını gerçekten çok isterdim.\n<mw 180>"
      },
      {
        "msgID": "e616_001_e616_001_05_004",
        "msgStr": "Kaya"
      },
      {
        "msgID": "E616_001_L0004",
        "msgStr": "Tamamen... karanlığın içindeydim. Çok korkunçtu.\n<mw 120>"
      },
      {
        "msgID": "e616_001_e616_001_06_005",
        "msgStr": "Kaya"
      },
      {
        "msgID": "E616_001_L0005",
        "msgStr": "Ama... <mw 30>Beni kurtaracağını biliyordum, Raidou. <mw 80>İçten içe biliyordum.\n<mw 180>"
      },
      {
        "msgID": "e616_001_e616_001_07_006",
        "msgStr": "Kaya"
      },
      {
        "msgID": "E616_001_L0006",
        "msgStr": "Ve kurtardın da. <mw 120>Gerçekten beni kurtardın.\n<mw 120>"
      },
      {
        "msgID": "e616_001_e616_001_08_007",
        "msgStr": "Kaya"
      },
      {
        "msgID": "E616_001_L0007",
        "msgStr": "Teşekkür ederim, <mw 60><NAME2N 0>... Çok teşekkür ederim.\n<mw 120>"
      },
      {
        "msgID": "e616_001_CC_00",
        "msgStr": "NULL"
      },
      {
        "msgID": "E616_001_L0008",
        "msgStr": "Ah...!"
      },
      {
        "msgID": "E616_001_L0009",
        "msgStr": "......"
      },
      {
        "msgID": "e617_001_e617_001_000",
        "msgStr": "Narumi"
      },
      {
        "msgID": "E617_001_L0000",
        "msgStr": "\"Felaket Kanto'yu Vurdu, <mw 40><mw 60>Gözler Yeniden İnşaya Çevrildi\"... Hm.\n<mw 180>"
      },
      {
        "msgID": "e617_001_e617_002_001",
        "msgStr": "Narumi"
      },
      {
        "msgID": "E617_001_L0001",
        "msgStr": "Vay be! Demek Yatagarasu'nun uydurduğu hikâye <IT_S>bu<IT_E>, ha?\n<mw 200>"
      },
      {
        "msgID": "e617_001_e617_003_002",
        "msgStr": "Narumi"
      },
      {
        "msgID": "E617_001_L0002",
        "msgStr": "Hey gidi, örtbas diye buna derim.\n<mw 140>"
      },
      {
        "msgID": "e617_001_e617_004_003",
        "msgStr": "Narumi"
      },
      {
        "msgID": "E617_001_L0003",
        "msgStr": "Düşünsene, bütün bunlar bir kızın bizden kendisini öldürmemizi istemesiyle başladı...\n<mw 180>"
      },
      {
        "msgID": "e617_001_e617_005_004",
        "msgStr": "Narumi"
      },
      {
        "msgID": "E617_001_L0004",
        "msgStr": "Ve bütün mesele bir zaman yolcusunun verdiği nutukla sona eriyor.\n<mw 180>"
      },
      {
        "msgID": "e617_001_e617_006_005",
        "msgStr": "Narumi"
      },
      {
        "msgID": "E617_001_L0005",
        "msgStr": "Sanırım uğruna savaşmaya değer bazı davalar gerçekten varmış.\n<mw 180>"
      },
      {
        "msgID": "e617_001_e617_007_006",
        "msgStr": "Narumi"
      },
      {
        "msgID": "E617_001_L0006",
        "msgStr": "Gelecek için hâlâ biraz umut olabilir.\n<mw 180>"
      },
      {
        "msgID": "e617_001_e617_008_007",
        "msgStr": "Narumi"
      },
      {
        "msgID": "E617_001_L0007",
        "msgStr": "Özetle durum bu, değil mi Raidou...?<mw 230>\nAh be dostum, anın içine ettin resmen.\n<mw 140>"
      },
      {
        "msgID": "e617_001_e617_009_008",
        "msgStr": "Narumi"
      },
      {
        "msgID": "E617_001_L0008",
        "msgStr": "Ah be dostum, anın içine ettin resmen.\n<mw 120>"
      },
      {
        "msgID": "e617_001_e617_010_009",
        "msgStr": "Narumi"
      },
      {
        "msgID": "E617_001_L0009",
        "msgStr": "Alo, Narumi Dedektiflik Bürosu.\n<mw 120>"
      },
      {
        "msgID": "e617_001_e617_011_010",
        "msgStr": "Narumi"
      },
      {
        "msgID": "E617_001_L0010",
        "msgStr": "Evet... <mw 40>Hı hı... <mw 40>Bilginiz olsun,\nbiz sadece özel davaları alıyoruz...\n<mw 180>"
      },
      {
        "msgID": "e617_001_CC_00",
        "msgStr": "NULL"
      },
      {
        "msgID": "E617_001_L0010_01",
        "msgStr": "Ha!?"
      },
      {
        "msgID": "e617_001_e617_012_011",
        "msgStr": "Narumi"
      },
      {
        "msgID": "E617_001_L0011",
        "msgStr": "Raidou, yeni bir dava var! Hadi gidelim!\n<mw 120>"
      },
