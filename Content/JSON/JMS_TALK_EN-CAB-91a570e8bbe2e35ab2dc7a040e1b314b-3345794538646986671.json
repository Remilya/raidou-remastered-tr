      {
        "msgID": "jms_talk_NARUMI_EP12_01_037",
        "msgStr": "Narumi"
      },
      {
        "msgID": "JMS_TALK_L0097",
        "msgStr": "Eh, bir müşterimiz olmadan dava üzerinde çalışmak zor olurdu."
      },
      {
        "msgID": "JMS_TALK_L0098",
        "msgStr": "Onu sağ salim geri getir, tamam mı? Her şey sana bağlı, Raidou."
      },
      {
        "msgID": "jms_talk_NARUMI_TGS_01_038",
        "msgStr": "ER100"
      },
      {
        "msgID": "JMS_TALK_L0099",
        "msgStr": "ER100"
      },
      {
