      },
      {
        "msgID": "jms_talk_TAE_EP02_01_039",
        "msgStr": "Tae"
      },
      {
        "msgID": "JMS_TALK_L0101",
        "msgStr": "Umarım tembel patronunun açığını kapatabilirsin, Raidou."
      },
      {
        "msgID": "JMS_TALK_L0102",
        "msgStr": "ER100"
      },
      {
        "msgID": "jms_talk_TAE_EP02_03_040",
        "msgStr": "Tae"
      },
      {
        "msgID": "JMS_TALK_L0103",
        "msgStr": "Fukagawa-cho'ya mı gidiyorsun? Orası oldukça tehlikelidir, gözünü dört aç."
      },
      {
        "msgID": "JMS_TALK_L0104",
        "msgStr": "Ha, bir de senin gibi efendi bir çocuk şehrin kuzey tarafındaki yerden uzak durmalı."
      },
      {
        "msgID": "jms_talk_TAE_EP02_04_041",
        "msgStr": "Tae"
      },
      {
        "msgID": "JMS_TALK_L0105",
        "msgStr": "Okurlarımız Fukagawa-cho'yu merak ediyor. Bana bir röportaj ayarlayabilir misin dersin?"
      },
      {
        "msgID": "JMS_TALK_L0106",
        "msgStr": "Başkent yeraltı dünyasındaki önemli bir ismin günümüz toplumu hakkındaki görüşlerini almayı çok isterim."
      },
      {
        "msgID": "jms_talk_TAE_EP02_05_042",
        "msgStr": "Tae"
      },
      {
        "msgID": "JMS_TALK_L0107",
        "msgStr": "O Özel Muhafızlardan uzak dur, Raidou."
      },
      {
        "msgID": "JMS_TALK_L0108",
        "msgStr": "Siz ikiniz benim en iyi haber kaynağımsınız! Kapatmak zorunda kalsaydınız ne yapardım bilmiyorum."
      },
      {
        "msgID": "jms_talk_TAE_EP02_06_043",
        "msgStr": "Tae"
      },
      {
        "msgID": "JMS_TALK_L0109",
        "msgStr": "Engelsiz aşk çok romantik... ama herkesin başına gelmiyor işte."
      },
      {
        "msgID": "JMS_TALK_L0110",
        "msgStr": "Sevgiliyle kaçmak, ha...? Tıpkı filmlerdeki gibi! Çok duygusal..."
      },
      {
        "msgID": "jms_talk_KONNO_EP04_01_044",
        "msgStr": "Konnou-ya Sahibi"
      },
      {
        "msgID": "JMS_TALK_L0111",
        "msgStr": "Sana güveniyorum, evlat."
      },
      {
        "msgID": "JMS_TALK_L0112",
        "msgStr": "Ben hayattayken Konnou-ya'nın kapanmasına izin vermem."
      },
      {
        "msgID": "jms_talk_KAYA_EP06_01_045",
        "msgStr": "Kaya"
      },
      {
        "msgID": "JMS_TALK_L0113",
        "msgStr": "Ben de seninle geleceğim. İki kişi tek başına olmandan daha şanslı olacaktır."
      },
      {
        "msgID": "jms_talk_RASU_EP10_01_046",
        "msgStr": "Rasputin"
      },
      {
        "msgID": "JMS_TALK_L0114",
        "msgStr": "Kasumidai'nin kuzeyinde yeraltı tersanesine giden gizli bir giriş var."
      },
      {
        "msgID": "JMS_TALK_L0115",
        "msgStr": "Munakata'yı durdurabileceğini mi sanıyorsun? Eh, ben sadece arkama yaslanıp gösterinin tadını çıkaracağım."
      },
      {
        "msgID": "jms_talk_NARUMI_EP02_12_047",
        "msgStr": "NULL"
      },
      {
        "msgID": "JMS_TALK_L0116",
        "msgStr": "> Narumi şu anda telefonla meşgul ve konuşamıyor."
      },
      {
        "msgID": "jms_talk_JMS_ENTER_05_048",
        "msgStr": "NULL"
      },
      {
        "msgID": "JMS_TALK_L0117",
        "msgStr": "> Narumi yeraltı tersanesinde..."
      }
    ]
  },
